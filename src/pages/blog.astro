---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogOfferPopup from '../components/BlogOfferPopup.astro';
import BlogImage from '../components/BlogImage.astro';
import BlogPostRail from '../components/BlogPostRail.astro';
import '../styles/journal.css';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const formatDate = (date: Date) => date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Web Grouth guest posting and link building guides',
  itemListElement: posts.map((post, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: post.data.title,
    url: `https://www.webgrouth.com/blog/${post.id}`,
  })),
};
---

<BaseLayout title="Guest Posting & Link Building Guides | Web Grouth" description="Clear, practical guides about guest posting, link insertion, website quality and off-page SEO for worldwide campaigns." pageType="CollectionPage" structuredData={blogSchema}>
  <div class="wg-blog-theme wg-blog-index">
    <div class="shell wg-blog-shell">
      <header class="wg-blog-intro">
        <span class="wg-blog-eyebrow">Web Grouth Journal</span>
        <h1>Guest posting &amp; SEO guides</h1>
        <p>Practical advice on choosing websites, planning content and building better links.</p>
      </header>

      <div class="wg-blog-layout">
        <section aria-labelledby="latest-articles">
          <div class="wg-blog-section-heading">
            <h2 id="latest-articles">Latest articles</h2>
            <span>{posts.length} articles</span>
          </div>
          <div class="wg-blog-grid">
            {posts.map((post, index) => (
              <article class="wg-blog-card">
                <a class="wg-blog-card-image" href={`/blog/${post.id}`} aria-label={`Read ${post.data.title}`}>
                  <BlogImage src={post.data.image} alt={`Cover image for ${post.data.title}`} maxWidth={960} sizes="(max-width: 620px) calc(100vw - 40px), (max-width: 960px) calc((100vw - 64px) / 2), 392px" priority={index === 0} />
                </a>
                <div class="wg-blog-card-copy">
                  <div class="wg-blog-card-meta"><span class="wg-blog-category">{post.data.category}</span><span>{post.data.readTime}</span></div>
                  <h3><a href={`/blog/${post.id}`}>{post.data.title}</a></h3>
                  <p>{post.data.description}</p>
                  <div class="wg-blog-card-footer">
                    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                    <a href={`/blog/${post.id}`}>Read article <span aria-hidden="true">→</span></a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>

        <aside class="wg-blog-sidebar" aria-label="Resources and guest posting offer">
          <section class="wg-blog-resource">
            <span class="wg-blog-eyebrow">Free resource</span>
            <h2>Choose your next website with confidence.</h2>
            <p>Check relevance, traffic and publishing terms before you approve a guest post.</p>
            <a class="wg-blog-text-link" href="/guest-post-quality-checklist">Open the checklist <span aria-hidden="true">→</span></a>
          </section>
          <section class="wg-blog-offer">
            <span class="wg-blog-eyebrow">New client offer</span>
            <h2>Your first guest post for $1.</h2>
            <p>Review selected website options and pay after your link is live.</p>
            <a class="wg-blog-button" href="/order?service=First%20Guest%20Post&offer=1-dollar" data-journal-popup-open>Check availability</a>
            <small>Selected websites only. Subject to approval and availability.</small>
          </section>
        </aside>
      </div>
    </div>
    <BlogPostRail posts={posts} title="More from the blog" id="blog-reading-rail" />
  </div>
  <BlogOfferPopup />
</BaseLayout>
