---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog')).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
const formatDate = (date: Date) => date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Web Grouth guest posting and link building guides',
  itemListElement: posts.map((post, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: post.data.title,
    url: `https://www.webgrouth.com/blog/${post.id}`,
  })),
};
---
<BaseLayout title="Guest Posting & Link Building Guides | Web Grouth" description="Practical guides about guest posting, link insertion, website quality and off-page SEO for USA and UK campaigns." pageType="CollectionPage" structuredData={blogSchema}>
  <section class="page-hero"><div class="shell"><div class="article-header" data-reveal><div class="breadcrumbs"><a href="/">Home</a><span>/</span><span>Guides</span></div><div class="eyebrow"><span class="eyebrow-dot"></span> Web Grouth guides</div><h1>Simple advice for <span class="gradient-text">better backlinks.</span></h1><p>Easy guides about guest posting, website quality, content and off-page SEO.</p></div></div></section>
  <section class="section"><div class="shell blog-grid">{posts.map((post,index)=><article class="blog-card" data-reveal data-reveal-delay={String(index%2)}><a class="blog-card-image" href={`/blog/${post.id}`}><img src={post.data.image} alt={`Illustration for ${post.data.title}`} width="1024" height="1024" loading="lazy" decoding="async" /></a><div class="blog-card-body"><div class="blog-meta"><span>{post.data.category}</span><span>·</span><span>{formatDate(post.data.date)}</span><span>·</span><span>{post.data.readTime}</span></div><h2><a href={`/blog/${post.id}`}>{post.data.title}</a></h2><p>{post.data.description}</p><a class="text-link" href={`/blog/${post.id}`}>Read article <span>↗</span></a></div></article>)}</div></section>
  <section class="cta-block"><div class="shell cta-card" data-reveal><div class="eyebrow"><span class="eyebrow-dot"></span> Ready to start?</div><h2>Need guest posts for your website?</h2><p>Send your order and get suitable website options from Web Grouth.</p><a class="button" href="/order">Place an order <span>↗</span></a></div></section>
</BaseLayout>
