---
import BaseLayout from '../layouts/BaseLayout.astro';
const principles = [
  ['Clarity over hype', 'We explain what a placement is, what it includes and what it does not—before you approve it.'],
  ['Fit over volume', 'Ten relevant opportunities are more useful than a spreadsheet filled with random high-metric domains.'],
  ['Relationships over transactions', 'Long-term publisher and client relationships create better work, faster communication and repeatable quality.'],
  ['Progress over promises', 'SEO is never a magic switch. We focus on strong inputs, clean execution and transparent reporting.'],
];
---
<BaseLayout title="About Web Grouth | Human-led Guest Posting Agency" description="Meet Web Grouth, a human-led guest posting and link-building agency founded by Nasir Haider.">
  <section class="page-hero">
    <div class="shell page-hero-grid">
      <div class="page-hero-copy" data-reveal>
        <div class="breadcrumbs"><a href="/">Home</a><span>/</span><span>About</span></div>
        <div class="eyebrow"><span class="eyebrow-dot"></span> About Web Grouth</div>
        <h1>Link building with a <span class="gradient-text">human pulse.</span></h1>
        <p>Web Grouth is a specialist guest posting agency built around direct communication, publisher relationships and work that makes sense on the page—not just in a report.</p>
      </div>
      <aside class="page-hero-aside" data-reveal data-reveal-delay="1">
        <span>At a glance</span>
        <ul><li><span>Founded by</span>Nasir Haider</li><li><span>Primary focus</span>Guest posting</li><li><span>Working model</span>Remote · Worldwide</li><li><span>Best for</span>Brands & agencies</li></ul>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="shell founder-grid">
      <div class="founder-card" data-reveal><div class="founder-mark">WG</div><h3>Nasir Haider</h3><p>Founder · Web Grouth</p></div>
      <div class="founder-copy" data-reveal data-reveal-delay="1">
        <div class="eyebrow"><span class="eyebrow-dot"></span> The idea behind the agency</div>
        <h2>Built after seeing what link building gets wrong.</h2>
        <p>Too many campaigns begin with a giant spreadsheet and end with links that look good only at a glance. Web Grouth was created to make the process more considered: understand the target, identify a relevant publisher, confirm the terms and communicate clearly from start to finish.</p>
        <p>Today, we support direct clients and SEO agencies with guest posts, contextual link insertions, content and outreach across a growing network of publisher relationships.</p>
        <a class="text-link" href="/contact">Talk directly with our team <span>↗</span></a>
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="shell content-grid">
      <div class="content-sticky" data-reveal><span class="kicker">How we think</span><h2>Standards that guide every campaign.</h2><p>Simple principles keep our recommendations useful and our relationships durable.</p></div>
      <div class="content-stack">
        {principles.map(([title, text], index) => <article class="detail-card" data-reveal data-reveal-delay={String(index % 3)}><div class="detail-card-head"><span class="detail-card-icon">{String(index + 1).padStart(2,'0')}</span><div><h3>{title}</h3><p>{text}</p></div></div></article>)}
      </div>
    </div>
  </section>

  <section class="section"><div class="shell quote-band" data-reveal><span class="kicker">Our point of view</span><blockquote>“A backlink should feel like a useful reference for the reader—not an interruption added for a crawler.”</blockquote></div></section>
  <section class="cta-block"><div class="shell cta-card" data-reveal><div class="eyebrow"><span class="eyebrow-dot"></span> Work with Web Grouth</div><h2>Let’s build authority with better inputs.</h2><p>Share your niche, targets and current priorities. We’ll help you turn them into a focused placement plan.</p><a class="button" href="/contact">Start the conversation <span>↗</span></a></div></section>
</BaseLayout>
