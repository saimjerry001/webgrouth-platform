---
// src/pages/about.astro
---
<!DOCTYPE html>
<html lang="ur">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>About Us | Web Grouth</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <style is:inline>
    * { margin:0; padding:0; box-sizing:border-box; }
    html { scroll-behavior:smooth; }
    body {
      font-family:'Plus Jakarta Sans', sans-serif;
      background:#ffffff;
      color:#0f172a;
      line-height:1.65;
    }
    .container { max-width:1200px; margin:0 auto; padding:0 24px; }
    a { text-decoration:none; color:inherit; }
    h1,h2,h3,h4 { font-family:'Outfit',sans-serif; letter-spacing:-0.03em; font-weight:700; }
    
    /* ===== HEADER ===== */
    .header {
      position:fixed; top:0; left:0; width:100%; z-index:1000;
      background:rgba(255,255,255,.78); backdrop-filter:blur(16px); -webkit-backdrop-filter:blur(16px);
      border-bottom:1px solid rgba(15,23,42,.06); padding:14px 0;
    }
    .header-inner { display:flex; justify-content:space-between; align-items:center; }
    .logo { display:flex; align-items:center; gap:10px; font-size:1.55rem; font-weight:800; color:#0f172a; }
    .logo-mark {
      width:38px; height:38px; border-radius:11px;
      background:linear-gradient(135deg,#2563eb,#1d4ed8);
      display:flex; align-items:center; justify-content:center;
      box-shadow:0 6px 16px rgba(37,99,235,.35); flex-shrink:0;
    }
    .logo-mark svg { width:22px; height:22px; }
    .logo span { background:linear-gradient(135deg,#2563eb,#1d4ed8); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }
    .nav-links { display:flex; align-items:center; gap:32px; }
    .nav-links a:not(.btn-nav) { font-weight:600; color:#334155; transition:.2s; font-size:.95rem; }
    .nav-links a:not(.btn-nav):hover { color:#2563eb; }
    .nav-links .btn-nav {
      background:#2563eb; color:#fff !important; padding:11px 28px; border-radius:40px; font-weight:700;
      transition:.3s; box-shadow:0 6px 18px rgba(37,99,235,.25);
    }
    .nav-links .btn-nav:hover { background:#1d4ed8; transform:translateY(-2px); }
    .hamburger { display:none; flex-direction:column; gap:5px; cursor:pointer; padding:6px; }
    .hamburger span { width:26px; height:3px; background:#0f172a; border-radius:3px; transition:.3s; }

    /* ===== HERO ===== */
    .about-hero { padding:160px 0 80px; background:linear-gradient(165deg,#f8faff 0%,#ffffff 60%); text-align:center; }
    .about-hero h1 { font-size:3.5rem; font-weight:900; line-height:1.1; margin-bottom:20px; }
    .about-hero h1 span { background:linear-gradient(135deg,#2563eb,#1d4ed8); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }
    .about-hero p { font-size:1.2rem; color:#475569; max-width:700px; margin:0 auto; }

    /* ===== CONTENT SECTION ===== */
    .about-section { padding:80px 0; }
    .about-grid { display:grid; grid-template-columns:1fr 1fr; gap:60px; align-items:center; }
    .about-text h2 { font-size:2.4rem; margin-bottom:20px; color:#0f172a; }
    .about-text p { color:#475569; font-size:1.05rem; margin-bottom:20px; line-height:1.7; }
    .about-image { border-radius:24px; overflow:hidden; box-shadow:0 20px 40px rgba(15,23,42,0.08); }
    .about-image img { width:100%; display:block; object-fit:cover; }

    /* ===== VALUES GRID ===== */
    .values-section { padding:80px 0; background:#f8fafc; }
    .values-grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:30px; margin-top:40px; }
    .value-card { background:#fff; padding:40px 30px; border-radius:24px; border:1px solid #e2e8f0; transition:0.3s; }
    .value-card:hover { transform:translateY(-6px); box-shadow:0 20px 40px rgba(15,23,42,0.05); border-color:#2563eb; }
    .value-icon { width:52px; height:52px; border-radius:14px; background:#eff6ff; color:#2563eb; display:flex; align-items:center; justify-content:center; font-size:1.4rem; margin-bottom:20px; }
    .value-card h3 { font-size:1.3rem; margin-bottom:12px; }
    .value-card p { color:#475569; font-size:0.95rem; }

    /* ===== FOOTER ===== */
    .footer { background:#fff; border-top:1px solid #f1f5f9; padding:64px 0 30px; margin-top:80px; }
    .footer-grid { display:grid; grid-template-columns:2fr 1fr 1fr 1.5fr; gap:40px; margin-bottom:40px; }
    .footer-brand p { color:#64748b; max-width:280px; font-size:.95rem; margin-top:14px; }
    .footer-col h4 { font-size:1rem; font-weight:700; margin-bottom:16px; }
    .footer-col ul { list-style:none; }
    .footer-col ul li { margin-bottom:10px; }
    .footer-col ul li a { color:#64748b; transition:.2s; font-size:.95rem; }
    .footer-col ul li a:hover { color:#2563eb; }
    .footer-bottom { border-top:1px solid #f1f5f9; padding-top:24px; text-align:center; color:#94a3b8; font-size:.9rem; }

    @media (max-width: 992px) {
      .about-grid { grid-template-columns:1fr; }
      .footer-grid { grid-template-columns:1fr 1fr; }
    }
    @media (max-width: 768px) {
      .nav-links {
        display:none; flex-direction:column; background:rgba(255,255,255,.98); position:absolute; top:70px; left:0;
        width:100%; padding:30px 24px; gap:20px; border-bottom:1px solid #f1f5f9; box-shadow:0 10px 30px rgba(0,0,0,0.05);
      }
      .nav-links.open { display:flex; }
      .hamburger { display:flex; }
      .about-hero h1 { font-size:2.6rem; }
      .footer-grid { grid-template-columns:1fr; text-align:center; }
    }
  </style>
</head>
<body>

  <!-- HEADER -->
  <header class="header" id="header">
    <div class="container header-inner">
      <div class="logo">
        <a href="/" style="display:flex; align-items:center; gap:10px;">
          <div class="logo-mark">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <linearGradient id="logo-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#ffffff" /><stop offset="100%" stop-color="#93c5fd" />
                </linearGradient>
              </defs>
              <path d="M4 20L12 12L16 16L22 8" stroke="url(#logo-grad)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M17 8H22V13" stroke="url(#logo-grad)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
              <circle cx="4" cy="20" r="2.2" fill="#ffffff" /><circle cx="12" cy="12" r="2.2" fill="#ffffff" /><circle cx="16" cy="16" r="2.2" fill="#ffffff" /><circle cx="22" cy="8" r="2.2" fill="#ffffff" />
            </svg>
          </div>
          Web<span>Grouth</span>
        </a>
      </div>
      <nav class="nav-links" id="navLinks">
        <a href="/">Home</a>
        <a href="/#services">Services</a>
        <a href="/#pricing">Pricing</a>
        <a href="/about">About</a>
        <a href="/blog">Blog</a>
        <a href="/contact">Contact</a>
        <a href="/contact" class="btn-nav">Get Started</a>
      </nav>
      <div class="hamburger" id="hamburger"><span></span><span></span><span></span></div>
    </div>
  </header>

  <!-- HERO -->
  <section class="about-hero">
    <div class="container">
      <h1>Our Mission is Real <span>Search Visibility</span></h1>
      <p>We build organic backlinks from manually-vetted, genuine websites to secure permanent top search index positions for your brand.</p>
    </div>
  </section>

  <!-- CONTENT SECTION -->
  <section class="about-section">
    <div class="container about-grid">
      <div class="about-text">
        <h2>We Believe in Relevance Over Random Volume</h2>
        <p>At Web Grouth, we are tired of seeing brands get scammed by low-quality, automated Private Blog Networks (PBNs) that eventually get penalised by Google updates. Backlinks should only be earned, not artificially generated.</p>
        <p>Our team works around the clock to establish relationships with active business owners, editorial boards, and actual authors. We make sure every link pointing back to your site is embedded naturally inside original content read by real people.</p>
      </div>
      <div class="about-image">
        <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=800&q=80" alt="Web Grouth team brainstorming" />
      </div>
    </div>
  </section>

  <!-- VALUES SECTION -->
  <section class="values-section">
    <div class="container">
      <div class="section-header" style="text-align:center;">
        <span class="eyebrow">Our Core Principles</span>
        <h2>How We Maintain Excellence</h2>
      </div>
      <div class="values-grid">
        <div class="value-card">
          <div class="value-icon"><i class="fas fa-shield-halved"></i></div>
          <h3>Zero PBN Guarantee</h3>
          <p>We strictly build contextual links inside real business outlets. PBN directories are completely banned in our agency.</p>
        </div>
        <div class="value-card">
          <div class="value-icon"><i class="fas fa-magnifying-glass-chart"></i></div>
          <h3>Manual Vetting</h3>
          <p>Every publisher site is manually audited for traffic metrics, indexation rates, and organic stability before publication.</p>
        </div>
        <div class="value-card">
          <div class="value-icon"><i class="fas fa-pen-nib"></i></div>
          <h3>Editorial Standards</h3>
          <p>Our original guest pieces are written to satisfy real user queries first, guaranteeing lifelong Google indexing safety.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <div class="logo" style="font-size:1.55rem;">
            <div class="logo-mark">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <defs>
                  <linearGradient id="logo-grad-f" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#ffffff" /><stop offset="100%" stop-color="#93c5fd" />
                  </linearGradient>
                </defs>
                <path d="M4 20L12 12L16 16L22 8" stroke="url(#logo-grad-f)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M17 8H22V13" stroke="url(#logo-grad-f)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                <circle cx="4" cy="20" r="2.2" fill="#ffffff" /><circle cx="12" cy="12" r="2.2" fill="#ffffff" /><circle cx="16" cy="16" r="2.2" fill="#ffffff" /><circle cx="22" cy="8" r="2.2" fill="#ffffff" />
              </svg>
            </div>
            Web<span>Grouth</span>
          </div>
          <p>We help brands earn relevant guest posts and contextual backlinks through vetted publishers — built for relevance, not volume.</p>
        </div>
        <div class="footer-col">
          <h4>Services</h4>
          <ul>
            <li><a href="/#services">Guest Posting</a></li>
            <li><a href="/#services">Backlink Building</a></li>
            <li><a href="/#services">SEO Strategy</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Quick Links</h4>
          <ul>
            <li><a href="/#pricing">Pricing</a></li>
            <li><a href="/about">About Us</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Connect</h4>
          <ul>
            <li><a href="mailto:nasirhaiderseo@gmail.com"><i class="fas fa-envelope"></i> nasirhaiderseo@gmail.com</a></li>
            <li><a href="https://wa.me/923327810261" target="_blank"><i class="fab fa-whatsapp"></i> +92 332 7810261</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">&copy; 2026 Web Grouth. All rights reserved.</div>
    </div>
  </footer>

  <script is:inline>
    const hamburger = document.getElementById('hamburger');
    const navLinks = document.getElementById('navLinks');
    hamburger.addEventListener('click', () => navLinks.classList.toggle('open'));
  </script>
</body>
</html>
