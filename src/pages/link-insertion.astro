---
import BaseLayout from '../layouts/BaseLayout.astro';
const items = [
  ['Existing-page relevance', 'We look for an indexed article where your resource naturally supports the topic already being discussed.'],
  ['Context-aware placement', 'The surrounding sentence or paragraph is reviewed so the mention reads like a genuine editorial reference.'],
  ['Terms verified first', 'We confirm link type, placement rules, permanence expectations and turnaround before you approve.'],
  ['Fast, clean reporting', 'You receive the exact live page, anchor used and target URL for straightforward campaign tracking.'],
];
---
<BaseLayout title="Contextual Link Insertion Services | Web Grouth" description="Add relevant contextual backlinks to existing indexed articles with clear placement terms and human review.">
  <section class="page-hero"><div class="shell page-hero-grid"><div class="page-hero-copy" data-reveal><div class="breadcrumbs"><a href="/">Home</a><span>/</span><span>Link Insertion</span></div><div class="eyebrow"><span class="eyebrow-dot"></span> Contextual niche edits</div><h1>Add value to a page that <span class="gradient-text">already performs.</span></h1><p>Place your link inside an existing, relevant article—chosen for context, editorial fit and genuine usefulness to the reader.</p><div class="hero-actions"><a class="button button-primary" href="/contact">Find insertion opportunities <span>↗</span></a><a class="button button-secondary" href="/guest-posting">Compare guest posts</a></div></div><aside class="page-hero-aside" data-reveal data-reveal-delay="1"><span>Best suited for</span><ul><li><span>Existing resources</span>Useful guides</li><li><span>Priority pages</span>Commercial / editorial</li><li><span>Placement type</span>Contextual mention</li><li><span>Approval</span>Before placement</li></ul></aside></div></section>
  <section class="section"><div class="shell content-grid"><div class="content-sticky" data-reveal><span class="kicker">A stronger niche edit</span><h2>Context is the whole point.</h2><p>We focus on placements that work inside the existing article—not additions that feel bolted on.</p></div><div class="content-stack">{items.map(([title,text],i)=><article class="detail-card" data-reveal data-reveal-delay={String(i%3)}><div class="detail-card-head"><span class="detail-card-icon">↗</span><div><h3>{title}</h3><p>{text}</p></div></div></article>)}</div></div></section>
  <section class="section section-soft"><div class="shell quote-band" data-reveal><span class="kicker">The quality test</span><blockquote>If the link does not help the reader understand or act on the topic, it does not belong in the article.</blockquote></div></section>
  <section class="section"><div class="shell"><div class="section-heading center" data-reveal><div class="eyebrow"><span class="eyebrow-dot"></span> Simple workflow</div><h2>Review. Approve. <span class="gradient-text">Go live.</span></h2></div><div class="process-grid">{[['01','Share the page','Send your target URL, preferred anchor and niche.'],['02','Review options','See relevant existing articles and placement details.'],['03','Confirm context','Approve the page, anchor and proposed placement.'],['04','Receive the link','Get the updated live article and clear report.']].map(([n,t,x],i)=><article class="process-step" data-reveal data-reveal-delay={String(i)}><span class="step-number">STEP {n}</span><h3>{t}</h3><p>{x}</p></article>)}</div></div></section>
  <section class="cta-block"><div class="shell cta-card" data-reveal><div class="eyebrow"><span class="eyebrow-dot"></span> Have a target page?</div><h2>Let’s find the right context for it.</h2><p>Send your page and niche. We’ll identify relevant link insertion opportunities for your review.</p><a class="button" href="/contact">Start your search <span>↗</span></a></div></section>
</BaseLayout>
