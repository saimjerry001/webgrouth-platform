---
import BaseLayout from '../layouts/BaseLayout.astro';
const items = [
  ['Relevant existing article', 'We find an article where your link fits the topic naturally.'],
  ['Natural placement', 'We check the sentence and paragraph so the added link reads naturally.'],
  ['Terms checked first', 'We confirm the link type, rules, permanence and delivery time before you approve.'],
  ['Clear report', 'You receive the live page, anchor text and target URL.'],
];
---
<BaseLayout title="Contextual Link Insertion Services | Web Grouth" description="Add relevant contextual backlinks to existing indexed articles with clear placement terms and human review.">
  <section class="page-hero"><div class="shell page-hero-grid"><div class="page-hero-copy" data-reveal><div class="breadcrumbs"><a href="/">Home</a><span>/</span><span>Link Insertion</span></div><div class="eyebrow"><span class="eyebrow-dot"></span> Link insertion service</div><h1>Add your link to the right existing article.</h1><p>We place your link inside a relevant published article where it fits naturally and helps the reader.</p><div class="hero-actions"><a class="button button-primary" href="/order?service=Link%20Insertion">Place a link insertion order <span>↗</span></a><a class="button button-secondary" href="/guest-posting">Compare guest posts</a></div></div><aside class="page-hero-aside" data-reveal data-reveal-delay="1"><span>Good for</span><ul><li><span>Your content</span>Useful guides</li><li><span>Target pages</span>Service or blog pages</li><li><span>Link style</span>Natural mention</li><li><span>Approval</span>Before placement</li></ul></aside></div></section>
  <section class="section"><div class="shell content-grid"><div class="content-sticky" data-reveal><span class="kicker">A better link insertion</span><h2>The link should fit the article.</h2><p>We choose pages where your link feels useful—not forced or out of place.</p></div><div class="content-stack">{items.map(([title,text],i)=><article class="detail-card" data-reveal data-reveal-delay={String(i%3)}><div class="detail-card-head"><span class="detail-card-icon">↗</span><div><h3>{title}</h3><p>{text}</p></div></div></article>)}</div></div></section>
  <section class="section section-soft"><div class="shell quote-band" data-reveal><span class="kicker">Our quality check</span><blockquote>A good link should fit the topic and give the reader something useful.</blockquote></div></section>
  <section class="section"><div class="shell"><div class="section-heading center" data-reveal><div class="eyebrow"><span class="eyebrow-dot"></span> Simple workflow</div><h2>Review. Approve. <span class="gradient-text">Go live.</span></h2></div><div class="process-grid">{[['01','Share the page','Send your target URL, preferred anchor and niche.'],['02','Review options','See relevant existing articles and placement details.'],['03','Confirm context','Approve the page, anchor and proposed placement.'],['04','Receive the link','Get the updated live article and clear report.']].map(([n,t,x],i)=><article class="process-step" data-reveal data-reveal-delay={String(i)}><span class="step-number">STEP {n}</span><h3>{t}</h3><p>{x}</p></article>)}</div></div></section>
  <section class="cta-block"><div class="shell cta-card" data-reveal><div class="eyebrow"><span class="eyebrow-dot"></span> Have a target page?</div><h2>Let’s find the right article for your link.</h2><p>Send your page and niche. We will find relevant link insertion options for you.</p><a class="button" href="/order?service=Link%20Insertion">Place your order <span>↗</span></a></div></section>
</BaseLayout>
