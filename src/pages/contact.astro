---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact Web Grouth | Start a Guest Posting Campaign" description="Tell Web Grouth about your guest posting, link insertion or SEO campaign and get a focused response.">
  <section class="page-hero">
    <div class="shell page-hero-grid">
      <div class="page-hero-copy" data-reveal>
        <div class="breadcrumbs"><a href="/">Home</a><span>/</span><span>Contact</span></div>
        <div class="eyebrow"><span class="eyebrow-dot"></span> Start a conversation</div>
        <h1>Tell us where you want to <span class="gradient-text">grow.</span></h1>
        <p>Share your niche, target URL and campaign size. We’ll respond with relevant questions, publisher options or a clear recommended next step.</p>
      </div>
      <aside class="page-hero-aside" data-reveal data-reveal-delay="1"><span>What helps us respond faster</span><ul><li><span>Your niche</span>Required</li><li><span>Target market</span>Helpful</li><li><span>Campaign size</span>1 or 100+</li><li><span>Preferred contact</span>Email / WhatsApp</li></ul></aside>
    </div>
  </section>

  <section class="section">
    <div class="shell contact-grid">
      <div class="contact-copy" data-reveal>
        <span class="kicker">Direct access</span><h2>No ticket maze. Talk to a real person.</h2>
        <p>Use the campaign form or contact Web Grouth directly. Your form details open securely in WhatsApp so you can review the message before sending.</p>
        <div class="contact-options">
          <a class="contact-option" href="https://wa.me/923327810261" target="_blank" rel="noopener"><div><span>WhatsApp</span><strong>+92 332 7810261</strong></div><i>↗</i></a>
          <a class="contact-option" href="mailto:contact@webgrouth.com"><div><span>Email</span><strong>contact@webgrouth.com</strong></div><i>↗</i></a>
        </div>
      </div>
      <form class="contact-form" id="campaign-form" data-reveal data-reveal-delay="1">
        <div class="form-row"><div class="field"><label for="name">Your name</label><input id="name" name="name" required placeholder="Your full name" /></div><div class="field"><label for="email">Business email</label><input id="email" name="email" type="email" required placeholder="name@company.com" /></div></div>
        <div class="form-row"><div class="field"><label for="website">Website</label><input id="website" name="website" type="url" placeholder="https://example.com" /></div><div class="field"><label for="service">Service</label><select id="service" name="service"><option>Guest posting</option><option>Link insertion</option><option>Off-page SEO campaign</option><option>Content + placement</option><option>Agency fulfilment</option></select></div></div>
        <div class="field"><label for="message">Campaign brief</label><textarea id="message" name="message" required placeholder="Tell us your niche, target countries, preferred metrics and approximate number of placements..."></textarea></div>
        <button class="button button-primary" type="submit" style="width:100%">Continue on WhatsApp <span>↗</span></button>
        <p class="form-note">Nothing is sent automatically. You will review the prepared message in WhatsApp before sending.</p>
      </form>
    </div>
  </section>
  <section class="section section-soft"><div class="shell stats-grid" data-reveal><div class="stat-intro"><span class="kicker">What happens next</span><p>We keep the first response practical and focused on what your campaign actually needs.</p></div><div class="stat"><strong>01</strong><span>We review your niche and targets</span></div><div class="stat"><strong>02</strong><span>We clarify fit, terms and priorities</span></div><div class="stat"><strong>03</strong><span>You receive relevant next steps</span></div></div></section>
  <script is:inline>
    document.getElementById('campaign-form')?.addEventListener('submit', function (event) {
      event.preventDefault();
      const data = new FormData(event.currentTarget);
      const message = `Hello Web Grouth, I'd like to discuss a campaign.\n\nName: ${data.get('name')}\nEmail: ${data.get('email')}\nWebsite: ${data.get('website') || 'Not provided'}\nService: ${data.get('service')}\n\nCampaign brief:\n${data.get('message')}`;
      window.open(`https://wa.me/923327810261?text=${encodeURIComponent(message)}`, '_blank', 'noopener');
    });
  </script>
</BaseLayout>
