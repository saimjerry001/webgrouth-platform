---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact Web Grouth | Start a Search Growth Project" description="Tell Web Grouth about your guest posting, SEO, link building, or digital PR goals."><section class="page-hero"><div class="container reveal"><div class="breadcrumbs"><a href="/">Home</a> / Contact</div><span class="eyebrow">Start a conversation</span><h1>Tell us what you’re trying to make visible.</h1><p class="lead">Share a little context and we’ll come back with a useful next step—not a generic pitch.</p></div></section><section class="section"><div class="container contact-grid"><div><span class="eyebrow">How we can help</span><h2>Bring the messy brief.</h2><p class="lead">Guest posts, link insertions, SEO strategy, content, and digital PR all start with understanding the goal behind the request.</p><div class="contact-detail"><span>Next step</span><strong>Use the form to share your brief</strong></div><div class="contact-detail"><span>WhatsApp</span><strong><a href="https://wa.me/923327810261" target="_blank" rel="noopener">+92 332 7810261 ↗</a></strong></div><div class="contact-detail"><span>Website</span><strong>webgrouth.com</strong></div></div><form class="card" id="contact-form" method="post" enctype="text/plain"><div class="form-grid"><div class="field"><label for="name">Name</label><input id="name" name="name" required autocomplete="name" /></div><div class="field"><label for="email">Email</label><input id="email" name="email" type="email" required autocomplete="email" /></div></div><div class="form-grid"><div class="field"><label for="website">Website</label><input id="website" name="website" type="url" placeholder="https://" /></div><div class="field"><label for="service">What can we help with?</label><select id="service" name="service"><option>Guest posting</option><option>SEO services</option><option>Link building</option><option>Content writing</option><option>Digital PR</option></select></div></div><div class="field"><label for="budget">Budget range</label><select id="budget" name="budget"><option>Not sure yet</option><option>Under $500</option><option>$500–$2,000</option><option>$2,000+</option></select></div><div class="field"><label for="message">Your brief</label><textarea id="message" name="message" required placeholder="What are you hoping to improve?"></textarea></div><button class="button button-primary" type="submit">Send inquiry <span>↗</span></button></form></div></section><script is:inline>document.getElementById("contact-form")?.addEventListener("submit",(event)=>{event.preventDefault();const form=new FormData(event.currentTarget);const text=["Hello Web Grouth, I would like to discuss a project.","Name: "+form.get("name"),"Email: "+form.get("email"),"Website: "+form.get("website"),"Service: "+form.get("service"),"Budget: "+form.get("budget"),"Brief: "+form.get("message")].join("%0A");window.open("https://wa.me/923327810261?text="+encodeURIComponent(text),"_blank","noopener");});</script></BaseLayout>