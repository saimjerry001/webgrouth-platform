---
import BaseLayout from '../layouts/BaseLayout.astro';
const items = [
  ['Relevant publisher matching', 'Opportunities are shortlisted around your niche, audience, destination page and target market.'],
  ['Editorial content support', 'Use your own article or ask us to prepare a publication-ready draft that fits the selected website.'],
  ['Clear placement terms', 'Link type, turnaround, permanence, content rules and special restrictions are confirmed before approval.'],
  ['Live-link reporting', 'Receive the published URL and campaign details in a format that is easy to track and share.'],
];
---
<BaseLayout title="Guest Posting Services | Web Grouth" description="Relevant editorial guest posts on vetted websites, supported by human outreach, content and clear reporting.">
  <section class="page-hero"><div class="shell page-hero-grid"><div class="page-hero-copy" data-reveal><div class="breadcrumbs"><a href="/">Home</a><span>/</span><span>Guest Posting</span></div><div class="eyebrow"><span class="eyebrow-dot"></span> Core service</div><h1>Guest posting with the groundwork done properly.</h1><p>Choose relevant editorial placements with human publisher matching, clear terms and content prepared for the site—not copied from a generic template.</p><div class="hero-actions"><a class="button button-primary" href="/order?service=Guest%20Posting">Place a guest post order <span>↗</span></a><a class="button button-secondary" href="#process">See the process</a></div></div><aside class="page-hero-aside" data-reveal data-reveal-delay="1"><span>Campaign options</span><ul><li><span>Order size</span>Single or bulk</li><li><span>Content</span>Yours or ours</li><li><span>Categories</span>30+ niches</li><li><span>Reporting</span>Live URL + details</li></ul></aside></div></section>
  <section class="section"><div class="shell content-grid"><div class="content-sticky" data-reveal><span class="kicker">What is included</span><h2>A complete path to publication.</h2><p>We handle the moving pieces between your brief and the final editorial placement.</p></div><div class="content-stack">{items.map(([title,text],i)=><article class="detail-card" data-reveal data-reveal-delay={String(i%3)}><div class="detail-card-head"><span class="detail-card-icon">✓</span><div><h3>{title}</h3><p>{text}</p></div></div></article>)}</div></div></section>
  <section class="section section-soft" id="process"><div class="shell"><div class="section-heading center" data-reveal><div class="eyebrow"><span class="eyebrow-dot"></span> From brief to live URL</div><h2>A process designed for <span class="gradient-text">control and speed.</span></h2></div><div class="process-grid">{[['01','Brief','Share targets, niche, anchors and priorities.'],['02','Shortlist','Review relevant publisher opportunities and terms.'],['03','Content','Approve your draft or our content direction.'],['04','Publish','Receive the live link and placement report.']].map(([n,t,x],i)=><article class="process-step" data-reveal data-reveal-delay={String(i)}><span class="step-number">STEP {n}</span><h3>{t}</h3><p>{x}</p></article>)}</div></div></section>
  <section class="section"><div class="shell trust-panel" data-reveal><div class="trust-panel-inner"><div><span class="kicker">For teams of every size</span><h2>Built for direct clients and agency fulfilment.</h2></div><div class="trust-copy"><p>Need one niche placement, a white-label fulfilment partner or a recurring monthly shortlist? The workflow adapts without compromising visibility.</p><div class="tag-row"><span class="tag">One-off orders</span><span class="tag">Bulk campaigns</span><span class="tag">Reseller support</span><span class="tag">Multiple markets</span></div></div></div></div></section>
  <section class="cta-block"><div class="shell cta-card" data-reveal><div class="eyebrow"><span class="eyebrow-dot"></span> Start with your niche</div><h2>See the publishers that fit your campaign.</h2><p>Share your targets and requirements. We’ll narrow the network to opportunities worth reviewing.</p><a class="button" href="/order?service=Guest%20Posting">Place your order <span>↗</span></a></div></section>
</BaseLayout>
