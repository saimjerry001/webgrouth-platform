---
import BaseLayout from '../layouts/BaseLayout.astro';
const benefits=[['Context first','A placement should make sense for the publication and the person reading it.'],['A sharper brief','We align the topic, audience, anchor, and destination before outreach begins.'],['Editorial care','Your story is shaped to feel at home on the chosen site—not pasted into a template.'],['A repeatable system','Build a library of relevant opportunities instead of treating every link as a one-off.']];
---
<BaseLayout title="Guest Posting Services | Web Grouth" description="Reach relevant audiences with thoughtful guest posts and contextual backlinks from Web Grouth."><section class="page-hero"><div class="container reveal"><div class="breadcrumbs"><a href="/">Home</a> / Guest Posting</div><span class="eyebrow">The flagship service</span><h1>Guest posts people actually want to read.</h1><p class="lead">Earn relevant exposure and contextual links through publisher outreach built around your category, story, and audience.</p><div class="hero-actions"><a class="button button-primary" href="/contact">Plan a placement <span>↗</span></a><a class="button button-quiet" href="#process">See how it works</a></div></div></section><section class="section"><div class="container"><div class="section-head"><div><span class="eyebrow">What changes</span><h2>A better placement is more than a metric.</h2></div><p class="lead">Domain metrics can help with direction, but relevance and editorial quality are what make a link useful.</p></div><div class="grid-4">{benefits.map(([title,text])=><div class="card reveal"><span class="icon">✦</span><h3>{title}</h3><p>{text}</p></div>)}</div></div></section><section class="section section-soft" id="process"><div class="container feature-band"><div><span class="eyebrow">How it works</span><h2>From niche to publication.</h2><p class="lead">A focused workflow keeps expectations clear and gives each placement room to be good.</p></div><div>{[['01','Share your target','Tell us your niche, market, page, and what success should look like.'],['02','Review the fit','We identify a relevant route and confirm the editorial requirements.'],['03','Approve the content','Use your draft or collaborate with us on an article that earns its place.'],['04','Receive the live URL','Once published, you have a clear record of what went live and where.']].map(([num,title,text])=><div class="process-item reveal"><span class="step">{num}</span><h3>{title}</h3><p>{text}</p></div>)}</div></div></section><section class="container"><div class="cta-band"><div><span class="eyebrow">Let’s find the right fit</span><h2>Have a niche, page, or story in mind?</h2></div><a class="button button-quiet" href="/contact">Tell us about it <span>↗</span></a></div></section></BaseLayout>