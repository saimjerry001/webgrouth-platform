---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactLinks from '../components/ContactLinks.astro';

const steps = [
  { id: 'contact', label: 'Contact', fields: ['email', 'name', 'whatsapp'] },
  { id: 'service', label: 'Service', fields: ['service', 'niche', 'targetUrl', 'anchor'] },
  { id: 'details', label: 'Details', fields: ['budget', 'metrics', 'requirements'] },
] as const;
---

<BaseLayout
  title="Place a Guest Post Order | Web Grouth"
  description="Submit your guest posting or link insertion brief. Only email required — we reply within 24 hours."
  canonical="/order"
  pageType="ContactPage"
>
  <div class="saas-page">
    <section class="saas-hero">
      <div class="shell saas-hero-grid">
        <div class="saas-hero-copy" data-reveal>
          <div class="saas-breadcrumbs">
            <a href="/">Home</a><span>/</span><span>Place an Order</span>
          </div>
          <span class="saas-kicker">Quick order form</span>
          <h1>Get your link placement quote.</h1>
          <p>Only your email is required. We review every order personally and reply within 24 hours with website options and pricing.</p>
        </div>
        <aside class="saas-hero-panel" data-reveal data-reveal-delay="1">
          <span>What happens next</span>
          <ul>
            <li>01 · Submit your brief <span>2 minutes</span></li>
            <li>02 · We review it <span>Within 24 hours</span></li>
            <li>03 · Get options <span>Websites + prices</span></li>
            <li>04 · Approve & go live <span>Pay after link is live</span></li>
          </ul>
        </aside>
      </div>
    </section>

    <section class="saas-section">
      <div class="shell form-layout">
        <form
          class="premium-form multi-step-form"
          action="https://formsubmit.co/nasirhaiderseo@gmail.com"
          method="POST"
          enctype="multipart/form-data"
          data-order-form
          data-reveal
        >
          <input type="hidden" name="_subject" value="New Guest Post Order — Web Grouth" />
          <input type="hidden" name="_template" value="table" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="hidden" name="_next" value="https://webgrouth.com/order-success" />
          <input type="hidden" name="_autoresponse" value="Thank you. Web Grouth has received your order and will contact you by email after reviewing the details." />
          <input type="hidden" name="_url" value="https://www.webgrouth.com/order" />
          <input type="hidden" name="Source Offer" value="Web Grouth Order Form" data-source-offer />
          <label class="honeypot-field">Leave this empty<input type="text" name="_honey" tabindex="-1" autocomplete="off" /></label>

          <!-- Step Progress -->
          <div class="step-progress" role="tablist" aria-label="Order form steps">
            {steps.map((step, i) => (
              <button
                type="button"
                class="step-tab"
                data-step={i}
                role="tab"
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-controls={`step-panel-${i}`}
              >
                <span class="step-number">{i + 1}</span>
                <span class="step-label">{step.label}</span>
              </button>
            ))}
          </div>

          <!-- Step 1: Contact -->
          <div class="step-panel" id="step-panel-0" data-step-panel="0" role="tabpanel" aria-labelledby="step-tab-0">
            <div class="form-section-heading"><span>01</span><h2>Your contact</h2></div>
            <div class="field required">
              <label for="client-email">Email address *</label>
              <input id="client-email" name="email" type="email" autocomplete="email" required placeholder="name@company.com" />
              <small class="field-help">We'll send your quote here</small>
            </div>
            <div class="form-row">
              <div class="field">
                <label for="client-name">Full name</label>
                <input id="client-name" name="Client Name" autocomplete="name" placeholder="Your full name" />
              </div>
              <div class="field">
                <label for="client-whatsapp">WhatsApp <small>(optional)</small></label>
                <input id="client-whatsapp" name="WhatsApp Number" type="tel" autocomplete="tel" placeholder="+1 234 567 8900" />
              </div>
            </div>
            <div class="step-actions">
              <button type="button" class="saas-button primary step-next" data-next="1">Continue to Service →</button>
            </div>
          </div>

          <!-- Step 2: Service -->
          <div class="step-panel hidden" id="step-panel-1" data-step-panel="1" role="tabpanel" aria-labelledby="step-tab-1" hidden>
            <div class="form-section-heading"><span>02</span><h2>What do you need?</h2></div>
            <div class="form-row">
              <div class="field">
                <label for="order-service">Service type</label>
                <select id="order-service" name="Order Type" data-order-service>
                  <option value="Guest Posting">Guest Posting</option>
                  <option value="Link Insertion">Link Insertion</option>
                  <option value="Bulk Guest Posting">Bulk Guest Posting</option>
                  <option value="Handpicked Niche Outreach">Handpicked Niche Outreach</option>
                  <option value="SEO Campaign">Off-Page SEO Campaign</option>
                  <option value="Custom Campaign">Custom Campaign</option>
                </select>
              </div>
              <div class="field">
                <label for="required-niche">Niche / category</label>
                <input id="required-niche" name="Required Niche" placeholder="e.g. SaaS, Finance, Health" />
              </div>
            </div>
            <div class="form-row">
              <div class="field">
                <label for="target-url">Target URL <small>(optional)</small></label>
                <input id="target-url" name="Target URL or Website" type="url" placeholder="https://example.com/page" />
                <small class="field-help">The page you want to link to</small>
              </div>
              <div class="field">
                <label for="anchor-text">Anchor text <small>(optional)</small></label>
                <input id="anchor-text" name="Target Anchor Text" placeholder="Your preferred anchor text" />
              </div>
            </div>
            <div class="step-actions">
              <button type="button" class="saas-button ghost step-back" data-back="0">← Back</button>
              <button type="button" class="saas-button primary step-next" data-next="2">Continue to Details →</button>
            </div>
          </div>

          <!-- Step 3: Details -->
          <div class="step-panel hidden" id="step-panel-2" data-step-panel="2" role="tabpanel" aria-labelledby="step-tab-2" hidden>
            <div class="form-section-heading"><span>03</span><h2>Final details</h2></div>
            <div class="form-row">
              <div class="field">
                <label for="preferred-metrics">Preferred DR / DA</label>
                <select id="preferred-metrics" name="Preferred DR or DA Range">
                  <option value="Flexible">Flexible — recommend a good fit</option>
                  <option>DR/DA 20–39</option>
                  <option>DR/DA 40–59</option>
                  <option>DR/DA 60–79</option>
                  <option>DR/DA 80+</option>
                </select>
              </div>
              <div class="field">
                <label for="budget">Budget <small>(optional)</small></label>
                <input id="budget" name="Budget" placeholder="Per site or total budget" />
              </div>
            </div>
            <div class="field">
              <label for="requirements">Other requirements <small>(optional)</small></label>
              <textarea id="requirements" name="Specific Requirements" rows="3" placeholder="Country, traffic, link type, quantity, article needs..."></textarea>
              <small class="field-help">The more details, the better we can match you</small>
            </div>

            <details class="order-more">
              <summary><span>Add article or publisher preference</span><small>Optional</small></summary>
              <div class="order-more-body">
                <div class="field">
                  <label for="publisher-site">Requested publisher website</label>
                  <input id="publisher-site" name="Requested Publisher Website" placeholder="Enter a site or domain if you have selected one" />
                </div>
                <div class="form-row">
                  <div class="field">
                    <label for="article-topic">Article topic or keywords</label>
                    <input id="article-topic" name="Article Topic or Keywords" placeholder="Topic, title or target keywords" />
                  </div>
                  <div class="field">
                    <label for="article-source">Article option</label>
                    <select id="article-source" name="Article Option">
                      <option value="Not decided yet">Not decided yet</option>
                      <option value="I will upload the article">I will upload the article</option>
                      <option value="Article pasted below">Article pasted below</option>
                      <option value="Web Grouth should write the article">Web Grouth should write the article</option>
                      <option value="I will provide it later">I will provide it later</option>
                    </select>
                  </div>
                </div>
                <div class="field">
                  <label for="article-content">Paste your article</label>
                  <textarea id="article-content" name="Provided Article Text" class="article-area" rows="4" placeholder="Paste the article here if it is ready."></textarea>
                </div>
                <div class="field">
                  <label for="article-file">Upload article</label>
                  <input id="article-file" name="Article Attachment" type="file" accept=".doc,.docx,.pdf,.txt,.rtf" data-article-file />
                  <small class="field-help" data-file-help>DOC, DOCX, PDF, TXT or RTF — maximum 10 MB.</small>
                </div>
              </div>
            </details>

            <p class="form-terms">By submitting, you agree that price, publisher and final terms will be confirmed before work starts.</p>
            <p class="form-message" data-form-message role="alert" aria-live="polite"></p>
            <div class="step-actions">
              <button type="button" class="saas-button ghost step-back" data-back="1">← Back</button>
              <button class="saas-button primary form-submit" type="submit">Submit Order <span>↗</span></button>
            </div>
            <div class="form-security"><span>Only email is required</span><span>No payment now</span><span>Human reply within 24h</span></div>
          </div>
        </form>

        <aside class="form-aside" data-reveal data-reveal-delay="1">
          <div class="aside-card blue">
            <span>Easy to submit</span>
            <h3>You can order with only your email.</h3>
            <p>If any details are missing, we will ask you in our email reply.</p>
          </div>
          <div class="aside-card">
            <span>Simple process</span>
            <h3>You stay in control</h3>
            <ul class="aside-list">
              <li>Review the suggested websites</li>
              <li>Confirm the site and price</li>
              <li>Approve before work starts</li>
              <li>Receive the live URL</li>
            </ul>
          </div>
          <div class="aside-card trust-card">
            <span>Trusted by agencies</span>
            <div class="trust-metrics">
              <div><strong>5,000+</strong><span>orders handled</span></div>
              <div><strong>40,000+</strong><span>websites</span></div>
              <div><strong>30+</strong><span>niches</span></div>
            </div>
          </div>
          <ContactLinks compact={true} />
        </aside>
      </div>
    </section>
  </div>

  <script is:inline>
    (function() {
      const form = document.querySelector('[data-order-form]');
      if (!form) return;

      const panels = form.querySelectorAll('[data-step-panel]');
      const tabs = form.querySelectorAll('[data-step]');
      const totalSteps = panels.length;
      let currentStep = 0;

      function showStep(n) {
        panels.forEach((p, i) => {
          const isActive = i === n;
          p.classList.toggle('hidden', !isActive);
          p.hidden = !isActive;
          p.setAttribute('aria-hidden', String(!isActive));
        });
        tabs.forEach((t, i) => {
          t.setAttribute('aria-selected', String(i === n));
          t.classList.toggle('active', i === n);
          t.classList.toggle('completed', i < n);
        });
        currentStep = n;
        if (window.innerWidth < 768) {
          form.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }

      form.querySelectorAll('[data-next]').forEach(btn => {
        btn.addEventListener('click', () => {
          const next = parseInt(btn.dataset.next, 10);
          const currentPanel = panels[currentStep];
          const required = currentPanel.querySelectorAll('[required]');
          let valid = true;
          required.forEach(field => {
            if (!field.checkValidity()) {
              field.reportValidity();
              valid = false;
            }
          });
          if (valid) showStep(next);
        });
      });

      form.querySelectorAll('[data-back]').forEach(btn => {
        btn.addEventListener('click', () => showStep(parseInt(btn.dataset.back, 10)));
      });

      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => {
          if (i <= currentStep) showStep(i);
        });
      });

      const params = new URLSearchParams(window.location.search);
      const selected = params.get('service') || params.get('offer');
      const selectedNiche = params.get('niche');
      const select = document.querySelector('[data-order-service]');
      const source = document.querySelector('[data-source-offer]');
      if (selected && select) {
        const option = [...select.options].find(item => item.value.toLowerCase() === selected.toLowerCase());
        if (option) select.value = option.value;
        if (source) source.value = selected;
      }
      const nicheField = document.querySelector('#required-niche');
      if (selectedNiche && nicheField) nicheField.value = selectedNiche;

      const articleFile = document.querySelector('[data-article-file]');
      const fileHelp = document.querySelector('[data-file-help]');
      articleFile?.addEventListener('change', () => {
        const file = articleFile.files?.[0];
        const tooLarge = file && file.size > 10 * 1024 * 1024;
        articleFile.setCustomValidity(tooLarge ? 'Please upload an article file smaller than 10 MB.' : '');
        if (fileHelp) {
          fileHelp.textContent = tooLarge
            ? 'This file is too large. Please choose a file under 10 MB.'
            : (file ? `Selected: ${file.name}` : 'Accepted: DOC, DOCX, PDF, TXT or RTF — maximum 10 MB.');
        }
      });

      const submitButton = form.querySelector('[type="submit"]');
      const formMessage = form.querySelector('[data-form-message]');
      const buttonContent = submitButton?.innerHTML;

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!form.reportValidity()) return;
        if (formMessage) {
          formMessage.textContent = '';
          formMessage.classList.remove('show');
        }
        if (submitButton) {
          submitButton.disabled = true;
          submitButton.textContent = 'Sending your order…';
        }
        try {
          const response = await fetch('https://formsubmit.co/ajax/nasirhaiderseo@gmail.com', {
            method: 'POST',
            headers: { Accept: 'application/json' },
            body: new FormData(form),
          });
          const result = await response.json().catch(() => ({}));
          const sent = response.ok && (result.success === true || result.success === 'true');
          if (!sent) throw new Error(result.message || 'Your order could not be sent.');
          const email = form.querySelector('[name="email"]')?.value?.trim();
          if (email) sessionStorage.setItem('webgrouth-order-email', email);
          window.location.assign('/order-success');
        } catch (error) {
          if (formMessage) {
            formMessage.textContent = 'We could not send your order right now. Please try again or contact us on WhatsApp.';
            formMessage.classList.add('show');
          }
        } finally {
          if (submitButton) {
            submitButton.disabled = false;
            submitButton.innerHTML = buttonContent || 'Submit Order <span>↗</span>';
          }
        }
      });
    })();
  </script>

  <style>
    .multi-step-form { position: relative; }

    .step-progress {
      display: flex;
      gap: 0;
      margin-bottom: 28px;
      border-bottom: 2px solid #e7e4de;
    }
    .step-tab {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 12px 8px;
      background: none;
      border: none;
      border-bottom: 2px solid transparent;
      margin-bottom: -2px;
      color: #64748b;
      font: 600 0.78rem Inter, sans-serif;
      cursor: pointer;
      transition: all 0.2s;
    }
    .step-tab:hover { color: #111827; }
    .step-tab.active {
      color: #2563eb;
      border-bottom-color: #2563eb;
    }
    .step-tab.completed {
      color: #059669;
      border-bottom-color: #059669;
    }
    .step-tab .step-number {
      display: grid;
      place-items: center;
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: #e7e4de;
      color: #64748b;
      font-size: 0.7rem;
      font-weight: 700;
    }
    .step-tab.active .step-number {
      background: #2563eb;
      color: #fff;
    }
    .step-tab.completed .step-number {
      background: #059669;
      color: #fff;
    }

    .step-panel { animation: fadeIn 0.3s ease; }
    .step-panel.hidden { display: none; }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .step-actions {
      display: flex;
      gap: 12px;
      margin-top: 24px;
      padding-top: 20px;
      border-top: 1px solid #e7e4de;
    }
    .saas-button.ghost {
      background: transparent;
      color: #64748b;
      border: 1px solid #d8d5ce;
    }
    .saas-button.ghost:hover {
      background: #f5f5f0;
      color: #111827;
    }

    .field.required label::after {
      content: ' *';
      color: #dc2626;
    }
    .field-help {
      display: block;
      margin-top: 4px;
      color: #64748b;
      font-size: 0.69rem;
    }

    .trust-card {
      background: linear-gradient(135deg, #faf9f6 0%, #f0efe9 100%);
      border: 1px solid #e7e4de;
    }
    .trust-metrics {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin-top: 12px;
    }
    .trust-metrics div {
      text-align: center;
    }
    .trust-metrics strong {
      display: block;
      color: #111827;
      font: 700 1.1rem Manrope, sans-serif;
    }
    .trust-metrics span {
      color: #64748b;
      font-size: 0.65rem;
    }

    .form-section-heading h2 {
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 8px;
    }
    .order-more {
      margin: 4px 0 18px;
      overflow: hidden;
      border: 1px solid #d8d5ce;
      border-radius: 8px;
      background: #fff;
    }
    .order-more summary {
      min-height: 56px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      padding: 0 16px;
      color: #111827;
      font: 700 0.82rem Manrope, sans-serif;
      cursor: pointer;
      list-style: none;
    }
    .order-more summary::-webkit-details-marker { display: none; }
    .order-more summary::after {
      content: '+';
      display: grid;
      place-items: center;
      width: 24px;
      height: 24px;
      margin-left: auto;
      color: #2563eb;
      border: 1px solid #cbd5e1;
      border-radius: 50%;
      font: 700 1rem Inter, sans-serif;
    }
    .order-more[open] summary::after { content: '−'; }
    .order-more summary small { color: #64748b; font: 600 0.64rem Inter, sans-serif; }
    .order-more-body { padding: 18px 16px 2px; border-top: 1px solid #e7e4de; }
    .article-area { min-height: 120px !important; }
    .form-terms { margin: 0 0 15px; color: #64748b !important; font-size: 0.69rem; line-height: 1.55; }
    .form-message { display: none; margin: 0 0 14px; padding: 12px 14px; color: #991b1b !important; border: 1px solid #fecaca; border-radius: 7px; background: #fef2f2; font-size: 0.75rem; font-weight: 600; line-height: 1.55; }
    .form-message.show { display: block; }
    .form-submit:disabled { cursor: wait; opacity: 0.72; }
    .form-security { display: flex; gap: 16px; margin-top: 16px; padding-top: 16px; border-top: 1px solid #e7e4de; }
    .form-security span { color: #64748b; font-size: 0.69rem; }
    .form-security span::before { content: '✓ '; color: #059669; }

    @media (max-width: 640px) {
      .step-tab .step-label { display: none; }
      .step-actions { flex-direction: column; }
      .trust-metrics { grid-template-columns: 1fr; }
    }
  </style>
</BaseLayout>
