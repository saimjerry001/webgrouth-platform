---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_URL, canonicalUrl } from '../../lib/seo';

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Free Tools', item: canonicalUrl('/tools') },
    { '@type': 'ListItem', position: 3, name: 'Guest Post Price Calculator', item: canonicalUrl('/tools/guest-post-price-calculator') },
  ],
};
---

<BaseLayout title="Free Guest Post Price Calculator | Web Grouth" description="Enter a website's DA, DR and estimated traffic to get a ballpark guest post price range, based on common market patterns." structuredData={pageSchema}>
  <section class="page-hero section-tight">
    <div class="shell">
      <div class="article-header" data-reveal>
        <div class="breadcrumbs"><a href="/">Home</a><span>/</span><a href="/tools">Free Tools</a><span>/</span><span>Price Calculator</span></div>
        <div class="eyebrow"><span class="eyebrow-dot"></span> Free tool</div>
        <h1>Guest post price calculator.</h1>
        <p>Get a ballpark price range from a website's authority and traffic. This is a starting reference for negotiation, not a guaranteed market price.</p>
      </div>
    </div>
  </section>

  <section class="section section-tight">
    <div class="shell tool-layout">
      <div>
        <div class="form-row">
          <div class="field"><label for="gp-da">Domain Authority (DA)</label><input id="gp-da" type="number" min="0" max="100" placeholder="e.g. 45" /></div>
          <div class="field"><label for="gp-dr">Domain Rating (DR)</label><input id="gp-dr" type="number" min="0" max="100" placeholder="e.g. 40" /></div>
        </div>
        <div class="form-row">
          <div class="field"><label for="gp-traffic">Estimated monthly organic traffic</label><input id="gp-traffic" type="number" min="0" placeholder="e.g. 5000" /></div>
          <div class="field">
            <label for="gp-niche">Niche</label>
            <select id="gp-niche">
              <option value="1">General / lifestyle</option>
              <option value="1.3">Business &amp; finance</option>
              <option value="1.25">Technology &amp; SaaS</option>
              <option value="1.15">Health &amp; medical</option>
              <option value="0.9">Other / not listed</option>
            </select>
          </div>
        </div>
        <p class="form-note">This estimate combines authority, traffic and niche demand. Real prices also depend on the publisher's editorial quality, audience relevance and negotiation — always confirm terms directly with the publisher.</p>
      </div>
      <div class="tool-result" data-reveal>
        <span class="kicker">Estimated price range</span>
        <div class="price-range" id="gp-range">$0 &ndash; $0</div>
        <p id="gp-explain" class="form-note">Enter the details to see an estimate.</p>
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="shell content-grid">
      <div><span class="kicker">Use this responsibly</span><h2>A metric is a starting point, not the decision.</h2></div>
      <div><p>Do not rely on DA, DR or this calculator alone. Review the publisher's actual audience, editorial quality and traffic sources before ordering &mdash; see our <a href="/blog/how-to-vet-guest-post-sites">guide to vetting guest post sites</a>.</p></div>
    </div>
  </section>

  <section class="cta-block">
    <div class="shell cta-card" data-reveal>
      <div class="eyebrow"><span class="eyebrow-dot"></span> Want real publisher options?</div>
      <h2>Compare vetted guest posting sites.</h2>
      <a class="button" href="/guest-posting">View guest posting service <span>&#8599;</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .tool-layout { display: grid; grid-template-columns: 1.2fr .8fr; gap: 40px; align-items: start; }
  .tool-result { padding: 32px; border: 1px solid var(--line); border-radius: var(--radius); background: rgba(255,255,255,.03); position: sticky; top: 120px; }
  .price-range { margin: 14px 0; color: var(--lime); font-family: 'Manrope', sans-serif; font-size: 2.4rem; font-weight: 800; }
  @media (max-width: 900px) { .tool-layout { grid-template-columns: 1fr; } .tool-result { position: static; } }
</style>

<script>
  const daInput = document.getElementById('gp-da') as HTMLInputElement;
  const drInput = document.getElementById('gp-dr') as HTMLInputElement;
  const trafficInput = document.getElementById('gp-traffic') as HTMLInputElement;
  const nicheSelect = document.getElementById('gp-niche') as HTMLSelectElement;
  const rangeEl = document.getElementById('gp-range')!;
  const explainEl = document.getElementById('gp-explain')!;

  function update() {
    const da = Number(daInput.value) || 0;
    const dr = Number(drInput.value) || 0;
    const traffic = Number(trafficInput.value) || 0;
    const nicheMultiplier = Number(nicheSelect.value) || 1;

    if (da === 0 && dr === 0 && traffic === 0) {
      rangeEl.textContent = '$0 – $0';
      explainEl.textContent = 'Enter the details to see an estimate.';
      return;
    }

    const authorityScore = (da + dr) / 2;
    const trafficFactor = Math.log10(Math.max(traffic, 10)) - 1;
    const base = Math.max(0, authorityScore * 2.2 + trafficFactor * 25);
    const mid = base * nicheMultiplier;
    const low = Math.round((mid * 0.75) / 5) * 5;
    const high = Math.round((mid * 1.3) / 5) * 5;

    rangeEl.textContent = `$${low.toLocaleString()} – $${high.toLocaleString()}`;
    explainEl.textContent = 'This range reflects typical market patterns for the authority, traffic and niche you entered.';
  }

  [daInput, drInput, trafficInput, nicheSelect].forEach((el) => el.addEventListener('input', update));
  update();
</script>
