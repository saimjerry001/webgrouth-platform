---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_URL, canonicalUrl } from '../../lib/seo';

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Free Tools', item: canonicalUrl('/tools') },
    { '@type': 'ListItem', position: 3, name: 'Meta Title & Description Checker', item: canonicalUrl('/tools/meta-tag-checker') },
  ],
};

const toolSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Meta Title & Description Checker',
  url: canonicalUrl('/tools/meta-tag-checker'),
  description: "Check your title and meta description length and preview how the page will look in Google search results before you publish.",
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any (runs in browser)',
  isAccessibleForFree: true,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  provider: {
    '@type': 'Organization',
    name: 'Web Grouth',
    url: SITE_URL,
  },
};
---

<BaseLayout title="Free Meta Title & Description Checker | Web Grouth" description="Check your title and meta description length and preview how the page will look in Google search results before you publish." structuredData={[pageSchema, toolSchema]}>
  <div class="homev3">
    <section class="tool-hero-v3">
      <div class="shell tool-hero-v3-inner" data-reveal>
        <div class="breadcrumbs"><a href="/">Home</a><span>/</span><a href="/tools">Free Tools</a><span>/</span><span>Meta Tag Checker</span></div>
        <span class="tool-icon-badge" set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>`} />
        <h1>Meta title &amp; description checker.</h1>
        <p>Type your title and description to see a live Google search preview and check whether either will be truncated.</p>
      </div>
    </section>

    <section class="homev3-section" style="padding-top: 50px;">
      <div class="shell tool-layout">
        <div>
          <div class="field">
            <label for="mt-url">Page URL (optional, for the preview)</label>
            <input id="mt-url" type="text" placeholder="https://www.yoursite.com/example-page" />
          </div>
          <div class="field">
            <label for="mt-title">Page title <span id="mt-title-count">0 / 60</span></label>
            <input id="mt-title" type="text" placeholder="Write your page title..." maxlength="200" />
            <div class="pixel-bar"><div class="pixel-bar-fill" id="mt-title-bar"></div></div>
            <span class="pixel-note" id="mt-title-px">0 / 600px (estimated desktop width)</span>
          </div>
          <div class="field" style="margin-bottom: 0;">
            <label for="mt-desc">Meta description <span id="mt-desc-count">0 / 160</span></label>
            <textarea id="mt-desc" placeholder="Write your meta description..." style="min-height: 120px;" maxlength="400"></textarea>
            <div class="pixel-bar"><div class="pixel-bar-fill" id="mt-desc-bar"></div></div>
            <span class="pixel-note" id="mt-desc-px">0 / 920px (estimated desktop width)</span>
          </div>
        </div>
        <div class="tool-result-v3" data-reveal>
          <span class="live-label"><span class="live-dot"></span> Live preview</span>
          <div class="serp-preview">
            <div class="serp-url" id="mt-preview-url">www.yoursite.com &rsaquo; example-page</div>
            <div class="serp-title" id="mt-preview-title">Your page title will appear here</div>
            <div class="serp-desc" id="mt-preview-desc">Your meta description will appear here. Google may rewrite it if it does not match the page or the searcher's query.</div>
          </div>
          <p class="form-note" id="mt-warning" style="margin-top: 16px; margin-bottom: 0;"></p>
        </div>
      </div>
    </section>

    <section class="homev3-section homev3-intro">
      <div class="shell content-grid">
        <div><span class="kicker">Why length matters</span><h2>Google measures pixel width, not characters.</h2></div>
        <div><p>A title around 50&ndash;60 characters and a description around 120&ndash;160 characters usually display fully on desktop, but Google can rewrite either one to better match a search query. This tool gives a practical estimate, not a guarantee of how a specific result will render.</p></div>
      </div>
    </section>

    <section class="cta-block">
      <div class="shell cta-card" data-reveal>
        <div class="eyebrow"><span class="eyebrow-dot"></span> Want a full on-page review?</div>
        <h2>Talk to Web Grouth about your SEO.</h2>
        <a class="button" href="/seo-services">View SEO services <span>&#8599;</span></a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .tool-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: start; }
  .field label span { float: right; color: var(--muted); font-weight: 500; text-transform: none; letter-spacing: 0; }
  .pixel-bar { overflow: hidden; height: 5px; margin-top: 8px; border-radius: 999px; background: rgba(23,26,34,.08); }
  .pixel-bar-fill { height: 100%; width: 0%; background: #34d399; border-radius: 999px; transition: width .2s ease, background .2s ease; }
  .pixel-bar-fill.warn { background: #f59e0b; }
  .pixel-bar-fill.over { background: #ef4444; }
  .pixel-note { display: block; margin-top: 5px; margin-bottom: 16px; color: var(--muted); font-size: 11.5px; }
  .serp-preview { padding: 22px 24px; border-radius: 12px; background: #fff; font-family: arial, sans-serif; }
  .serp-url { margin-bottom: 4px; color: #202124; font-size: 14px; }
  .serp-title { margin-bottom: 4px; overflow: hidden; color: #1a0dab; font-size: 20px; line-height: 1.3; text-overflow: ellipsis; white-space: nowrap; }
  .serp-desc { color: #4d5156; font-size: 14px; line-height: 1.5; }
  @media (max-width: 900px) { .tool-layout { grid-template-columns: 1fr; } }
</style>

<script>
  const urlInput = document.getElementById('mt-url') as HTMLInputElement;
  const titleInput = document.getElementById('mt-title') as HTMLInputElement;
  const descInput = document.getElementById('mt-desc') as HTMLTextAreaElement;
  const titleCount = document.getElementById('mt-title-count')!;
  const descCount = document.getElementById('mt-desc-count')!;
  const titleBar = document.getElementById('mt-title-bar')!;
  const descBar = document.getElementById('mt-desc-bar')!;
  const titlePx = document.getElementById('mt-title-px')!;
  const descPx = document.getElementById('mt-desc-px')!;
  const previewUrl = document.getElementById('mt-preview-url')!;
  const previewTitle = document.getElementById('mt-preview-title')!;
  const previewDesc = document.getElementById('mt-preview-desc')!;
  const warning = document.getElementById('mt-warning')!;

  // Google renders SERP titles in ~20px Arial and descriptions in ~14px
  // Arial on desktop. Measuring the actual rendered pixel width (via a
  // canvas, the same technique real font-rendering uses) is a much closer
  // approximation of Google's truncation point than counting characters,
  // since a title full of "W"/"M" truncates far earlier than one full of "i"/"l".
  const measureCanvas = document.createElement('canvas');
  const measureCtx = measureCanvas.getContext('2d');
  const TITLE_MAX_PX = 600;
  const DESC_MAX_PX = 920;

  function pixelWidth(text: string, font: string): number {
    if (!measureCtx) return text.length * 8; // no canvas support: rough fallback
    measureCtx.font = font;
    return measureCtx.measureText(text).width;
  }

  function updateBar(bar: HTMLElement, note: HTMLElement, px: number, max: number, unit: string) {
    const pct = Math.min(100, (px / max) * 100);
    bar.style.width = `${pct}%`;
    bar.classList.remove('warn', 'over');
    if (px > max) bar.classList.add('over');
    else if (pct > 85) bar.classList.add('warn');
    note.textContent = `${Math.round(px)} / ${max}${unit} (estimated desktop width)`;
  }

  function update() {
    const title = titleInput.value.trim();
    const desc = descInput.value.trim();
    const url = urlInput.value.trim();

    const titlePxWidth = pixelWidth(title, '20px arial');
    const descPxWidth = pixelWidth(desc, '14px arial');

    titleCount.textContent = `${title.length} / 60`;
    descCount.textContent = `${desc.length} / 160`;
    updateBar(titleBar, titlePx, titlePxWidth, TITLE_MAX_PX, 'px');
    updateBar(descBar, descPx, descPxWidth, DESC_MAX_PX, 'px');

    previewTitle.textContent = title || 'Your page title will appear here';
    previewDesc.textContent = desc || "Your meta description will appear here. Google may rewrite it if it does not match the page or the searcher's query.";

    if (url) {
      try {
        const u = new URL(url.startsWith('http') ? url : `https://${url}`);
        const parts = u.pathname.split('/').filter(Boolean);
        previewUrl.textContent = [u.hostname, ...parts].join(' › ');
      } catch {
        previewUrl.textContent = url;
      }
    } else {
      previewUrl.textContent = 'www.yoursite.com › example-page';
    }

    const warnings: string[] = [];
    if (titlePxWidth > TITLE_MAX_PX) warnings.push(`Title's rendered width (~${Math.round(titlePxWidth)}px) is over Google's ~${TITLE_MAX_PX}px desktop cutoff and will likely be truncated.`);
    if (descPxWidth > DESC_MAX_PX) warnings.push(`Description's rendered width (~${Math.round(descPxWidth)}px) is over Google's ~${DESC_MAX_PX}px cutoff and will likely be truncated.`);
    if (title.length > 0 && title.length < 30) warnings.push('Title is quite short — there may be room for more descriptive wording.');
    warning.textContent = warnings.join(' ');
  }

  [urlInput, titleInput, descInput].forEach((el) => el.addEventListener('input', update));
  update();
</script>
