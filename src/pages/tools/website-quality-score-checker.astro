---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_URL, canonicalUrl } from '../../lib/seo';

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Free Tools', item: canonicalUrl('/tools') },
    { '@type': 'ListItem', position: 3, name: 'Website Quality Score Checker', item: canonicalUrl('/tools/website-quality-score-checker') },
  ],
};

const toolSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Website Quality Score Checker',
  url: canonicalUrl('/tools/website-quality-score-checker'),
  description: "Enter a website's DA, PA, DR, traffic and price to get a quick Premium, Standard or Budget quality tier for shortlisting guest post opportunities.",
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Any (runs in browser)',
  isAccessibleForFree: true,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  provider: {
    '@type': 'Organization',
    name: 'Web Grouth',
    url: SITE_URL,
  },
};
---

<BaseLayout title="Free Website Quality Score Checker | Web Grouth" description="Enter a website's DA, PA, DR, traffic and price to get a quick Premium, Standard or Budget quality tier for shortlisting guest post opportunities." structuredData={[pageSchema, toolSchema]}>
  <div class="homev3">
    <section class="tool-hero-v3">
      <div class="shell tool-hero-v3-inner" data-reveal>
        <div class="breadcrumbs"><a href="/">Home</a><span>/</span><a href="/tools">Free Tools</a><span>/</span><span>Website Quality Score</span></div>
        <span class="tool-icon-badge" set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m12 2 3 7 7 1-5 5 1 7-6-3-6 3 1-7-5-5 7-1 3-7Z"/></svg>`} />
        <h1>Website quality score checker.</h1>
        <p>A quick way to sort a shortlist into tiers before a full review. See our <a href="/blog/how-to-vet-guest-post-sites">complete site-vetting guide</a> for the checks a score cannot replace.</p>
      </div>
    </section>

    <section class="homev3-section" style="padding-top: 50px;">
      <div class="shell tool-layout">
        <div>
          <div class="form-row">
            <div class="field"><label for="qs-da">DA</label><input id="qs-da" type="number" min="0" max="100" placeholder="e.g. 55" /></div>
            <div class="field"><label for="qs-pa">PA</label><input id="qs-pa" type="number" min="0" max="100" placeholder="e.g. 48" /></div>
          </div>
          <div class="form-row">
            <div class="field"><label for="qs-dr">DR</label><input id="qs-dr" type="number" min="0" max="100" placeholder="e.g. 50" /></div>
            <div class="field"><label for="qs-traffic">Monthly traffic</label><input id="qs-traffic" type="number" min="0" placeholder="e.g. 6000" /></div>
          </div>
          <div class="field" style="margin-bottom:0;"><label for="qs-price">Asking price ($)</label><input id="qs-price" type="number" min="0" placeholder="e.g. 60" /></div>
        </div>
        <div class="tool-result-v3 tier-result" data-reveal>
          <span class="live-label"><span class="live-dot"></span> Live score</span>
          <div class="result-figure" id="qs-tier">&mdash;</div>
          <p id="qs-explain" class="form-note" style="margin-bottom:0;">Enter DA, PA, DR and traffic to see a tier.</p>
        </div>
      </div>
    </section>

    <section class="homev3-section homev3-intro">
      <div class="shell content-grid">
        <div><span class="kicker">Use this as a first filter only</span><h2>A tier sorts a list. It does not approve a site.</h2></div>
        <div><p>This score combines authority and traffic signals to help you triage a long list quickly. Before ordering, still review the audience, recent articles, indexing and publishing terms &mdash; use our <a href="/guest-post-quality-checklist">free quality checklist</a> for that step.</p></div>
      </div>
    </section>

    <section class="cta-block">
      <div class="shell cta-card" data-reveal>
        <div class="eyebrow"><span class="eyebrow-dot"></span> Want a pre-vetted shortlist?</div>
        <h2>Skip the manual triage.</h2>
        <a class="button" href="/guest-posting">View guest posting service <span>&#8599;</span></a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .tool-layout { display: grid; grid-template-columns: 1.2fr .8fr; gap: 40px; align-items: start; }
  .tier-result { text-align: center; }
  .result-figure { transition: transform .18s ease; }
  .result-figure.pop { transform: scale(1.1); }
  .result-figure.premium { color: #34d399; }
  .result-figure.standard { color: #60a5fa; }
  .result-figure.budget { color: #fb923c; }
  @media (max-width: 900px) { .tool-layout { grid-template-columns: 1fr; } }
</style>

<script>
  const daInput = document.getElementById('qs-da') as HTMLInputElement;
  const paInput = document.getElementById('qs-pa') as HTMLInputElement;
  const drInput = document.getElementById('qs-dr') as HTMLInputElement;
  const trafficInput = document.getElementById('qs-traffic') as HTMLInputElement;
  const priceInput = document.getElementById('qs-price') as HTMLInputElement;
  const tierEl = document.getElementById('qs-tier')!;
  const explainEl = document.getElementById('qs-explain')!;

  function pop(el: HTMLElement) {
    el.classList.remove('pop');
    void el.offsetWidth;
    el.classList.add('pop');
    setTimeout(() => el.classList.remove('pop'), 200);
  }

  function update() {
    const da = Number(daInput.value);
    const pa = Number(paInput.value);
    const dr = Number(drInput.value);
    const traffic = Number(trafficInput.value) || 0;
    const price = Number(priceInput.value) || 0;

    if (!daInput.value && !paInput.value && !drInput.value) {
      tierEl.textContent = '—';
      tierEl.className = 'result-figure';
      explainEl.textContent = 'Enter DA, PA, DR and traffic to see a tier.';
      return;
    }

    const authority = (da + pa + dr) / 3;
    let tier: 'Premium' | 'Standard' | 'Budget';
    let reason: string;

    if (authority >= 50 && traffic >= 3000) {
      tier = 'Premium';
      reason = 'High authority with meaningful traffic — a strong first-filter candidate.';
    } else if (authority >= 25) {
      tier = 'Standard';
      reason = 'Reasonable authority — worth a closer look at audience and content.';
    } else {
      tier = 'Budget';
      reason = 'Lower authority or traffic — still review it if it is genuinely relevant to your niche.';
    }

    if (price > 0 && price < authority * 1.5 && tier !== 'Budget') {
      reason += ' The price also looks reasonable for this authority level.';
    }

    if (tierEl.textContent !== tier) pop(tierEl);
    tierEl.textContent = tier;
    tierEl.className = `result-figure ${tier.toLowerCase()}`;
    explainEl.textContent = reason;
  }

  [daInput, paInput, drInput, trafficInput, priceInput].forEach((el) => el.addEventListener('input', update));
  update();
</script>
