---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_URL, canonicalUrl } from '../../lib/seo';

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Free Tools', item: canonicalUrl('/tools') },
    { '@type': 'ListItem', position: 3, name: 'Link Insertion vs Guest Post Cost Comparison', item: canonicalUrl('/tools/link-insertion-vs-guest-post-calculator') },
  ],
};
---

<BaseLayout title="Free Link Insertion vs Guest Post Cost Calculator | Web Grouth" description="Compare the complete cost of a new guest post against an existing-article link insertion, including writing and editorial fees." structuredData={pageSchema}>
  <section class="page-hero section-tight">
    <div class="shell">
      <div class="article-header" data-reveal>
        <div class="breadcrumbs"><a href="/">Home</a><span>/</span><a href="/tools">Free Tools</a><span>/</span><span>Cost Comparison</span></div>
        <div class="eyebrow"><span class="eyebrow-dot"></span> Free tool</div>
        <h1>Link insertion vs guest post cost comparison.</h1>
        <p>Compare the <strong>complete</strong> deliverable, not just the headline price. See our full <a href="/blog/guest-posting-vs-link-insertion">guest posting vs link insertion guide</a> for how to choose between them.</p>
      </div>
    </div>
  </section>

  <section class="section section-tight">
    <div class="shell tool-layout">
      <div class="compare-column">
        <h3>Guest post</h3>
        <div class="field"><label for="cmp-gp-place">Placement fee ($)</label><input id="cmp-gp-place" type="number" min="0" placeholder="e.g. 150" /></div>
        <div class="field"><label for="cmp-gp-write">Writing fee ($, 0 if you supply the article)</label><input id="cmp-gp-write" type="number" min="0" placeholder="e.g. 60" /></div>
        <div class="field" style="margin-bottom:0;"><label for="cmp-gp-extra">Any other fees ($)</label><input id="cmp-gp-extra" type="number" min="0" placeholder="e.g. 0" /></div>
      </div>
      <div class="compare-column">
        <h3>Link insertion</h3>
        <div class="field"><label for="cmp-li-place">Placement fee ($)</label><input id="cmp-li-place" type="number" min="0" placeholder="e.g. 180" /></div>
        <div class="field"><label for="cmp-li-edit">Editorial update fee ($, if separate)</label><input id="cmp-li-edit" type="number" min="0" placeholder="e.g. 0" /></div>
        <div class="field" style="margin-bottom:0;"><label for="cmp-li-extra">Any other fees ($)</label><input id="cmp-li-extra" type="number" min="0" placeholder="e.g. 0" /></div>
      </div>
    </div>
  </section>

  <section class="section section-tight section-soft">
    <div class="shell">
      <div class="result-row" data-reveal>
        <div class="result-box"><span class="kicker">Guest post total</span><strong id="cmp-gp-total">$0</strong></div>
        <div class="result-box"><span class="kicker">Link insertion total</span><strong id="cmp-li-total">$0</strong></div>
        <div class="result-box highlight"><span class="kicker">Difference</span><strong id="cmp-diff">$0</strong><p id="cmp-verdict" class="form-note">Enter both sides to compare.</p></div>
      </div>
    </div>
  </section>

  <section class="cta-block">
    <div class="shell cta-card" data-reveal>
      <div class="eyebrow"><span class="eyebrow-dot"></span> Not sure which fits your page?</div>
      <h2>Send your target URL and we'll advise.</h2>
      <a class="button" href="/order">Get placement options <span>&#8599;</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .tool-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .compare-column { padding: 26px; border: 1px solid var(--line); border-radius: var(--radius); background: rgba(255,255,255,.022); }
  .compare-column h3 { margin-bottom: 18px; }
  .result-row { display: grid; grid-template-columns: 1fr 1fr 1.4fr; gap: 16px; }
  .result-box { padding: 24px; border: 1px solid var(--line); border-radius: var(--radius-sm); background: rgba(255,255,255,.03); text-align: center; }
  .result-box strong { display: block; margin: 10px 0; color: var(--paper); font-family: 'Manrope', sans-serif; font-size: 1.9rem; font-weight: 800; }
  .result-box.highlight { border-color: rgba(184,255,90,.4); background: rgba(184,255,90,.05); }
  .result-box.highlight strong { color: var(--lime); }
  @media (max-width: 900px) { .tool-layout, .result-row { grid-template-columns: 1fr; } }
</style>

<script>
  const ids = ['cmp-gp-place', 'cmp-gp-write', 'cmp-gp-extra', 'cmp-li-place', 'cmp-li-edit', 'cmp-li-extra'];
  const inputs = Object.fromEntries(ids.map((id) => [id, document.getElementById(id) as HTMLInputElement]));
  const gpTotalEl = document.getElementById('cmp-gp-total')!;
  const liTotalEl = document.getElementById('cmp-li-total')!;
  const diffEl = document.getElementById('cmp-diff')!;
  const verdictEl = document.getElementById('cmp-verdict')!;

  function num(id: string) {
    return Number(inputs[id].value) || 0;
  }

  function update() {
    const gpTotal = num('cmp-gp-place') + num('cmp-gp-write') + num('cmp-gp-extra');
    const liTotal = num('cmp-li-place') + num('cmp-li-edit') + num('cmp-li-extra');
    gpTotalEl.textContent = `$${gpTotal.toLocaleString()}`;
    liTotalEl.textContent = `$${liTotal.toLocaleString()}`;

    const anyEntered = ids.some((id) => inputs[id].value !== '');
    if (!anyEntered) {
      diffEl.textContent = '$0';
      verdictEl.textContent = 'Enter both sides to compare.';
      return;
    }

    const diff = Math.abs(gpTotal - liTotal);
    diffEl.textContent = `$${diff.toLocaleString()}`;
    if (gpTotal === liTotal) {
      verdictEl.textContent = 'Both options cost the same — base the choice on content fit, not price.';
    } else if (gpTotal < liTotal) {
      verdictEl.textContent = `The guest post is $${diff.toLocaleString()} cheaper here.`;
    } else {
      verdictEl.textContent = `The link insertion is $${diff.toLocaleString()} cheaper here.`;
    }
  }

  ids.forEach((id) => inputs[id].addEventListener('input', update));
  update();
</script>
