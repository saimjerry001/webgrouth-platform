---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_URL, canonicalUrl } from '../../lib/seo';

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Free Tools', item: canonicalUrl('/tools') },
    { '@type': 'ListItem', position: 3, name: 'Link Insertion vs Guest Post Cost Comparison', item: canonicalUrl('/tools/link-insertion-vs-guest-post-calculator') },
  ],
};

const toolSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Link Insertion vs Guest Post Cost Calculator',
  url: canonicalUrl('/tools/link-insertion-vs-guest-post-calculator'),
  description: "Compare the complete cost of a new guest post against an existing-article link insertion, including writing and editorial fees.",
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Any (runs in browser)',
  isAccessibleForFree: true,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  provider: {
    '@type': 'Organization',
    name: 'Web Grouth',
    url: SITE_URL,
  },
};
---

<BaseLayout title="Free Link Insertion vs Guest Post Cost Calculator | Web Grouth" description="Compare the complete cost of a new guest post against an existing-article link insertion, including writing and editorial fees." structuredData={[pageSchema, toolSchema]}>
  <div class="homev3">
    <section class="tool-hero-v3">
      <div class="shell tool-hero-v3-inner" data-reveal>
        <div class="breadcrumbs"><a href="/">Home</a><span>/</span><a href="/tools">Free Tools</a><span>/</span><span>Cost Comparison</span></div>
        <span class="tool-icon-badge" set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18M7 21h10M5 7l-3 6a3 3 0 0 0 6 0l-3-6Zm14 0-3 6a3 3 0 0 0 6 0l-3-6ZM5 7h14M12 3l-2 4h4l-2-4Z"/></svg>`} />
        <h1>Link insertion vs guest post cost comparison.</h1>
        <p>Compare the <strong>complete</strong> deliverable, not just the headline price. See our full <a href="/blog/guest-posting-vs-link-insertion">guest posting vs link insertion guide</a> for how to choose between them.</p>
      </div>
    </section>

    <section class="homev3-section" style="padding-top: 50px;">
      <div class="shell tool-layout">
        <div class="compare-column">
          <h3>Guest post</h3>
          <div class="field"><label for="cmp-gp-place">Placement fee ($)</label><input id="cmp-gp-place" type="number" min="0" placeholder="e.g. 150" /></div>
          <div class="field"><label for="cmp-gp-write">Writing fee ($, 0 if you supply the article)</label><input id="cmp-gp-write" type="number" min="0" placeholder="e.g. 60" /></div>
          <div class="field" style="margin-bottom:0;"><label for="cmp-gp-extra">Any other fees ($)</label><input id="cmp-gp-extra" type="number" min="0" placeholder="e.g. 0" /></div>
        </div>
        <div class="compare-column">
          <h3>Link insertion</h3>
          <div class="field"><label for="cmp-li-place">Placement fee ($)</label><input id="cmp-li-place" type="number" min="0" placeholder="e.g. 180" /></div>
          <div class="field"><label for="cmp-li-edit">Editorial update fee ($, if separate)</label><input id="cmp-li-edit" type="number" min="0" placeholder="e.g. 0" /></div>
          <div class="field" style="margin-bottom:0;"><label for="cmp-li-extra">Any other fees ($)</label><input id="cmp-li-extra" type="number" min="0" placeholder="e.g. 0" /></div>
        </div>
      </div>
    </section>

    <section class="homev3-section" style="padding-top: 0;">
      <div class="shell">
        <div class="tool-result-v3 result-row-v3" data-reveal>
          <div class="result-cell"><span class="kicker">Guest post total</span><div class="result-figure" id="cmp-gp-total">$0</div></div>
          <div class="result-cell"><span class="kicker">Link insertion total</span><div class="result-figure" id="cmp-li-total">$0</div></div>
          <div class="result-cell highlight"><span class="kicker">Difference</span><div class="result-figure accent" id="cmp-diff">$0</div><p id="cmp-verdict" class="form-note" style="margin-bottom:0;">Enter both sides to compare.</p></div>
        </div>
        <div class="cmp-bars" id="cmp-bars" style="display:none;">
          <div class="cmp-bar-row"><label>Guest post</label><div class="cmp-bar-track"><div class="cmp-bar-fill gp" id="cmp-bar-gp"></div></div><span id="cmp-bar-gp-val">$0</span></div>
          <div class="cmp-bar-row"><label>Link insertion</label><div class="cmp-bar-track"><div class="cmp-bar-fill li" id="cmp-bar-li"></div></div><span id="cmp-bar-li-val">$0</span></div>
        </div>
      </div>
    </section>

    <section class="cta-block">
      <div class="shell cta-card" data-reveal>
        <div class="eyebrow"><span class="eyebrow-dot"></span> Not sure which fits your page?</div>
        <h2>Send your target URL and we'll advise.</h2>
        <a class="button" href="/order">Get placement options <span>&#8599;</span></a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .tool-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .compare-column { padding: 26px; border-radius: 16px; background: #fff; box-shadow: 0 10px 30px rgba(23,26,34,.06); }
  .compare-column h3 { margin-bottom: 18px; }
  .result-row-v3 { display: grid; grid-template-columns: 1fr 1fr 1.4fr; gap: 24px; }
  .result-cell { text-align: center; }
  .result-cell .kicker { display: block; margin-bottom: 4px; }
  .result-figure { transition: transform .18s ease; }
  .result-figure.pop { transform: scale(1.08); }
  .cmp-bars { display: grid; gap: 14px; margin-top: 26px; }
  .cmp-bar-row { display: grid; grid-template-columns: 100px 1fr 70px; align-items: center; gap: 12px; }
  .cmp-bar-row label { color: var(--muted); font-size: 12.5px; font-weight: 600; }
  .cmp-bar-track { overflow: hidden; height: 10px; border-radius: 999px; background: rgba(23,26,34,.06); }
  .cmp-bar-fill { height: 100%; border-radius: 999px; width: 0%; transition: width .3s ease; }
  .cmp-bar-fill.gp { background: #60a5fa; }
  .cmp-bar-fill.li { background: #34d399; }
  .cmp-bar-row span { text-align: right; font-size: 12.5px; font-weight: 700; }
  @media (max-width: 900px) { .tool-layout, .result-row-v3 { grid-template-columns: 1fr; } }
</style>

<script>
  const ids = ['cmp-gp-place', 'cmp-gp-write', 'cmp-gp-extra', 'cmp-li-place', 'cmp-li-edit', 'cmp-li-extra'];
  const inputs = Object.fromEntries(ids.map((id) => [id, document.getElementById(id) as HTMLInputElement]));
  const gpTotalEl = document.getElementById('cmp-gp-total')!;
  const liTotalEl = document.getElementById('cmp-li-total')!;
  const diffEl = document.getElementById('cmp-diff')!;
  const verdictEl = document.getElementById('cmp-verdict')!;
  const barsWrap = document.getElementById('cmp-bars')!;
  const barGp = document.getElementById('cmp-bar-gp')!;
  const barLi = document.getElementById('cmp-bar-li')!;
  const barGpVal = document.getElementById('cmp-bar-gp-val')!;
  const barLiVal = document.getElementById('cmp-bar-li-val')!;

  function pop(el: HTMLElement) {
    el.classList.remove('pop');
    void el.offsetWidth;
    el.classList.add('pop');
    setTimeout(() => el.classList.remove('pop'), 200);
  }

  function num(id: string) {
    return Number(inputs[id].value) || 0;
  }

  function update() {
    const gpTotal = num('cmp-gp-place') + num('cmp-gp-write') + num('cmp-gp-extra');
    const liTotal = num('cmp-li-place') + num('cmp-li-edit') + num('cmp-li-extra');
    const gpText = `$${gpTotal.toLocaleString()}`;
    const liText = `$${liTotal.toLocaleString()}`;
    if (gpTextChanged(gpText)) pop(gpTotalEl);
    if (liTextChanged(liText)) pop(liTotalEl);
    gpTotalEl.textContent = gpText;
    liTotalEl.textContent = liText;

    function gpTextChanged(next: string) { return gpTotalEl.textContent !== next; }
    function liTextChanged(next: string) { return liTotalEl.textContent !== next; }

    const anyEntered = ids.some((id) => inputs[id].value !== '');
    if (!anyEntered) {
      diffEl.textContent = '$0';
      verdictEl.textContent = 'Enter both sides to compare.';
      barsWrap.style.display = 'none';
      return;
    }

    const diff = Math.abs(gpTotal - liTotal);
    const diffText = `$${diff.toLocaleString()}`;
    if (diffEl.textContent !== diffText) pop(diffEl);
    diffEl.textContent = diffText;
    const pctDiff = Math.max(gpTotal, liTotal) > 0 ? Math.round((diff / Math.max(gpTotal, liTotal, 1)) * 100) : 0;
    if (gpTotal === liTotal) {
      verdictEl.textContent = 'Both options cost the same — base the choice on content fit, not price.';
    } else if (gpTotal < liTotal) {
      verdictEl.textContent = `The guest post is $${diff.toLocaleString()} (${pctDiff}%) cheaper here.`;
    } else {
      verdictEl.textContent = `The link insertion is $${diff.toLocaleString()} (${pctDiff}%) cheaper here.`;
    }

    barsWrap.style.display = 'grid';
    const maxTotal = Math.max(gpTotal, liTotal, 1);
    barGp.style.width = `${(gpTotal / maxTotal) * 100}%`;
    barLi.style.width = `${(liTotal / maxTotal) * 100}%`;
    barGpVal.textContent = gpText;
    barLiVal.textContent = liText;
  }

  ids.forEach((id) => inputs[id].addEventListener('input', update));
  update();
</script>
