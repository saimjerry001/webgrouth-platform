import BaseLayout from '../layouts/BaseLayout.astro';
const services=[['Technical clarity','Make it easier for search engines and people to understand, crawl, and use your site.'],['Content strategy','Find the useful questions your audience is already asking and build a system around them.'],['Authority building','Earn relevant mentions through guest posting, outreach, and content worth referencing.'],['Measurement','Focus on meaningful movement: qualified traffic, visibility, and the actions that follow.']];
