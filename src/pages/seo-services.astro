---
import BaseLayout from '../layouts/BaseLayout.astro';
const services = [
  ['Off-page campaign planning', 'Turn target pages, competitor context and growth priorities into a focused authority-building roadmap.'],
  ['Backlink profile support', 'Balance relevance, link types, destinations and anchors to support a healthier acquisition pattern.'],
  ['SEO content production', 'Create useful, publication-ready articles and assets that make outreach and placements easier to earn.'],
  ['Campaign reporting', 'Keep placements, live URLs, anchors, target pages and status organised in one clear operating record.'],
];
---
<BaseLayout title="Off-page SEO & Link Building Services | Web Grouth" description="Human-led off-page SEO, content and authority-building campaigns shaped around your business priorities.">
  <section class="page-hero"><div class="shell page-hero-grid"><div class="page-hero-copy" data-reveal><div class="breadcrumbs"><a href="/">Home</a><span>/</span><span>SEO Services</span></div><div class="eyebrow"><span class="eyebrow-dot"></span> Beyond individual links</div><h1>Off-page SEO with a <span class="gradient-text">clear direction.</span></h1><p>Connect content, outreach and placements in one practical campaign—designed around the pages and markets that matter to your business.</p><div class="hero-actions"><a class="button button-primary" href="/contact">Discuss your SEO goals <span>↗</span></a></div></div><aside class="page-hero-aside" data-reveal data-reveal-delay="1"><span>Campaign building blocks</span><ul><li><span>Strategy</span>Targets + priorities</li><li><span>Authority</span>Relevant mentions</li><li><span>Content</span>Editorial support</li><li><span>Visibility</span>Clear reporting</li></ul></aside></div></section>
  <section class="section"><div class="shell content-grid"><div class="content-sticky" data-reveal><span class="kicker">Connected execution</span><h2>Better links begin with better decisions.</h2><p>We help organise the off-page work around a real business goal instead of chasing disconnected metrics.</p></div><div class="content-stack">{services.map(([title,text],i)=><article class="detail-card" data-reveal data-reveal-delay={String(i%3)}><div class="detail-card-head"><span class="detail-card-icon">{String(i+1).padStart(2,'0')}</span><div><h3>{title}</h3><p>{text}</p></div></div></article>)}</div></div></section>
  <section class="section section-soft"><div class="shell trust-panel" data-reveal><div class="trust-panel-inner"><div><span class="kicker">What we optimise for</span><h2>Useful authority, not a prettier spreadsheet.</h2></div><div class="trust-copy"><p>Metrics support decisions, but they do not replace them. Our work considers relevance, traffic quality, page fit, anchor context and campaign diversity together.</p><div class="tag-row"><span class="tag">Relevance</span><span class="tag">Organic visibility</span><span class="tag">Anchor context</span><span class="tag">Publisher quality</span><span class="tag">Clear records</span></div></div></div></div></section>
  <section class="cta-block"><div class="shell cta-card" data-reveal><div class="eyebrow"><span class="eyebrow-dot"></span> Build the roadmap</div><h2>Turn your targets into an authority plan.</h2><p>Share the pages you want to grow and the markets you care about. We’ll help define a practical next move.</p><a class="button" href="/contact">Plan your campaign <span>↗</span></a></div></section>
</BaseLayout>
