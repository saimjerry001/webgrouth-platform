<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Web Grouth – Guest Posting & SEO Agency</title>
  <!-- Font Awesome for icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
  <!-- Google Fonts (Inter) -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet" />
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: #0b1120;
      color: #e2e8f0;
      line-height: 1.6;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 20px;
    }

    /* ----- Buttons ----- */
    .btn {
      display: inline-block;
      padding: 14px 32px;
      border-radius: 50px;
      font-weight: 600;
      text-decoration: none;
      transition: 0.3s ease;
      border: none;
      cursor: pointer;
      font-size: 1rem;
    }

    .btn-primary {
      background: linear-gradient(135deg, #f59e0b, #d97706);
      color: #0b1120;
      box-shadow: 0 8px 20px rgba(245, 158, 11, 0.3);
    }
    .btn-primary:hover {
      transform: translateY(-3px);
      box-shadow: 0 12px 28px rgba(245, 158, 11, 0.5);
    }

    .btn-secondary {
      background: transparent;
      color: #e2e8f0;
      border: 2px solid #334155;
    }
    .btn-secondary:hover {
      border-color: #f59e0b;
      color: #f59e0b;
      transform: translateY(-3px);
    }

    .btn-whatsapp {
      background: #25d366;
      color: #0b1120;
    }
    .btn-whatsapp:hover {
      background: #1ebe5c;
      transform: translateY(-3px);
      box-shadow: 0 8px 20px rgba(37, 211, 102, 0.4);
    }

    /* ----- Hero ----- */
    .hero {
      padding: 80px 0 60px;
      background: radial-gradient(ellipse at 20% 50%, #1e293b 0%, #0b1120 70%);
      position: relative;
      overflow: hidden;
    }
    .hero::after {
      content: '';
      position: absolute;
      top: -30%;
      right: -10%;
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, rgba(245, 158, 11, 0.08), transparent 70%);
      border-radius: 50%;
      pointer-events: none;
    }
    .hero-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      align-items: center;
      position: relative;
      z-index: 2;
    }
    .hero-content h1 {
      font-size: 3.5rem;
      font-weight: 800;
      line-height: 1.1;
      margin: 16px 0 20px;
      background: linear-gradient(to right, #fbbf24, #f59e0b);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .hero-content p {
      font-size: 1.2rem;
      color: #94a3b8;
      max-width: 500px;
      margin-bottom: 32px;
    }
    .hero-badges {
      display: flex;
      flex-wrap: wrap;
      gap: 30px;
      margin-top: 30px;
      font-size: 0.9rem;
      color: #94a3b8;
    }
    .hero-badges i {
      color: #f59e0b;
      margin-right: 8px;
    }
    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      margin-top: 10px;
    }
    .hero-image {
      display: flex;
      justify-content: center;
      align-items: center;
    }
    .hero-image img {
      max-width: 100%;
      border-radius: 20px;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.8);
      border: 1px solid #1e293b;
    }
    .hero-image .badge-float {
      position: relative;
      margin-top: -40px;
      margin-left: -20px;
      background: #1e293b;
      padding: 12px 20px;
      border-radius: 60px;
      display: inline-flex;
      align-items: center;
      gap: 12px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.5);
      border: 1px solid #334155;
      backdrop-filter: blur(4px);
    }
    .badge-float .dot {
      width: 12px;
      height: 12px;
      background: #22c55e;
      border-radius: 50%;
      animation: pulse-dot 1.5s infinite;
    }
    @keyframes pulse-dot {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.5; transform: scale(1.3); }
    }

    /* ----- Trust Bar ----- */
    .trust-bar {
      background: #111b2e;
      border-top: 1px solid #1e293b;
      border-bottom: 1px solid #1e293b;
      padding: 24px 0;
    }
    .trust-grid {
      display: flex;
      justify-content: space-around;
      flex-wrap: wrap;
      gap: 20px;
      text-align: center;
    }
    .trust-item {
      display: flex;
      align-items: center;
      gap: 10px;
      font-weight: 600;
    }
    .trust-item i {
      color: #f59e0b;
      font-size: 1.4rem;
    }
    .trust-item span {
      color: #94a3b8;
      font-weight: 400;
    }

    /* ----- Section Headers ----- */
    .section-header {
      text-align: center;
      margin-bottom: 50px;
    }
    .section-header h2 {
      font-size: 2.6rem;
      font-weight: 700;
      margin-bottom: 12px;
    }
    .section-header h2 span {
      background: linear-gradient(135deg, #fbbf24, #f59e0b);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .section-header p {
      color: #94a3b8;
      max-width: 600px;
      margin: 0 auto;
      font-size: 1.1rem;
    }

    /* ----- Cards (Services) ----- */
    .card-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
      gap: 30px;
    }
    .service-card {
      background: #151f33;
      border-radius: 20px;
      padding: 32px 24px;
      border: 1px solid #1e293b;
      transition: 0.3s ease;
      text-align: center;
    }
    .service-card:hover {
      transform: translateY(-8px);
      border-color: #f59e0b;
      box-shadow: 0 20px 40px -12px rgba(0,0,0,0.6);
    }
    .service-card i {
      font-size: 2.8rem;
      color: #f59e0b;
      margin-bottom: 16px;
    }
    .service-card h3 {
      font-size: 1.4rem;
      margin-bottom: 12px;
    }
    .service-card p {
      color: #94a3b8;
      font-size: 0.95rem;
    }

    /* ----- Pricing / Packages ----- */
    .pricing-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 30px;
      margin-top: 20px;
    }
    .pricing-card {
      background: #151f33;
      border-radius: 24px;
      padding: 40px 28px;
      border: 1px solid #1e293b;
      transition: 0.3s ease;
      position: relative;
      display: flex;
      flex-direction: column;
    }
    .pricing-card.popular {
      border-color: #f59e0b;
      box-shadow: 0 0 0 1px #f59e0b, 0 20px 40px -12px rgba(245, 158, 11, 0.2);
    }
    .pricing-card.popular::before {
      content: 'Most Popular';
      position: absolute;
      top: -12px;
      left: 50%;
      transform: translateX(-50%);
      background: #f59e0b;
      color: #0b1120;
      padding: 4px 16px;
      border-radius: 30px;
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
    }
    .pricing-card:hover {
      transform: translateY(-6px);
    }
    .pricing-card .price {
      font-size: 2.8rem;
      font-weight: 700;
      margin: 10px 0 4px;
      color: #fbbf24;
    }
    .pricing-card .price span {
      font-size: 1rem;
      color: #94a3b8;
      font-weight: 400;
    }
    .pricing-card ul {
      list-style: none;
      margin: 24px 0 32px;
      flex: 1;
    }
    .pricing-card ul li {
      padding: 8px 0;
      border-bottom: 1px solid #1e293b;
      display: flex;
      align-items: center;
      gap: 10px;
      color: #cbd5e1;
    }
    .pricing-card ul li i {
      color: #22c55e;
      width: 20px;
    }
    .pricing-card .btn {
      width: 100%;
      text-align: center;
    }

    /* ----- Testimonials ----- */
    .testimonials {
      background: #111b2e;
      padding: 60px 0;
      margin: 40px 0;
      border-top: 1px solid #1e293b;
      border-bottom: 1px solid #1e293b;
    }
    .testimonial-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 30px;
    }
    .testimonial-card {
      background: #151f33;
      border-radius: 16px;
      padding: 28px;
      border: 1px solid #1e293b;
      transition: 0.2s;
    }
    .testimonial-card:hover {
      border-color: #f59e0b;
    }
    .testimonial-card .stars {
      color: #f59e0b;
      letter-spacing: 2px;
      margin-bottom: 10px;
    }
    .testimonial-card blockquote {
      font-size: 1rem;
      color: #e2e8f0;
      margin: 12px 0;
      font-style: italic;
    }
    .testimonial-card .author {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-top: 16px;
    }
    .testimonial-card .author img {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      object-fit: cover;
      background: #334155;
    }
    .testimonial-card .author .name {
      font-weight: 600;
    }
    .testimonial-card .author .role {
      font-size: 0.8rem;
      color: #94a3b8;
    }

    /* ----- Final CTA ----- */
    .cta-section {
      text-align: center;
      padding: 60px 0 80px;
    }
    .cta-section h2 {
      font-size: 2.6rem;
      margin-bottom: 16px;
    }
    .cta-section p {
      color: #94a3b8;
      max-width: 500px;
      margin: 0 auto 30px;
    }
    .cta-section .btn-group {
      display: flex;
      gap: 16px;
      justify-content: center;
      flex-wrap: wrap;
    }

    /* Responsive */
    @media (max-width: 900px) {
      .hero-grid {
        grid-template-columns: 1fr;
        text-align: center;
      }
      .hero-content p {
        margin-left: auto;
        margin-right: auto;
      }
      .hero-actions {
        justify-content: center;
      }
      .hero-badges {
        justify-content: center;
      }
      .hero-image .badge-float {
        margin: 0 auto;
      }
    }
    @media (max-width: 600px) {
      .hero-content h1 {
        font-size: 2.5rem;
      }
      .section-header h2 {
        font-size: 2rem;
      }
      .pricing-card .price {
        font-size: 2.2rem;
      }
    }

    /* Animations */
    .fade-up {
      opacity: 0;
      transform: translateY(30px);
      animation: fadeUp 0.8s forwards;
    }
    @keyframes fadeUp {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .delay-1 { animation-delay: 0.1s; }
    .delay-2 { animation-delay: 0.2s; }
    .delay-3 { animation-delay: 0.3s; }
    .delay-4 { animation-delay: 0.4s; }
  </style>
</head>
