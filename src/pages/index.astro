<!DOCTYPE html>
<html lang="ur">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Web Grouth – Guest Posting, SEO & High-Authority Backlinks</title>
  <meta name="description" content="Web Grouth helps brands earn relevant guest posts and contextual backlinks through vetted publishers. Order guest posts, link building, and SEO — built for relevance, not volume." />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700;14..32,800;14..32,900&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet" />
  <style is:inline>
    * { margin:0; padding:0; box-sizing:border-box; }
    html { scroll-behavior:smooth; }
    body {
      font-family:'Inter',sans-serif;
      background:#ffffff;
      color:#0f172a;
      line-height:1.65;
      overflow-x:hidden;
    }
    .container { max-width:1200px; margin:0 auto; padding:0 24px; }
    a { text-decoration:none; color:inherit; }
    h1,h2,h3,h4 { font-family:'Space Grotesk',sans-serif; letter-spacing:-0.02em; }
    ::selection { background:#2563eb; color:#fff; }

    /* ===== SCROLL REVEAL ===== */
    .reveal { opacity:0; transform:translateY(24px); transition:opacity .7s ease, transform .7s ease; }
    .reveal.show { opacity:1; transform:none; }

    /* ===== HEADER ===== */
    .header {
      position:fixed; top:0; left:0; width:100%; z-index:1000;
      background:rgba(255,255,255,.78); backdrop-filter:blur(16px); -webkit-backdrop-filter:blur(16px);
      border-bottom:1px solid rgba(15,23,42,.06);
      padding:14px 0; transition:.3s;
    }
    .header-inner { display:flex; justify-content:space-between; align-items:center; }
    .logo { display:flex; align-items:center; gap:10px; font-size:1.55rem; font-weight:800; letter-spacing:-0.03em; color:#0f172a; }
    
    /* === NEXT LEVEL ANIMATED LOGO === */
    .logo-mark {
      width:38px; height:38px; border-radius:11px;
      background:linear-gradient(135deg,#2563eb,#1d4ed8);
      display:flex; align-items:center; justify-content:center;
      box-shadow:0 6px 16px rgba(37,99,235,.35);
      flex-shrink:0;
      position:relative;
      overflow:hidden;
    }
    .logo-mark svg {
      width:22px; height:22px;
      animation:logoFloat 3s ease-in-out infinite;
    }
    @keyframes logoFloat {
      0%, 100% { transform: translateY(0) rotate(0deg); }
      50% { transform: translateY(-3px) rotate(4deg); }
    }
    .logo-mark::before {
      content: '';
      position: absolute;
      top: -50%; left: -50%;
      width: 200%; height: 200%;
      background: linear-gradient(45deg, transparent, rgba(255,255,255,0.2), transparent);
      transform: rotate(45deg);
      animation: logoShine 4s infinite linear;
    }
    @keyframes logoShine {
      0% { left: -100%; }
      50% { left: 100%; }
      100% { left: 100%; }
    }
    
    .logo span { background:linear-gradient(135deg,#2563eb,#1d4ed8); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }
    .nav-links { display:flex; align-items:center; gap:32px; }
    .nav-links a:not(.btn-nav) { font-weight:500; color:#334155; transition:.2s; font-size:.95rem; position:relative; }
    .nav-links a:not(.btn-nav):hover { color:#2563eb; }
    .nav-links .btn-nav {
      background:#2563eb; color:#fff !important; padding:11px 28px; border-radius:40px; font-weight:700;
      transition:.3s; box-shadow:0 6px 18px rgba(37,99,235,.25);
    }
    .nav-links .btn-nav:hover { background:#1d4ed8; transform:translateY(-2px); box-shadow:0 10px 26px rgba(37,99,235,.38); }
    .hamburger { display:none; flex-direction:column; gap:5px; cursor:pointer; padding:6px; }
    .hamburger span { width:26px; height:3px; background:#0f172a; border-radius:3px; transition:.3s; }

    /* ===== BUTTONS ===== */
    .btn {
      display:inline-flex; align-items:center; justify-content:center; gap:10px;
      padding:17px 34px; border-radius:60px; font-weight:700; font-size:1rem;
      transition:.3s cubic-bezier(.2,.8,.2,1); border:none; cursor:pointer; text-align:center;
      position:relative; overflow:hidden;
    }
    .btn-primary { background:#2563eb; color:#fff; box-shadow:0 10px 28px rgba(37,99,235,.28); }
    .btn-primary:hover { background:#1d4ed8; transform:translateY(-4px); box-shadow:0 18px 36px rgba(37,99,235,.4); }
    .btn-primary:active { transform:translateY(-1px); }
    .btn-secondary { background:transparent; color:#0f172a; border:2px solid #e2e8f0; }
    .btn-secondary:hover { border-color:#2563eb; color:#2563eb; transform:translateY(-4px); }
    .btn-whatsapp { background:#25d366; color:#fff; box-shadow:0 10px 28px rgba(37,211,102,.28); }
    .btn-whatsapp:hover { background:#1ebe5c; transform:translateY(-4px); box-shadow:0 18px 36px rgba(37,211,102,.4); }
    .btn-block { width:100%; }
    .pulse-ring {
      position:absolute; inset:0; border-radius:60px; border:2px solid rgba(255,255,255,.6);
      animation:pulseRing 2.2s infinite;
    }
    @keyframes pulseRing { 0%{ transform:scale(1); opacity:.8; } 100%{ transform:scale(1.15); opacity:0; } }

    /* ===== HERO ===== */
    .hero { padding:150px 0 90px; background:linear-gradient(165deg,#f0f7ff 0%,#ffffff 55%); position:relative; }
    .hero::before {
      content:''; position:absolute; top:-120px; right:-160px; width:520px; height:520px; border-radius:50%;
      background:radial-gradient(circle,rgba(37,99,235,.10),transparent 70%); pointer-events:none;
    }
    .hero-grid { display:grid; grid-template-columns:1.05fr .95fr; gap:60px; align-items:center; }
    .hero-content .tag {
      display:inline-flex; align-items:center; gap:9px; background:rgba(37,99,235,.09); color:#2563eb;
      padding:8px 18px; border-radius:40px; font-weight:700; font-size:.85rem; margin-bottom:16px;
      border:1px solid rgba(37,99,235,.15);
    }
    .tag .live-dot { width:7px; height:7px; border-radius:50%; background:#22c55e; box-shadow:0 0 0 3px rgba(34,197,94,.25); }
    .hero-content h1 { font-size:3.7rem; font-weight:800; line-height:1.08; margin:12px 0 22px; }
    .hero-content h1 .highlight { background:linear-gradient(135deg,#2563eb,#1d4ed8); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }
    .hero-content p.subhead { font-size:1.22rem; color:#475569; max-width:540px; margin-bottom:34px; }
    .hero-actions { display:flex; flex-wrap:wrap; gap:16px; margin-bottom:30px; }
    .hero-note { display:flex; align-items:center; gap:10px; color:#64748b; font-size:.92rem; font-weight:500; }
    .hero-note i { color:#22c55e; }

    .hero-image { position:relative; }
    .img-wrap {
      background:#fff; border-radius:32px; padding:12px; box-shadow:0 40px 90px -20px rgba(15,23,42,.16);
      border:1px solid #f1f5f9; max-width:520px; margin-left:auto; position:relative; z-index:2;
    }
    .img-wrap img { border-radius:24px; width:100%; display:block; }
    .floating-badge {
      display:inline-flex; align-items:center; gap:14px; background:#fff; padding:14px 22px; border-radius:20px;
      box-shadow:0 20px 44px rgba(15,23,42,.14); border:1px solid #f1f5f9;
      position:absolute; z-index:3; animation:floatUpDown 4.5s ease-in-out infinite;
    }
    .floating-badge.b1 { bottom:-22px; left:-10px; }
    .floating-badge.b2 { top:-18px; right:6px; animation-delay:.6s; }
    .floating-badge .dot { width:11px; height:11px; background:#22c55e; border-radius:50%; animation:pulseDot 1.8s infinite; flex-shrink:0; }
    .floating-badge strong { display:block; font-size:.92rem; }
    .floating-badge span.sub { color:#64748b; font-size:.8rem; }
    @keyframes pulseDot { 0%,100%{opacity:1;transform:scale(1);} 50%{opacity:.4;transform:scale(1.5);} }
    @keyframes floatUpDown { 0%,100%{transform:translateY(0);} 50%{transform:translateY(-10px);} }

    /* ===== TRUST BAR w/ COUNTERS ===== */
    .trust-bar { background:#0f172a; padding:34px 0; }
    .trust-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:20px; text-align:center; }
    .trust-item { color:#fff; }
    .trust-item .num { font-family:'Space Grotesk',sans-serif; font-size:2.1rem; font-weight:700; color:#60a5fa; }
    .trust-item .label { color:#94a3b8; font-size:.88rem; font-weight:500; margin-top:2px; }

    /* ===== SECTION HEADERS ===== */
    .section-header { text-align:center; margin-bottom:54px; }
    .section-header .eyebrow {
      display:inline-block; color:#2563eb; font-weight:700; font-size:.82rem; letter-spacing:.08em;
      text-transform:uppercase; margin-bottom:12px;
    }
    .section-header h2 { font-size:2.7rem; font-weight:700; letter-spacing:-.02em; }
    .section-header h2 .highlight { background:linear-gradient(135deg,#2563eb,#1d4ed8); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }
    .section-header p { color:#64748b; max-width:600px; margin:14px auto 0; font-size:1.1rem; }

    /* ===== SERVICE CARDS ===== */
    .card-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(270px,1fr)); gap:28px; }
    .service-card {
      background:#fff; border-radius:26px; padding:38px 30px; border:1px solid #f1f5f9; transition:.4s;
      box-shadow:0 4px 16px rgba(15,23,42,.03); position:relative; overflow:hidden;
    }
    .service-card::after {
      content:''; position:absolute; inset:0; opacity:0; transition:.4s;
      background:linear-gradient(160deg,rgba(37,99,235,.05),transparent 60%);
    }
    .service-card:hover { transform:translateY(-8px); border-color:#2563eb; box-shadow:0 26px 50px -18px rgba(37,99,235,.2); }
    .service-card:hover::after { opacity:1; }
    .service-icon {
      width:60px; height:60px; border-radius:16px; display:flex; align-items:center; justify-content:center;
      background:linear-gradient(135deg,#eff6ff,#dbeafe); color:#2563eb; font-size:1.6rem; margin-bottom:22px;
      transition:.4s;
    }
    .service-card:hover .service-icon { background:linear-gradient(135deg,#2563eb,#1d4ed8); color:#fff; transform:scale(1.08) rotate(-4deg); }
    .service-card h3 { font-size:1.4rem; margin-bottom:12px; }
    .service-card p { color:#64748b; margin-bottom:18px; }
    .service-card .learn-more { font-weight:700; color:#2563eb; font-size:.92rem; display:inline-flex; align-items:center; gap:6px; }
    .service-card .learn-more i { transition:.3s; }
    .service-card:hover .learn-more i { transform:translateX(4px); }

    /* ===== NEXT-LEVEL CAROUSEL REVIEWS ===== */
    .reviews-section { background:#f8fafc; padding:100px 0; border-top:1px solid #f1f5f9; border-bottom:1px solid #f1f5f9; overflow:hidden; }
    .reviews-slider-container {
      position:relative;
      max-width:1100px;
      margin:0 auto;
      padding:20px 0 40px;
    }
    .reviews-viewport {
      overflow:visible; /* allows scaling-out space */
      padding:20px 0;
    }
    .reviews-track {
      display:flex;
      gap:30px;
      transition:transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
      will-change:transform;
    }
    .review-card {
      min-width:100%; /* Default mobile fallback */
      background:#ffffff;
      border:1.5px solid #e2e8f0;
      border-radius:28px;
      padding:45px 35px;
      box-shadow:0 8px 30px rgba(15,23,42,.03);
      transition:all 0.6s cubic-bezier(0.25, 1, 0.5, 1);
      opacity:0.45;
      transform:scale(0.9);
      text-align:center;
      position:relative;
      cursor:pointer;
    }
    @media (min-width: 768px) {
      .review-card {
        min-width: calc(33.333% - 20px); /* 3 cards visible concurrently on desktop */
      }
    }
    /* Active highlighted card raised above others */
    .review-card.active {
      opacity:1;
      transform:scale(1.06) translateY(-14px);
      border-color:#2563eb;
      box-shadow:0 24px 50px -15px rgba(37,99,235,.2);
      z-index:10;
    }
    .review-avatar-container {
      position:relative;
      width:84px;
      height:84px;
      margin:0 auto 18px;
    }
    .review-avatar {
      width:100%;
      height:100%;
      border-radius:50%;
      object-fit:cover;
      border:4px solid #fff;
      box-shadow:0 8px 24px rgba(37,99,235,.15);
      transition:transform 0.4s ease;
    }
    .review-card.active .review-avatar {
      transform:scale(1.08);
      border-color:#2563eb;
    }
    .review-stars {
      color:#fbbf24;
      font-size:1.15rem;
      letter-spacing:2px;
      margin-bottom:16px;
    }
    .review-text {
      color:#475569;
      font-size:1.02rem;
      line-height:1.7;
      margin-bottom:24px;
      font-style:normal;
    }
    .review-author {
      font-family:'Space Grotesk',sans-serif;
      font-weight:700;
      font-size:1.15rem;
      color:#0f172a;
    }
    .review-role {
      color:#94a3b8;
      font-size:.85rem;
      font-weight:600;
      text-transform:uppercase;
      letter-spacing:.05em;
      margin-top:2px;
    }
    
    /* 3 dots layout with dynamic active sizing */
    .slider-dots {
      display:flex;
      justify-content:center;
      align-items:center;
      gap:12px;
      margin-top:40px;
    }
    .dot {
      width:10px;
      height:10px;
      background:#cbd5e1;
      border-radius:50%;
      cursor:pointer;
      transition:all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
    }
    .dot.active {
      width:32px;
      height:10px;
      background:#2563eb;
      border-radius:10px;
    }

    /* ===== PRICING ===== */
    .pricing-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:28px; margin-top:20px; }
    .pricing-card {
      background:#fff; border-radius:30px; padding:42px 32px; border:1px solid #f1f5f9; transition:.35s;
      text-align:left; position:relative; box-shadow:0 4px 16px rgba(15,23,42,.03);
    }
    .pricing-card:hover { transform:translateY(-6px); box-shadow:0 24px 50px -18px rgba(15,23,42,.12); }
    .pricing-card.popular { border:2px solid #2563eb; box-shadow:0 20px 44px -14px rgba(37,99,235,.22); }
    .pricing-card.popular::before {
      content:'Most Popular'; position:absolute; top:-13px; left:50%; transform:translateX(-50%);
      background:linear-gradient(135deg,#2563eb,#1d4ed8); color:#fff; padding:5px 22px; border-radius:40px;
      font-size:.78rem; font-weight:700; box-shadow:0 6px 14px rgba(37,99,235,.35);
    }
    .pricing-card h3 { font-size:1.3rem; margin-bottom:6px; }
    .pricing-card .plan-desc { color:#94a3b8; font-size:.9rem; margin-bottom:16px; }
    .pricing-card .price { font-size:2.8rem; font-weight:800; margin:6px 0; font-family:'Space Grotesk',sans-serif; }
    .pricing-card .price span { font-size:1rem; color:#94a3b8; font-weight:400; }
    .pricing-card ul { list-style:none; margin:22px 0 30px; }
    .pricing-card ul li { padding:11px 0; border-bottom:1px solid #f1f5f9; display:flex; align-items:center; gap:12px; font-size:.95rem; }
    .pricing-card ul li i { color:#22c55e; }
    .pricing-note { text-align:center; color:#94a3b8; font-size:.88rem; margin-top:22px; }

    /* ===== WHY US ===== */
    .why-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:24px; }
    .why-card { text-align:center; padding:10px; }
    .why-icon {
      width:64px; height:64px; border-radius:18px; margin:0 auto 18px; display:flex; align-items:center;
      justify-content:center; background:linear-gradient(135deg,#eff6ff,#dbeafe); color:#2563eb; font-size:1.7rem;
    }
    .why-card h4 { font-size:1.1rem; margin-bottom:8px; }
    .why-card p { color:#64748b; font-size:.92rem; }

    /* ===== CTA ===== */
    .cta-section { padding:20px 0 90px; }
    .cta-box {
      background:linear-gradient(135deg,#0f172a,#1e293b); border-radius:36px; padding:70px 50px; text-align:center;
      position:relative; overflow:hidden;
    }
    .cta-box::before {
      content:''; position:absolute; top:-100px; left:-100px; width:340px; height:340px; border-radius:50%;
      background:radial-gradient(circle,rgba(37,99,235,.35),transparent 70%);
    }
    .cta-box::after {
      content:''; position:absolute; bottom:-120px; right:-80px; width:380px; height:380px; border-radius:50%;
      background:radial-gradient(circle,rgba(37,99,235,.25),transparent 70%);
    }
    .cta-box > * { position:relative; z-index:1; }
    .cta-box h2 { font-size:2.6rem; color:#fff; margin-bottom:16px; }
    .cta-box h2 .highlight { color:#60a5fa; }
    .cta-box p { color:#cbd5e1; max-width:520px; margin:0 auto 34px; font-size:1.1rem; }
    .cta-box .btn-group { display:flex; gap:16px; justify-content:center; flex-wrap:wrap; }

    /* ===== FOOTER ===== */
    .footer { background:#fff; border-top:1px solid #f1f5f9; padding:64px 0 30px; }
    .footer-grid { display:grid; grid-template-columns:2fr 1fr 1fr 1.5fr; gap:40px; margin-bottom:40px; }
    .footer-brand p { color:#64748b; max-width:280px; font-size:.95rem; margin-top:14px; }
    .footer-col h4 { font-size:1rem; font-weight:700; margin-bottom:16px; }
    .footer-col ul { list-style:none; }
    .footer-col ul li { margin-bottom:10px; }
    .footer-col ul li a { color:#64748b; transition:.2s; font-size:.95rem; }
    .footer-col ul li a:hover { color:#2563eb; }
    .footer-col ul li a i { margin-right:8px; color:#94a3b8; }
    .footer-social { display:flex; gap:14px; margin-top:14px; }
    .footer-social a {
      display:inline-flex; align-items:center; justify-content:center; width:42px; height:42px; border-radius:50%;
      background:#f1f5f9; color:#0f172a; transition:.3s;
    }
    .footer-social a:hover { background:#2563eb; color:#fff; transform:translateY(-3px); }
    .footer-bottom { border-top:1px solid #f1f5f9; padding-top:24px; text-align:center; color:#94a3b8; font-size:.9rem; }

    /* ===== WHATSAPP FLOATING BUTTON ===== */
    .wa-float {
      position:fixed; bottom:26px; right:26px; z-index:900; width:62px; height:62px; border-radius:50%;
      background:#25d366; display:flex; align-items:center; justify-content:center; color:#fff; font-size:1.6rem;
      box-shadow:0 10px 30px rgba(37,211,102,.45); transition:.3s;
    }
    .wa-float:hover { transform:scale(1.08); }
    .wa-float .pulse-ring { border-color:rgba(37,211,102,.5); }

    /* ===== RESPONSIVE ===== */
    @media (max-width:992px) {
      .hero-grid { grid-template-columns:1fr; text-align:center; }
      .hero-content p.subhead { margin-left:auto; margin-right:auto; }
      .hero-actions, .hero-note { justify-content:center; }
      .img-wrap { margin:0 auto; }
      .footer-grid { grid-template-columns:1fr 1fr; }
      .why-grid { grid-template-columns:1fr 1fr; }
      .trust-grid { grid-template-columns:1fr 1fr; }
    }
    @media (max-width:768px) {
      .nav-links {
        display:none; flex-direction:column; background:rgba(255,255,255,.98); position:absolute; top:70px; left:0;
        width:100%; padding:30px 24px; gap:20px; border-bottom:1px solid #f1f5f9;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
      }
      .nav-links.open { display:flex; }
      .hamburger { display:flex; }
      .hero-content h1 { font-size:2.5rem; }
      .section-header h2 { font-size:2.1rem; }
      .footer-grid { grid-template-columns:1fr; text-align:center; }
      .footer-brand p { margin:14px auto 0; }
      .footer-social { justify-content:center; }
      .floating-badge { position:static; display:inline-flex; margin-top:14px; animation:none; }
      .review-card {
        padding: 30px 20px;
      }
    }
    @media (max-width:480px) {
      .hero-content h1 { font-size:2.1rem; }
      .pricing-card .price { font-size:2.3rem; }
      .cta-box { padding:50px 26px; }
    }
  </style>
</head>
<body>

  <!-- ===== HEADER ===== -->
  <header class="header" id="header">
    <div class="container header-inner">
      <div class="logo">
        <div class="logo-mark">
          <!-- Animated Modern SVG Growth Icon -->
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="logo-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#ffffff" />
                <stop offset="100%" stop-color="#93c5fd" />
              </linearGradient>
            </defs>
            <path d="M4 20L12 12L16 16L22 8" stroke="url(#logo-grad)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M17 8H22V13" stroke="url(#logo-grad)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
            <circle cx="4" cy="20" r="2.2" fill="#ffffff" />
            <circle cx="12" cy="12" r="2.2" fill="#ffffff" />
            <circle cx="16" cy="16" r="2.2" fill="#ffffff" />
            <circle cx="22" cy="8" r="2.2" fill="#ffffff" />
          </svg>
        </div>
        Web<span>Grouth</span>
      </div>
      <nav class="nav-links" id="navLinks">
        <a href="#services">Services</a>
        <a href="#pricing">Pricing</a>
        <a href="#contact">Contact</a>
        <a href="#contact" class="btn-nav">Get Started</a>
      </nav>
      <div class="hamburger" id="hamburger"><span></span><span></span><span></span></div>
    </div>
  </header>

  <!-- ===== HERO ===== -->
  <section class="hero">
    <div class="container hero-grid">
