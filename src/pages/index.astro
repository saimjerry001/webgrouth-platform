  <script is:inline>
    // ---- real WhatsApp number wired into every CTA on the page ----
    const WA_NUMBER = '923327810261';
    function waLink(msg){ return `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(msg)}`; }
    document.getElementById('waHeroBtn').href = waLink("Hello Web Grouth, I'd like to order a guest post.");
    document.getElementById('waStarterBtn').href = waLink("Hello Web Grouth, I'd like to order the Starter package.");
    document.getElementById('waGrowthBtn').href = waLink("Hello Web Grouth, I'd like to order the Growth package.");
    document.getElementById('waProBtn').href = waLink("Hello Web Grouth, I'd like to discuss the Pro package.");
    document.getElementById('waCtaBtn').href = waLink("Hello Web Grouth, I'd like to talk about guest posting and SEO.");
    document.getElementById('waFooterLink').href = waLink("Hello Web Grouth, I'd like more information.");
    document.getElementById('waFloat').href = waLink("Hello Web Grouth, I have a question.");

    // ---- mobile menu ----
    const hamburger = document.getElementById('hamburger');
    const navLinks = document.getElementById('navLinks');
    hamburger.addEventListener('click', () => navLinks.classList.toggle('open'));
    navLinks.querySelectorAll('a').forEach(a => a.addEventListener('click', () => navLinks.classList.remove('open')));

    // ---- header shadow on scroll ----
    const header = document.getElementById('header');
    window.addEventListener('scroll', () => {
      header.style.boxShadow = window.scrollY > 20 ? '0 4px 30px rgba(0,0,0,.05)' : 'none';
    });

    // ---- scroll reveal ----
    const revealEls = document.querySelectorAll('.reveal');
    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('show'); });
    }, { threshold: 0.15 });
    revealEls.forEach(el => io.observe(el));

    // ---- animated counters ----
    const counters = document.querySelectorAll('.trust-bar .num');
    let countersDone = false;
    function runCounters() {
      if (countersDone) return;
      countersDone = true;
      counters.forEach(el => {
        const target = parseInt(el.dataset.target, 10);
        const suffix = el.dataset.suffix || '';
        if (isNaN(target)) return; // leave "PBN" text untouched
        let current = 0;
        const step = Math.max(1, Math.ceil(target / 40));
        const timer = setInterval(() => {
          current += step;
          if (current >= target) { current = target; clearInterval(timer); }
          el.textContent = current + suffix;
        }, 30);
      });
    }
    const trustBar = document.querySelector('.trust-bar');
    const trustIO = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) runCounters(); });
    }, { threshold: 0.4 });
    if (trustBar) trustIO.observe(trustBar);

    // ---- NEXT-LEVEL REVIEWS CAROUSEL SCRIPT ----
    const track = document.getElementById('reviewsTrack');
    const cards = Array.from(track.children);
    const dots = Array.from(document.getElementById('sliderDots').children);
    let activeIndex = 0;
    let autoPlayTimer;

    function updateSlider() {
      const isMobile = window.innerWidth < 768;
      
      // Toggle card active states
      cards.forEach((card, idx) => {
        card.classList.toggle('active', idx === activeIndex);
      });
      
      // Update indicators (wider active pill)
      dots.forEach((dot, idx) => {
        dot.classList.toggle('active', idx === activeIndex);
      });

      if (isMobile) {
        // Simple horizontal shifting on mobile viewports
        const offset = -activeIndex * 100;
        track.style.transform = `translateX(${offset}%)`;
      } else {
        // Beautiful centered focusing for larger screens
        const cardWidth = cards[0].getBoundingClientRect().width;
        const gap = 30; // Matches style sheet gap
        const containerWidth = document.querySelector('.reviews-slider-container').getBoundingClientRect().width;
        
        const activeCardLeft = activeIndex * (cardWidth + gap);
        const centerOffset = (containerWidth / 2) - (cardWidth / 2);
        const transformValue = centerOffset - activeCardLeft;
        
        track.style.transform = `translateX(${transformValue}px)`;
      }
    }

    function nextSlide() {
      activeIndex = (activeIndex + 1) % cards.length;
      updateSlider();
    }

    function startAutoPlay() {
      stopAutoPlay();
      autoPlayTimer = setInterval(nextSlide, 4500); // Transitions every 4.5s
    }

    function stopAutoPlay() {
      if (autoPlayTimer) clearInterval(autoPlayTimer);
    }

    // Interactivity: Dot clicks
    dots.forEach((dot, idx) => {
      dot.addEventListener('click', () => {
        activeIndex = idx;
        updateSlider();
        startAutoPlay(); // Resets autoplay timer
      });
    });

    // Interactivity: Direct card clicks
    cards.forEach((card, idx) => {
      card.addEventListener('click', () => {
        activeIndex = idx;
        updateSlider();
        startAutoPlay();
      });
    });

    // Pause autoplay when hovering to read
    const sliderContainer = document.querySelector('.reviews-slider-container');
    sliderContainer.addEventListener('mouseenter', stopAutoPlay);
    sliderContainer.addEventListener('mouseleave', startAutoPlay);

    // Dynamic resize handler with simple debounce
    let resizeTimeout;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(updateSlider, 100);
    });

    // Initialize
    updateSlider();
    startAutoPlay();

    // respect reduced motion
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.querySelectorAll('.reveal').forEach(el => el.classList.add('show'));
      stopAutoPlay(); // disable transitions if preferred
    }
  </script>
</body>
