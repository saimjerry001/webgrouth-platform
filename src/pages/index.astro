---
import BaseLayout from '../layouts/BaseLayout.astro';

const networkRows = [
  ['Technology & SaaS', '8,400+'],
  ['Business & Finance', '7,200+'],
  ['Home & Lifestyle', '6,100+'],
  ['Health & Fitness', '5,600+'],
  ['Marketing & Media', '4,800+'],
  ['Other Categories', '17,900+'],
];
const categories = [
  ['Technology', 'Software, AI, apps and digital products'],
  ['Business', 'Startups, leadership, B2B and operations'],
  ['Finance', 'Personal finance, fintech and investing'],
  ['Health', 'Wellness, fitness and medical publications'],
  ['Home', 'Interior, property, DIY and home improvement'],
  ['Lifestyle', 'Fashion, travel, food and everyday living'],
  ['Automotive', 'Cars, transport, EV and mobility websites'],
  ['Education', 'Learning, careers, schools and student resources'],
  ['Marketing', 'SEO, content, social media and advertising'],
  ['News & Media', 'Editorial, local news and general publications'],
  ['Gaming', 'Games, esports, entertainment and technology'],
  ['More niches', 'Legal, pets, sports, environment and more'],
];
const services = [
  { number: '01', title: 'Guest Post Placement', text: 'Choose websites from our network, approve the site and content, then receive your permanent live placement.', points: ['Dofollow links', 'Permanent placement', 'Content available'], href: '/guest-posting' },
  { number: '02', title: 'Link Insertion', text: 'Add your backlink naturally inside an existing relevant article that is already published and indexed.', points: ['Existing articles', 'Relevant context', 'Faster turnaround'], href: '/link-insertion' },
  { number: '03', title: 'Agency & Bulk Orders', text: 'A reliable fulfilment workflow for SEO agencies and resellers managing multiple clients, niches and target pages.', points: ['Reseller pricing', 'Bulk order support', 'Organised reporting'], href: '/contact' },
];
const process = [
  ['Send your requirements', 'Share the niche, target URL, anchor text, preferred metrics and budget.'],
  ['Get a relevant site list', 'We shortlist matching websites from our 50,000+ publisher network.'],
  ['Approve sites & content', 'Nothing moves forward until you are satisfied with the websites and placement terms.'],
  ['Receive live links', 'We publish, verify and send a clear report with every completed placement.'],
];
const trustItems = [
  ['50,000+', 'websites available across major categories'],
  ['5,000+', 'clients and agency partners served'],
  ['Worldwide', 'publisher coverage for global campaigns'],
  ['Human support', 'from requirements to final live report'],
];
const clientPriorities = [
  'Fast communication', 'Relevant websites', 'Clear pricing', 'Permanent links', 'Bulk order support',
  'Real traffic options', 'Dofollow placements', 'Easy reporting', 'Reseller friendly', 'Multiple categories',
  'Content support', 'Quick turnaround', 'Manual site matching', 'Country targeting', 'Metric filters',
  'No hidden steps', 'Single orders', 'Monthly campaigns', 'Direct assistance', 'Long-term partnership',
];
---

<BaseLayout title="Web Grouth | 50,000+ Guest Posting Websites" description="Order guest posts and link insertions from a network of 50,000+ websites across every major category. Built for brands, SEO teams and agencies.">
  <section class="homev3-hero">
    <div class="shell homev3-hero-grid">
      <div class="homev3-hero-copy" data-reveal>
        <p class="homev3-overline">Guest posting for brands, SEO teams and agencies</p>
        <h1><span>50,000+ websites.</span> One reliable guest posting partner.</h1>
        <p class="homev3-lead">Get permanent guest posts and contextual link insertions on relevant websites in almost every category. Share your requirements, approve the sites, and let our team handle the rest.</p>
        <div class="homev3-actions">
          <a class="homev3-button homev3-button-primary" href="https://wa.me/923327810261?text=Hello%20Web%20Grouth%2C%20please%20send%20me%20your%20guest%20posting%20website%20list." target="_blank" rel="noopener">Get the website list <span>↗</span></a>
          <a class="homev3-button homev3-button-secondary" href="/contact">Discuss a campaign</a>
        </div>
        <div class="homev3-assurance"><span><i>✓</i> Permanent placements</span><span><i>✓</i> Dofollow options</span><span><i>✓</i> Single & bulk orders</span></div>
      </div>

      <div class="homev3-network" data-reveal data-reveal-delay="1">
        <div class="homev3-network-top"><div><span class="homev3-live"></span><strong>Web Grouth Publisher Network</strong></div><span>Updated regularly</span></div>
        <div class="homev3-network-summary"><div><span>Available websites</span><strong>50,000+</strong></div><div><span>Categories</span><strong>All major niches</strong></div></div>
        <div class="homev3-network-table">
          <div class="homev3-network-head"><span>Category</span><span>Websites</span><span>Status</span></div>
          {networkRows.map(([category, count]) => <div class="homev3-network-row"><span>{category}</span><strong>{count}</strong><em>Available</em></div>)}
        </div>
        <div class="homev3-network-filters"><span>Filter by DR</span><span>Traffic</span><span>Country</span><span>Budget</span><span>Niche</span></div>
      </div>
    </div>
  </section>

  <section class="homev3-proof"><div class="shell homev3-proof-grid">{trustItems.map(([value, label], index) => <div class="homev3-proof-item" data-reveal data-reveal-delay={String(index)}><strong>{value}</strong><span>{label}</span></div>)}</div></section>

  <section class="homev3-section homev3-intro">
    <div class="shell homev3-intro-grid">
      <div class="homev3-section-title" data-reveal><p class="homev3-overline">A guest posting service built for real campaigns</p><h2>Stop searching through random lists. Get websites that match the brief.</h2></div>
      <div class="homev3-intro-copy" data-reveal data-reveal-delay="1"><p>Web Grouth helps you find and publish on websites that fit your niche, budget and SEO requirements. Our team checks the important details before you order—so you can spend less time chasing publishers and more time growing client results.</p><div class="homev3-checks"><span>Category and country matching</span><span>DR, traffic and budget filters</span><span>Link type and placement terms confirmed</span><span>Content writing available when needed</span></div></div>
    </div>
  </section>

  <section class="homev3-section homev3-services-section">
    <div class="shell">
      <div class="homev3-heading-row" data-reveal><div><p class="homev3-overline">Services</p><h2>Everything you need to place the right backlink.</h2></div><a href="/contact">Request custom pricing <span>↗</span></a></div>
      <div class="homev3-service-grid">{services.map((service, index) => <article class="homev3-service-card" data-reveal data-reveal-delay={String(index)}><span class="homev3-service-number">{service.number}</span><h3>{service.title}</h3><p>{service.text}</p><ul>{service.points.map((point) => <li><i>✓</i>{point}</li>)}</ul><a href={service.href}>Learn more <span>↗</span></a></article>)}</div>
    </div>
  </section>

  <section class="homev3-section homev3-categories-section">
    <div class="shell">
      <div class="homev3-section-title homev3-centered" data-reveal><p class="homev3-overline">Every major category covered</p><h2>Your client’s niche is probably already in our network.</h2><p>From specialist B2B publications to high-traffic lifestyle websites, campaigns can be filtered around the audience you need.</p></div>
      <div class="homev3-category-grid">{categories.map(([title, text], index) => <article class="homev3-category" data-reveal data-reveal-delay={String(index % 4)}><span>{String(index + 1).padStart(2, '0')}</span><h3>{title}</h3><p>{text}</p></article>)}</div>
    </div>
  </section>

  <section class="homev3-section homev3-process-section">
    <div class="shell homev3-process-layout">
      <div class="homev3-process-copy" data-reveal><p class="homev3-overline">A simple order process</p><h2>From requirements to live links—without the usual back-and-forth.</h2><p>Whether you need one placement or a bulk monthly campaign, you always know what has been approved, what is in progress and what is live.</p><a class="homev3-button homev3-button-primary" href="/contact">Start your first order <span>↗</span></a></div>
      <div class="homev3-process-list">{process.map(([title, text], index) => <article class="homev3-process-step" data-reveal data-reveal-delay={String(index)}><span>{String(index + 1).padStart(2, '0')}</span><div><h3>{title}</h3><p>{text}</p></div></article>)}</div>
    </div>
  </section>

  <section class="homev3-experience">
    <div class="shell homev3-experience-head" data-reveal><div><p class="homev3-overline">What campaign teams care about</p><h2>A service designed around repeat orders.</h2></div><p>These are the standards we build every Web Grouth campaign around.</p></div>
    <div class="homev3-marquee" aria-label="Web Grouth service standards"><div class="homev3-marquee-track homev3-marquee-left">{[...clientPriorities, ...clientPriorities].map((item) => <div class="homev3-standard-card"><div class="homev3-stars" aria-hidden="true">★★★★★</div><strong>{item}</strong><span>Web Grouth service standard</span></div>)}</div></div>
    <div class="homev3-marquee" aria-hidden="true"><div class="homev3-marquee-track homev3-marquee-right">{[...clientPriorities.slice().reverse(), ...clientPriorities.slice().reverse()].map((item) => <div class="homev3-standard-card"><div class="homev3-stars">★★★★★</div><strong>{item}</strong><span>Built for brands & agencies</span></div>)}</div></div>
    <div class="shell homev3-review-note">The moving cards above describe our service standards, not fabricated customer quotations. Send verified client reviews and we will replace these cards with genuine feedback.</div>
  </section>

  <section class="homev3-final"><div class="shell homev3-final-inner" data-reveal><div><p class="homev3-overline">Ready to see the network?</p><h2>Tell us the niche. We’ll send the right websites.</h2><p>Get a filtered list based on your category, traffic, DR, country and budget requirements.</p></div><div class="homev3-final-actions"><a class="homev3-button homev3-button-white" href="https://wa.me/923327810261?text=Hello%20Web%20Grouth%2C%20please%20send%20me%20a%20filtered%20guest%20posting%20website%20list." target="_blank" rel="noopener">Get website list <span>↗</span></a><a href="mailto:contact@webgrouth.com">contact@webgrouth.com</a></div></div></section>
</BaseLayout>
