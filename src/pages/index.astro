---
import BaseLayout from '../layouts/BaseLayout.astro';
import UiIcon from '../components/UiIcon.astro';

const orderUrl = "/order";
const databaseUrl = "https://wa.me/923327810261?text=Hello%20Web%20Grouth%2C%20please%20unlock%20the%2040%2C000%2B%20website%20database%20for%20me.";

const guarantees = [
  { icon: 'wallet', title: '$0 Advance Payment', text: 'Pay when your link is live & verified' },
  { icon: 'badge', title: 'Indexation Guarantee', text: '30-day index or no charge' },
  { icon: 'database', title: '40,000+ Websites', text: 'Publisher inventory across all niches' },
  { icon: 'refresh', title: '6-Month Replacement', text: 'Free replacement if an eligible link is removed' },
] as const;

const services = [
  { icon: 'wallet', tag: 'Most popular', title: 'Pay-After-Live Offer', text: 'Launch placements without tying up your budget. Review the live URL first, then pay after verification.', points: ['$0 upfront payment', 'Pay only after live URL', 'Fast turnaround time'], cta: 'Start risk-free order' },
  { icon: 'building', tag: 'For agencies', title: 'Bulk Guest Posting', text: 'A scalable fulfilment workflow for multi-client campaigns, repeat orders and monthly link targets.', points: ['Discounted agency rates', 'Dedicated campaign manager', 'Live portal tracking'], cta: 'Discuss bulk pricing' },
  { icon: 'target', tag: 'Quality focused', title: 'Handpicked Niche Outreach', text: 'Manual site selection around your topic, audience and quality thresholds—not a random spreadsheet dump.', points: ['High DR 60+ options', 'Real organic traffic', 'Content included'], cta: 'Build my shortlist' },
] as const;

const databaseRows = [
  { domain: 'tech••••.com', niche: 'Technology', da: 72, dr: 68, traffic: '84.2K', tat: '24–48h' },
  { domain: 'busi••••.co', niche: 'Business', da: 64, dr: 61, traffic: '43.8K', tat: '2–3 days' },
  { domain: 'heal••••.com', niche: 'Health', da: 58, dr: 63, traffic: '128K', tat: '3–4 days' },
  { domain: 'life••••.net', niche: 'Lifestyle', da: 69, dr: 66, traffic: '76.4K', tat: '48–72h' },
  { domain: 'fin••••.org', niche: 'Finance', da: 77, dr: 71, traffic: '215K', tat: '3–5 days' },
] as const;

const marketplaceSites = [
  { domain: 'news.guestpostnow.com', da: 57, dr: 71, traffic: '—' },
  { domain: 'programminginsider.com', da: 59, dr: 72, traffic: '—' },
  { domain: 'blogsandnews.com', da: 57, dr: 37, traffic: '—' },
  { domain: 'storifygo.com', da: 54, dr: 53, traffic: '—' },
  { domain: 'substack.com', da: 92, dr: 92, traffic: '—' },
  { domain: 'livepositively.com', da: 61, dr: 72, traffic: '—' },
  { domain: 'outdoorproject.com', da: 59, dr: 71, traffic: '—' },
  { domain: 'theomnibuzz.com', da: 59, dr: 62, traffic: '—' },
  { domain: 'bignewsnetwork.com', da: 66, dr: 76, traffic: '—' },
  { domain: 'fundly.com', da: 70, dr: 80, traffic: '—' },
] as const;

const reviewPlaceholders = [
  { focus: 'Agency fulfilment', copy: 'Add an approved client quote about campaign communication, turnaround and bulk delivery.' },
  { focus: 'Placement quality', copy: 'Add an approved client quote about niche relevance, traffic quality and live-link verification.' },
  { focus: 'Risk-free ordering', copy: 'Add an approved client quote about the pay-after-live experience and repeat orders.' },
] as const;

const faqs = [
  { q: 'How does the $0 advance payment process work?', a: 'Send your niche, target URL, anchor text and quality requirements. We confirm suitable sites and placement terms, publish the approved order, and request payment only after the live URL has been delivered and verified.' },
  { q: 'Is every order eligible for pay-after-live?', a: 'Eligibility and final terms are confirmed in writing before work begins. Standard approved guest-post placements are designed around the $0-upfront model; unusual publisher requirements will always be disclosed before you approve the site.' },
  { q: 'What happens if the page does not get indexed?', a: 'Eligible orders include a 30-day indexation commitment. If the agreed page is not indexed within that period, the placement is not charged under the confirmed campaign terms.' },
  { q: 'What if a publisher removes my link?', a: 'Eligible placements include a six-month replacement window. If the publisher removes the agreed link during that period, Web Grouth will arrange a replacement under the campaign terms.' },
] as const;
---

<BaseLayout title="Web Grouth | 40,000+ Guest Post Websites — $0 Upfront" description="Scale authority with 40,000+ verified guest posting websites. Pay only after your live link is delivered and verified.">
  <div class="wg-home">
    <section class="hero relative overflow-hidden">
      <div class="hero-grid-bg" aria-hidden="true"></div>
      <div class="hero-orb hero-orb-one" aria-hidden="true"></div>
      <div class="hero-orb hero-orb-two" aria-hidden="true"></div>
      <div class="shell hero-shell">
        <div class="hero-copy" data-reveal>
          <div class="offer-pill"><span></span> Guest posting with zero upfront risk <b>New</b></div>
          <h1>Scale Your Authority with <em>40,000+ Verified Websites</em> — Pay Only After Live Links!</h1>
          <p class="hero-sub">$0 Advance Payment. Instant TAT. High DA/DR Backlinks Built for Real ROI.</p>
          <div class="hero-actions">
            <a class="primary-button" href={orderUrl}>Order Risk-Free — $0 Upfront <UiIcon name="arrow" size={18} /></a>
            <a class="secondary-button" href="#database"><UiIcon name="database" size={18} /> Browse 40,000+ Sites</a>
          </div>
          <div class="micro-proof">
            <span><UiIcon name="check" size={14} /> No card required</span>
            <span><UiIcon name="check" size={14} /> Human-verified delivery</span>
            <span><UiIcon name="check" size={14} /> Single & bulk orders</span>
          </div>
        </div>

        <div class="hero-product" data-reveal data-reveal-delay="1">
          <div class="product-glow"></div>
          <div class="app-window">
            <div class="app-topbar">
              <div class="window-dots"><span></span><span></span><span></span></div>
              <div class="app-title"><UiIcon name="database" size={15} /> Publisher Marketplace</div>
              <div class="live-chip"><span></span> Live</div>
            </div>
            <div class="app-content">
              <aside class="app-sidebar" aria-hidden="true">
                <div class="side-logo">W</div>
                <span class="active"><UiIcon name="database" size={16} /></span>
                <span><UiIcon name="search" size={16} /></span>
                <span><UiIcon name="chart" size={16} /></span>
                <span><UiIcon name="layers" size={16} /></span>
              </aside>
              <div class="app-main">
                <div class="market-feed-heading"><div><small>Live publisher inventory</small><strong>Recently available websites</strong></div><span><i></i> Updating</span></div>
                <div class="market-feed-summary"><div><span>Marketplace inventory</span><strong>40,000+</strong></div><div><span>Metrics shown</span><strong>DA · DR · Traffic</strong></div></div>
                <div class="live-market-table" aria-label="Live marketplace website updates">
                  <div class="live-market-head"><span>Website</span><span>DA</span><span>DR</span><span>Traffic</span></div>
                  <div class="live-market-viewport">
                    <div class="live-market-track">
                      {[...marketplaceSites, ...marketplaceSites].map((site, index) => <div class="live-market-row" aria-hidden={index >= marketplaceSites.length ? 'true' : undefined}>
                        <span class="live-domain"><i class={`feed-icon feed-icon-${(index % 5) + 1}`}>{site.domain.charAt(0).toUpperCase()}</i><b>{site.domain}</b></span>
                        <strong>{site.da}</strong><strong>{site.dr}</strong><em>{site.traffic}</em>
                      </div>)}
                    </div>
                  </div>
                  <div class="market-feed-footer"><span><i></i> Live inventory feed</span><small>New sites move into view automatically</small></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="guarantee-wrap" aria-label="Web Grouth order guarantees">
      <div class="shell guarantee-grid">
        {guarantees.map((item, index) => <a href={`/order?offer=${encodeURIComponent(item.title)}`} data-reveal data-reveal-delay={String(index)} aria-label={`${item.title}: start an order`}><span class="guarantee-icon"><UiIcon name={item.icon} size={22} /></span><div><h2>{item.title}</h2><p>{item.text}</p></div><span class="guarantee-arrow">↗</span></a>)}
      </div>
    </section>

    <section class="section services" id="services">
      <div class="shell">
        <div class="section-heading" data-reveal><div class="eyebrow"><UiIcon name="sparkles" size={14} /> Built for serious link building</div><h2>Choose the workflow that fits your campaign.</h2><p>From a single placement to high-volume agency delivery, every order starts with clear approval and ends with a verified live link.</p></div>
        <div class="service-grid" id="pricing">
          {services.map((service, index) => <a href={`/order?service=${encodeURIComponent(service.title)}`} class:list={['service-card', { featured: index === 0 }]} data-reveal data-reveal-delay={String(index)}>
            <div class="card-top"><span class="card-icon"><UiIcon name={service.icon} size={23} /></span><span class="card-tag">{service.tag}</span></div>
            <h3>{service.title}</h3><p>{service.text}</p>
            <ul>{service.points.map((point) => <li><span><UiIcon name="check" size={13} /></span>{point}</li>)}</ul>
            <span class="card-link">{service.cta} <UiIcon name="arrow" size={17} /></span>
          </a>)}
        </div>
      </div>
    </section>

    <section class="section database-section" id="database">
      <div class="shell">
        <div class="database-heading" data-reveal>
          <div><div class="eyebrow"><UiIcon name="database" size={14} /> Live inventory preview</div><h2>Your link-building marketplace,<br/>without the spreadsheet chaos.</h2></div>
          <a class="primary-button compact" href={databaseUrl} target="_blank" rel="noopener">Unlock Full 40,000+ Database <UiIcon name="external" size={16} /></a>
        </div>
        <div class="database-panel" data-reveal>
          <div class="database-toolbar">
            <div class="database-search"><UiIcon name="search" size={17} /><span>Search publishers...</span></div>
            <div class="toolbar-filters"><button type="button">All niches⌄</button><button type="button">DR 50+⌄</button><button type="button">Traffic 10K+⌄</button></div>
            <span class="result-count">40,000+ results</span>
          </div>
          <div class="table-scroll">
            <table>
              <thead><tr><th>Website</th><th>Niche</th><th>DA</th><th>DR</th><th>Organic traffic</th><th>TAT</th><th></th></tr></thead>
              <tbody>{databaseRows.map((row, index) => <tr>
                <td><div class="domain-cell"><span class={`site-icon icon-${index + 1}`}>{row.niche.charAt(0)}</span><div><strong class="blurred-domain">{row.domain}</strong><small>Demo inventory</small></div></div></td>
                <td><span class="niche-pill">{row.niche}</span></td><td>{row.da}</td><td><b>{row.dr}</b></td><td><span class="traffic-dot"></span>{row.traffic}</td><td>{row.tat}</td>
                <td><a href={databaseUrl} target="_blank" rel="noopener">View site <UiIcon name="chevron" size={14} /></a></td>
              </tr>)}</tbody>
            </table>
          </div>
          <div class="database-footer"><span><UiIcon name="badge" size={15} /> Publisher details are revealed after access approval.</span><a href={databaseUrl} target="_blank" rel="noopener">Request access <UiIcon name="arrow" size={15} /></a></div>
        </div>
      </div>
    </section>

    <section class="section workflow-section">
      <div class="shell workflow-grid">
        <div class="workflow-copy" data-reveal><div class="eyebrow"><UiIcon name="badge" size={14} /> Zero-risk workflow</div><h2>Approve first.<br/>Pay after it’s live.</h2><p>A cleaner ordering model for brands and agencies that need control, transparency and predictable delivery.</p><a class="text-link" href={orderUrl}>Place a risk-free order <UiIcon name="arrow" size={17} /></a></div>
        <div class="timeline" data-reveal data-reveal-delay="1">
          {[['01','Send your brief','Share niche, URL, anchor and target metrics.'],['02','Approve matched sites','Review the shortlist and confirm placement terms.'],['03','We publish & verify','The approved content is published and checked.'],['04','Pay after live link','Receive the live URL first; payment follows.']].map(([num,title,text]) => <article><span>{num}</span><div><h3>{title}</h3><p>{text}</p></div><i><UiIcon name="check" size={14} /></i></article>)}
        </div>
      </div>
    </section>

    <section class="section tools-section" id="tools">
      <div class="shell">
        <div class="section-heading row-heading" data-reveal><div><div class="eyebrow"><UiIcon name="sparkles" size={14} /> Free SEO utilities</div><h2>Useful tools, built into the platform.</h2></div><span class="soon-pill">Rolling out soon</span></div>
        <div class="tool-grid">
          {[['Domain Metrics Snapshot','Check the important SEO metrics before shortlisting a site.','chart'],['Guest Post Cost Planner','Build a fast campaign estimate across niches and volumes.','wallet'],['Link Requirement Builder','Turn your campaign goals into a clean publisher brief.','layers']].map(([title,text,icon], index) => <article data-reveal data-reveal-delay={String(index)}><span><UiIcon name={icon as any} size={20} /></span><div><h3>{title}</h3><p>{text}</p></div><b>Coming soon</b></article>)}
        </div>
      </div>
    </section>

    <section class="section reviews-section">
      <div class="shell">
        <div class="section-heading" data-reveal><div class="eyebrow"><UiIcon name="star" size={14} /> Client feedback</div><h2>Designed for proof—not made-up praise.</h2><p>This section is production-ready for verified reviews. Client names and quotes remain intentionally unpublished until approval is provided.</p></div>
        <div class="review-grid">
          {reviewPlaceholders.map((review, index) => <article data-reveal data-reveal-delay={String(index)}><div class="review-stars" aria-label="Five star review layout">★★★★★</div><blockquote>“{review.copy}”</blockquote><div class="review-author"><span>{String(index + 1).padStart(2,'0')}</span><div><strong>{review.focus}</strong><small>Verified testimonial placeholder</small></div></div></article>)}
        </div>
      </div>
    </section>

    <section class="case-strip" id="case-studies">
      <div class="shell case-inner" data-reveal><div><span>CASE STUDIES</span><h2>Real campaign breakdowns will be published with client approval.</h2></div><a href="/contact">Discuss your campaign <UiIcon name="arrow" size={17} /></a></div>
    </section>

    <section class="section faq-section">
      <div class="shell faq-grid">
        <div class="faq-copy" data-reveal><div class="eyebrow"><UiIcon name="badge" size={14} /> Clear terms, no surprises</div><h2>Questions about paying after delivery?</h2><p>Everything important is confirmed before your order moves forward.</p><a class="secondary-button dark-outline" href="/contact">Ask another question <UiIcon name="arrow" size={17} /></a></div>
        <div class="faq-list" data-reveal data-reveal-delay="1">
          {faqs.map((faq, index) => <details open={index === 0}><summary><span>{faq.q}</span><i>+</i></summary><p>{faq.a}</p></details>)}
        </div>
      </div>
    </section>

    <section class="final-cta">
      <div class="shell final-card" data-reveal><div class="final-grid" aria-hidden="true"></div><div><span><i></i> Ready when you are</span><h2>Get the live link first.<br/>Pay when it’s verified.</h2><p>Send your requirements and get a relevant shortlist from 40,000+ publisher websites.</p></div><div class="final-actions"><a class="white-button" href={orderUrl}>Start $0 Upfront Order <UiIcon name="arrow" size={18} /></a><a href="#database">Explore database</a></div></div>
    </section>
  </div>
</BaseLayout>

<style is:global>
  html { scroll-behavior: smooth; }
  body { background: #050817; }
  .wg-home { --bg:#050817; --surface:#0a1025; --surface-2:#0d1530; --line:rgba(148,163,184,.14); --text:#f7f9ff; --muted:#98a6c5; --blue:#5b7cff; --cyan:#38bdf8; color: var(--text); background: var(--bg); overflow: hidden; }
  .wg-home .shell { width: min(1180px, calc(100% - 40px)); margin-inline: auto; }
  .wg-home h1,.wg-home h2,.wg-home h3,.wg-home p { margin: 0; }
  .wg-home .hero { min-height: auto; padding: 155px 0 80px; border-bottom: 0; isolation: isolate; background: radial-gradient(circle at 50% -20%,#162660 0,rgba(13,20,49,.32) 40%,transparent 68%),#050817; }
  .hero-grid-bg,.final-grid { position:absolute; inset:0; background-image:linear-gradient(rgba(116,140,212,.055) 1px,transparent 1px),linear-gradient(90deg,rgba(116,140,212,.055) 1px,transparent 1px); background-size:48px 48px; mask-image:linear-gradient(to bottom,black,transparent 88%); z-index:-1; }
  .hero-orb { position:absolute; z-index:-1; border-radius:999px; filter:blur(2px); pointer-events:none; }
  .hero-orb-one { width:430px; height:430px; right:-180px; top:60px; background:rgba(91,124,255,.1); box-shadow:0 0 100px 40px rgba(91,124,255,.07); }
  .hero-orb-two { width:260px; height:260px; left:-140px; top:240px; background:rgba(56,189,248,.08); box-shadow:0 0 90px 30px rgba(56,189,248,.06); }
  .hero-shell { display:grid; grid-template-columns:minmax(0,1.03fr) minmax(520px,.97fr); gap:62px; align-items:center; }
  .offer-pill,.eyebrow { display:inline-flex; align-items:center; gap:8px; color:#9fb1d8; font-size:.72rem; font-weight:700; letter-spacing:.08em; text-transform:uppercase; }
  .offer-pill { min-height:34px; padding:0 7px 0 11px; border:1px solid rgba(124,149,222,.2); border-radius:999px; background:rgba(10,18,46,.72); text-transform:none; letter-spacing:0; font-size:.76rem; }
  .offer-pill > span { width:7px; height:7px; border-radius:50%; background:#67e8a8; box-shadow:0 0 14px #67e8a8; animation:pulse 2s ease infinite; }
  .offer-pill b { padding:4px 7px; color:#dce5ff; border-radius:999px; background:rgba(91,124,255,.18); font-size:.62rem; letter-spacing:.06em; text-transform:uppercase; }
  .hero-copy h1 { max-width:680px; margin-top:20px; color:#f7f9ff; font:800 clamp(2.35rem,4.25vw,3.9rem)/1.04 'Plus Jakarta Sans',sans-serif; letter-spacing:-.05em; }
  .hero-copy h1 em { color:#3b82f6; background:none; -webkit-text-fill-color:currentColor; font-style:normal; }
  .hero-sub { max-width:600px; margin-top:18px!important; color:#a7b4cf; font-size:clamp(1rem,1.6vw,1.18rem); line-height:1.7; }
  .hero-actions { display:flex; flex-wrap:wrap; gap:12px; margin-top:22px; }
  .primary-button,.secondary-button,.white-button { display:inline-flex; align-items:center; justify-content:center; gap:9px; min-height:54px; padding:0 20px; border-radius:13px; font-size:.86rem; font-weight:750; transition:transform .22s ease,box-shadow .22s ease,border-color .22s ease; }
  .primary-button { color:white; border:1px solid rgba(255,255,255,.14); background:linear-gradient(135deg,#5b7cff,#6849e8); box-shadow:0 14px 38px rgba(91,124,255,.28),inset 0 1px rgba(255,255,255,.18); }
  .primary-button:hover,.white-button:hover { transform:translateY(-3px); box-shadow:0 20px 48px rgba(91,124,255,.4); }
  .secondary-button { color:#e8edff; border:1px solid rgba(151,169,218,.22); background:rgba(10,16,37,.66); }
  .secondary-button:hover { transform:translateY(-3px); border-color:rgba(125,150,255,.6); background:rgba(19,29,66,.82); }
  .micro-proof { display:flex; flex-wrap:wrap; gap:16px; margin-top:22px; color:#7483a5; font-size:.69rem; }
  .micro-proof span { display:flex; align-items:center; gap:5px; } .micro-proof svg { color:#6ee7b7; }
  .hero-product { position:relative; perspective:1200px; }
  .product-glow { position:absolute; inset:13% 7%; background:linear-gradient(135deg,rgba(91,124,255,.36),rgba(56,189,248,.12)); filter:blur(55px); }
  .app-window { position:relative; z-index:1; overflow:hidden; border:1px solid rgba(158,176,230,.2); border-radius:18px; background:rgba(7,12,29,.88); box-shadow:0 40px 100px rgba(0,0,0,.46),inset 0 1px rgba(255,255,255,.06); transform:rotateY(-3deg) rotateX(1deg); backdrop-filter:blur(20px); }
  .app-topbar { height:47px; display:flex; align-items:center; justify-content:space-between; padding:0 16px; border-bottom:1px solid var(--line); color:#8493b7; font-size:.67rem; }
  .window-dots { display:flex; gap:5px; }.window-dots span{width:7px;height:7px;border-radius:50%;background:#303b59}.window-dots span:first-child{background:#fc7284}.window-dots span:nth-child(2){background:#e9b949}.window-dots span:last-child{background:#54d78f}
  .app-title,.live-chip { display:flex; align-items:center; gap:7px; }.live-chip { color:#70e6ac; }.live-chip span { width:6px;height:6px;border-radius:50%;background:#54d78f;box-shadow:0 0 10px #54d78f; }
  .app-content { display:grid; grid-template-columns:52px 1fr; min-height:390px; }
  .app-sidebar { display:flex; align-items:center; flex-direction:column; gap:13px; padding:14px 0; border-right:1px solid var(--line); color:#526181; }
  .side-logo { display:grid;place-items:center;width:28px;height:28px;margin-bottom:7px;border-radius:8px;color:#fff;background:linear-gradient(135deg,#5b7cff,#714be9);font-size:.68rem;font-weight:800}.app-sidebar>span{display:grid;place-items:center;width:30px;height:30px;border-radius:8px}.app-sidebar>span.active{color:#9cb0ff;background:rgba(91,124,255,.13)}
  .app-main { padding:21px 19px; min-width:0; }.app-heading{display:flex;justify-content:space-between;align-items:flex-start}.app-heading div{display:flex;flex-direction:column;gap:4px}.app-heading small{color:#6e7b9d;font-size:.58rem;text-transform:uppercase;letter-spacing:.08em}.app-heading strong{color:#eaf0ff;font-size:.95rem}.app-heading>span{padding:6px 8px;border:1px solid rgba(91,124,255,.2);border-radius:7px;color:#9dafed;background:rgba(91,124,255,.08);font-size:.57rem}
  .app-search { display:flex;align-items:center;gap:8px;height:36px;margin-top:18px;padding:0 10px;color:#596887;border:1px solid var(--line);border-radius:9px;background:#080e21;font-size:.62rem}.app-search kbd{margin-left:auto;padding:2px 5px;border:1px solid #29344f;border-radius:4px;color:#61708f;font:inherit}.filter-row{display:flex;gap:6px;margin-top:10px}.filter-row span{padding:5px 7px;color:#7e8cad;border:1px solid var(--line);border-radius:6px;font-size:.55rem}
  .mini-table { margin-top:16px;border:1px solid var(--line);border-radius:10px;overflow:hidden}.mini-head,.mini-row{display:grid;grid-template-columns:1.7fr .4fr .7fr .65fr;align-items:center;gap:7px;padding:0 10px}.mini-head{height:30px;color:#5e6c8b;background:#091126;font-size:.5rem;text-transform:uppercase;letter-spacing:.07em}.mini-row{height:51px;border-top:1px solid rgba(148,163,184,.09);font-size:.58rem;color:#9eabc7}.mini-row>span{display:flex;align-items:center;gap:7px;min-width:0}.mini-row b{color:#bdc8df;filter:blur(2.5px)}.mini-row strong{color:#d7def0;font-size:.6rem}.mini-row em{color:#65dda4;font-style:normal}.site-icon{display:grid;place-items:center;flex:0 0 auto;width:25px;height:25px;border-radius:7px;color:white;font-style:normal;font-size:.58rem;font-weight:800}.icon-1{background:#446fe8}.icon-2{background:#8b5cf6}.icon-3{background:#06b6a8}.icon-4{background:#e05e87}.icon-5{background:#e29a34}
