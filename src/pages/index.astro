  <script is:inline>
    // ---- real WhatsApp number wired into every CTA on the page ----
    const WA_NUMBER = '923327810261';
    function waLink(msg){ return `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(msg)}`; }
    document.getElementById('waHeroBtn').href = waLink("Hello Web Grouth, I'd like to order a guest post.");
    document.getElementById('waStarterBtn').href = waLink("Hello Web Grouth, I'd like to order the Starter package.");
    document.getElementById('waGrowthBtn').href = waLink("Hello Web Grouth, I'd like to order the Growth package.");
    document.getElementById('waProBtn').href = waLink("Hello Web Grouth, I'd like to discuss the Pro package.");
    document.getElementById('waCtaBtn').href = waLink("Hello Web Grouth, I'd like to talk about guest posting and SEO.");
    document.getElementById('waFooterLink').href = waLink("Hello Web Grouth, I'd like more information.");
    document.getElementById('waFloat').href = waLink("Hello Web Grouth, I have a question.");

    // ---- mobile menu ----
    const hamburger = document.getElementById('hamburger');
    const navLinks = document.getElementById('navLinks');
    hamburger.addEventListener('click', () => navLinks.classList.toggle('open'));
    navLinks.querySelectorAll('a').forEach(a => a.addEventListener('click', () => navLinks.classList.remove('open')));

    // ---- header shadow on scroll ----
    const header = document.getElementById('header');
    window.addEventListener('scroll', () => {
      header.style.boxShadow = window.scrollY > 20 ? '0 4px 30px rgba(0,0,0,.05)' : 'none';
    });

    // ---- scroll reveal ----
    const revealEls = document.querySelectorAll('.reveal');
    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('show'); });
    }, { threshold: 0.15 });
    revealEls.forEach(el => io.observe(el));

    // ---- animated counters ----
    const counters = document.querySelectorAll('.trust-bar .num');
    let countersDone = false;
    function runCounters() {
      if (countersDone) return;
      countersDone = true;
      counters.forEach(el => {
        const target = parseFloat(el.dataset.target);
        const suffix = el.dataset.suffix || '';
        if (isNaN(target)) return;
        
        let current = 0;
        const isDecimal = el.dataset.target.includes('.');
        const step = isDecimal ? 0.1 : Math.max(1, Math.ceil(target / 40));
        
        const timer = setInterval(() => {
          current += step;
          if (current >= target) {
            current = target;
            clearInterval(timer);
          }
          el.textContent = (isDecimal ? current.toFixed(1) : Math.floor(current)) + suffix;
        }, isDecimal ? 50 : 30);
      });
    }
    const trustBar = document.querySelector('.trust-bar');
    const trustIO = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) runCounters(); });
    }, { threshold: 0.4 });
    if (trustBar) trustIO.observe(trustBar);

    // respect reduced motion
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.querySelectorAll('.reveal').forEach(el => el.classList.add('show'));
    }
  </script>
