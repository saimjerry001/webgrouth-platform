<!DOCTYPE html>
<html lang="ur">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Web Grouth – Guest Posting, SEO & High-Authority Backlinks</title>
  <meta name="description" content="Web Grouth helps brands earn relevant guest posts and contextual backlinks through vetted publishers." />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    * { margin:0; padding:0; box-sizing:border-box; }
    html { scroll-behavior:smooth; }
    body {
      font-family:'Plus Jakarta Sans', sans-serif;
      background:#ffffff; color:#0f172a; line-height:1.65; width:100%; position:relative;
    }
    .container { max-width:1200px; margin:0 auto; padding:0 24px; }
    a { text-decoration:none; color:inherit; }
    h1,h2,h3,h4 { font-family:'Outfit',sans-serif; letter-spacing:-0.03em; font-weight:700; }

    /* ===== HEADER ===== */
    .header {
      position:fixed; top:0; left:0; width:100%; z-index:1000;
      background:rgba(255,255,255,.95); backdrop-filter:blur(16px);
      border-bottom:1px solid rgba(15,23,42,.06); padding:14px 0;
    }
    .header-inner { display:flex; justify-content:space-between; align-items:center; }
    .logo { display:flex; align-items:center; gap:10px; font-size:1.55rem; font-weight:800; color:#0f172a; }
    .logo-mark {
      width:38px; height:38px; border-radius:11px; background:linear-gradient(135deg,#2563eb,#1d4ed8);
      display:flex; align-items:center; justify-content:center; box-shadow:0 6px 16px rgba(37,99,235,.35);
    }
    .logo-mark svg { width:22px; height:22px; }
    .logo span { background:linear-gradient(135deg,#2563eb,#1d4ed8); -webkit-background-clip:text; -webkit-text-fill-color:transparent; }
    .nav-links { display:flex; align-items:center; gap:32px; }
    .nav-links a:not(.btn-nav) { font-weight:600; color:#334155; transition:.2s; font-size:.95rem; }
    .nav-links a:not(.btn-nav):hover { color:#2563eb; }
    .nav-links .btn-nav {
      background:#2563eb; color:#fff !important; padding:10px 24px; border-radius:40px; font-weight:700;
      box-shadow:0 6px 18px rgba(37,99,235,.25); transition:.3s;
    }
    .nav-links .btn-nav:hover { background:#1d4ed8; transform:translateY(-2px); }
    .hamburger { display:none; flex-direction:column; gap:5px; cursor:pointer; padding:6px; }
    .hamburger span { width:26px; height:3px; background:#0f172a; border-radius:3px; }

    /* ===== BUTTONS ===== */
    .btn {
      display:inline-flex; align-items:center; justify-content:center; gap:10px;
      padding:14px 28px; border-radius:40px; font-weight:700; font-size:.95rem;
      transition:.3s; border:none; cursor:pointer; text-align:center;
    }
    .btn-primary { background:#2563eb; color:#fff; box-shadow:0 10px 28px rgba(37,99,235,.28); }
    .btn-primary:hover { background:#1d4ed8; transform:translateY(-2px); }
    .btn-whatsapp { background:#25d366; color:#fff; box-shadow:0 10px 28px rgba(37,211,102,.28); }
    .btn-whatsapp:hover { background:#1ebe5c; transform:translateY(-2px); }

    /* ===== HERO ===== */
    .hero { padding:120px 0 60px; background:linear-gradient(165deg,#f8faff 0%,#ffffff 60%); }
    .hero-grid { display:grid; grid-template-columns:1.05fr .95fr; gap:50px; align-items:center; }
    .hero-content .tag {
      display:inline-flex; align-items:center; gap:9px; background:rgba(37,99,235,.09); color:#2563eb;
      padding:8px 18px; border-radius:40px; font-weight:700; font-size:.85rem; margin-bottom:16px;
    }
    .tag .live-dot { width:7px; height:7px; border-radius:50%; background:#22c55e; }
    .hero-content h1 { font-size:3rem; font-weight:800; line-height:1.18; margin-bottom:16px; }
    .hero-content h1 .highlight { background:linear-gradient(135deg,#2563eb,#1d4ed8); -webkit-background-clip:text; -webkit-text-fill-color:transparent; }
    .hero-content p.subhead { font-size:1.05rem; color:#475569; margin-bottom:24px; }
    .hero-actions { display:flex; flex-wrap:wrap; gap:14px; margin-bottom:24px; }

    /* Floating Image Container with Corner Badges */
    .hero-image { position:relative; width:100%; max-width:460px; margin:0 auto; }
    .img-wrap {
      position:relative; width:100%; aspect-ratio:16/10; border-radius:20px;
      box-shadow:0 20px 50px rgba(15,23,42,.12); overflow:hidden;
    }
    .img-wrap img {
      position:absolute; inset:0; width:100%; height:100%; object-fit:cover;
      opacity:0; transition:opacity 0.8s ease-in-out;
    }
    .img-wrap img.active { opacity:1; }

    /* Compact Corner Badges */
    .floating-badge {
      display:inline-flex; align-items:center; gap:8px;
      background:rgba(255,255,255,0.95); backdrop-filter:blur(10px);
      padding:8px 14px; border-radius:30px; border:1px solid #e2e8f0;
      box-shadow:0 8px 20px rgba(15,23,42,.1); position:absolute; z-index:10;
      animation:floatUpDown 4s ease-in-out infinite; white-space:nowrap;
    }
    .floating-badge.b1 { bottom:-12px; left:-12px; }
    .floating-badge.b2 { top:-12px; right:-12px; animation-delay:2s; }
    .floating-badge .badge-icon {
      width:22px; height:22px; border-radius:50%; background:#dcfce7; color:#16a34a;
      display:flex; align-items:center; justify-content:center; font-size:.7rem;
    }
    .floating-badge.b2 .badge-icon { background:#dbeafe; color:#2563eb; }
    .floating-badge strong { font-size:.75rem; color:#0f172a; font-weight:700; line-height:1; }
    .floating-badge span.sub { font-size:.65rem; color:#64748b; font-weight:500; display:block; margin-top:2px; }

    @keyframes floatUpDown { 0%,100%{ transform:translateY(0); } 50%{ transform:translateY(-6px); } }

    /* ===== RESPONSIVE ===== */
    @media (max-width:992px) {
      .hero-grid { grid-template-columns:1fr; text-align:center; }
      .hero-actions { justify-content:center; }
      .hero-content h1 { font-size:2.2rem; }
    }
    @media (max-width:768px) {
      .nav-links { display:none; }
      .hamburger { display:flex; }
      .floating-badge { padding:6px 10px; }
      .floating-badge strong { font-size:.68rem; }
      .floating-badge span.sub { font-size:.58rem; }
      .floating-badge.b1 { bottom:-8px; left:-8px; }
      .floating-badge.b2 { top:-8px; right:-8px; }
    }
  </style>
</head>
<body>

  <!-- HEADER -->
  <header class="header">
    <div class="container header-inner">
      <div class="logo">
        <div class="logo-mark">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M4 20L12 12L16 16L22 8" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round"/>
          </svg>
        </div>
        Web<span>Grouth</span>
      </div>
      <nav class="nav-links">
        <a href="/">Home</a>
        <a href="/#services">Services</a>
        <a href="/#pricing">Pricing</a>
        <a href="/contact" class="btn-nav">Get Started</a>
      </nav>
      <div class="hamburger"><span></span><span></span><span></span></div>
    </div>
  </header>

  <!-- HERO SECTION -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-content">
        <div class="tag"><span class="live-dot"></span> Secure High-Authority Guest Posts Today</div>
        <h1>Drive Massive Search Traffic with <span class="highlight">Real Editorial Backlinks</span></h1>
        <p class="subhead">Get featured on high-traffic, editorially-vetted websites within your niche safely.</p>
        <div class="hero-actions">
          <a href="#pricing" class="btn btn-primary"><i class="fas fa-bolt"></i> Order a Guest Post Now</a>
          <a href="https://wa.me/923327810261?text=Hello%20Web%20Grouth%2C%20I%20have%20a%20question." target="_blank" rel="noopener" class="btn btn-whatsapp">
            <i class="fab fa-whatsapp"></i> Chat on WhatsApp
          </a>
        </div>
      </div>

      <!-- HERO IMAGE & COMPACT CORNER BADGES -->
      <div class="hero-image">
        <div class="img-wrap" id="laptopSlider">
          <img src="/hero-dashboard.png" class="active" alt="SEO Dashboard" onerror="this.src='https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=900&q=80'" />
        </div>
        
        <!-- Bottom-Left Badge -->
        <div class="floating-badge b1">
          <div class="badge-icon"><i class="fas fa-check"></i></div>
          <div>
            <strong>Success Guest Post</strong>
            <span class="sub">100% indexed & live</span>
          </div>
        </div>

        <!-- Top-Right Badge -->
        <div class="floating-badge b2">
          <div class="badge-icon"><i class="fas fa-link"></i></div>
          <div>
            <strong>Success SEO</strong>
            <span class="sub">rankings that stay</span>
          </div>
        </div>
      </div>
    </div>
  </section>

</body>
</html>
