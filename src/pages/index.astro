---
import BaseLayout from '../layouts/BaseLayout.astro';

const categories = ['SaaS', 'Business', 'Technology', 'Finance', 'Health', 'Home', 'Marketing', 'Lifestyle'];
const rail = [...categories, ...categories];
const services = [
  {
    number: '01', icon: '✦', title: 'Editorial Guest Posts', href: '/guest-posting',
    text: 'Original, relevant content placed with vetted publishers—built around your target page, anchor strategy and audience.'
  },
  {
    number: '02', icon: '↗', title: 'Contextual Link Insertion', href: '/link-insertion',
    text: 'Earn a natural link inside an existing, indexed article where your resource genuinely adds value to the page.'
  },
  {
    number: '03', icon: '◎', title: 'Publisher Outreach', href: '/guest-posting',
    text: 'Direct, human outreach that prioritises editorial fit, transparent terms and durable publisher relationships.'
  },
  {
    number: '04', icon: '⌁', title: 'Off-page SEO', href: '/seo-services',
    text: 'Campaign planning shaped by relevance, authority, traffic quality and a natural link profile—not just one metric.'
  },
  {
    number: '05', icon: '✎', title: 'SEO Content', href: '/seo-services',
    text: 'Clear briefs and publication-ready articles written to serve readers while supporting your search objectives.'
  },
];
const steps = [
  ['01', 'Share the target', 'Send your niche, landing page, preferred markets, anchors and campaign priorities.'],
  ['02', 'Review the sites', 'Receive a focused publisher shortlist with the details you need to make a confident choice.'],
  ['03', 'Approve the work', 'Confirm placements and content direction before anything is submitted for publication.'],
  ['04', 'Go live & report', 'Get the live URL, placement details and a clean campaign record after publication.'],
];
---

<BaseLayout
  title="Web Grouth | Editorial Guest Posts & Link Building"
  description="Build durable search authority with vetted guest posts, contextual link insertions and publisher outreach from Web Grouth."
>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy" data-reveal>
        <div class="eyebrow"><span class="eyebrow-dot"></span> Publisher-led link building</div>
        <h1>Editorial links.<br /><span class="gradient-text">Engineered for growth.</span></h1>
        <p>We help SEO teams and ambitious brands earn relevant guest posts and contextual backlinks on real websites—without the noise, guesswork or vanity-metric chasing.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="/contact">Plan your campaign <span>↗</span></a>
          <a class="button button-secondary" href="https://wa.me/923327810261?text=Hello%20Web%20Grouth%2C%20please%20send%20me%20your%20guest%20posting%20site%20list." target="_blank" rel="noopener">Get publisher list</a>
        </div>
        <div class="hero-proof">
          <span><i>✓</i> Pay after placement</span>
          <span><i>✓</i> Relevance-first vetting</span>
          <span><i>✓</i> Clear live reporting</span>
        </div>
      </div>

      <div class="hero-visual" data-reveal data-reveal-delay="2" aria-label="Illustration of organic traffic growth from an editorial link">
        <div class="hero-orbit"></div>
        <div class="hero-orbit two"></div>
        <div class="float-card float-one"><span class="float-icon">✓</span><strong style="display:inline">Link published</strong><br /><span>Editorial placement verified</span></div>
        <div class="float-card float-two"><strong>Organic visibility <span style="color:var(--lime)">↗</span></strong><span>Positive search momentum</span></div>
        <div class="growth-panel">
          <div class="panel-top">
            <div class="panel-domain"><span class="panel-logo">W</span><div><strong>Campaign overview</strong><small>Authority growth · 90 days</small></div></div>
            <span class="live-pill">LIVE</span>
          </div>
          <div class="panel-chart">
            <div class="chart-grid"></div>
            <svg class="chart-svg" viewBox="0 0 400 150" preserveAspectRatio="none" aria-hidden="true">
              <defs><linearGradient id="area-gradient" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#b8ff5a"/><stop offset="1" stop-color="#b8ff5a" stop-opacity="0"/></linearGradient></defs>
              <path class="chart-area" d="M0,136 C42,132 53,123 82,125 C116,127 127,105 158,110 C185,113 199,86 229,92 C258,98 278,60 302,68 C333,78 349,33 400,20 L400,150 L0,150 Z"/>
              <path class="chart-line" d="M0,136 C42,132 53,123 82,125 C116,127 127,105 158,110 C185,113 199,86 229,92 C258,98 278,60 302,68 C333,78 349,33 400,20"/>
            </svg>
          </div>
          <div class="panel-metrics">
            <div class="panel-metric"><span>Publishers</span><strong>500<em>+</em></strong></div>
            <div class="panel-metric"><span>Link type</span><strong>Follow</strong></div>
            <div class="panel-metric"><span>Reporting</span><strong>Clear</strong></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="category-rail" aria-label="Publisher categories">
    <div class="rail-track">
      {rail.map((category) => <span class="rail-item">{category}</span>)}
    </div>
  </div>

  <section class="section section-tight">
    <div class="shell stats-grid" data-reveal>
      <div class="stat-intro"><span class="kicker">Built for repeat campaigns</span><p>A practical link-building partner for agencies, in-house SEO teams and growing brands.</p></div>
      <div class="stat"><strong>500+</strong><span>Publisher opportunities across multiple niches</span></div>
      <div class="stat"><strong>30+</strong><span>Business and editorial categories covered</span></div>
      <div class="stat"><strong>1:1</strong><span>Human support from brief to live link</span></div>
    </div>
  </section>

  <section class="section" id="services">
    <div class="shell">
      <div class="section-heading" data-reveal>
        <div class="eyebrow"><span class="eyebrow-dot"></span> What we do</div>
        <h2>Everything between a target page and a <span class="gradient-text">credible mention.</span></h2>
        <p>Choose one focused service or build a campaign that combines outreach, editorial content and relevant placements.</p>
      </div>
      <div class="service-grid">
        {services.map((service, index) => (
          <article class="service-card" data-reveal data-reveal-delay={String(index % 3)}>
            <div class="service-number"><span>{service.number} / SERVICE</span><span class="service-icon">{service.icon}</span></div>
            <h3>{service.title}</h3>
            <p>{service.text}</p>
            <a class="text-link" href={service.href}>Explore service <span>↗</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="shell split-feature">
      <div class="feature-image" data-reveal>
        <img src="/images/webgrouth-publishing.png" alt="Editorial publishing and content strategy workspace" loading="lazy" />
        <div class="image-badge">Real sites.<br />Real context.<br />Real value.</div>
      </div>
      <div class="feature-copy" data-reveal data-reveal-delay="1">
        <div class="eyebrow"><span class="eyebrow-dot"></span> Relevance before numbers</div>
        <h2>We vet the place, not just the metric.</h2>
        <p>A high score cannot rescue a weak editorial fit. Every opportunity is reviewed through the lens of topic relevance, traffic quality, page context and publication terms.</p>
        <ul class="check-list">
          <li><i>✓</i><span><strong>Publisher and niche alignment</strong><span>The website and article must make sense for your brand and destination page.</span></span></li>
          <li><i>✓</i><span><strong>Organic visibility review</strong><span>We look beyond a headline metric to understand whether the site has genuine search presence.</span></span></li>
          <li><i>✓</i><span><strong>Placement terms confirmed</strong><span>Link type, permanence, turnaround and content requirements are clarified before approval.</span></span></li>
        </ul>
        <a class="button button-secondary" href="/about" style="margin-top:25px">How we work <span>↗</span></a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading center" data-reveal>
        <div class="eyebrow"><span class="eyebrow-dot"></span> A clear operating system</div>
        <h2>From campaign brief to <span class="gradient-text">live placement.</span></h2>
        <p>A simple, transparent workflow keeps you in control without slowing the campaign down.</p>
      </div>
      <div class="process-grid">
        {steps.map(([number, title, text], index) => (
          <article class="process-step" data-reveal data-reveal-delay={String(index)}>
            <span class="step-number">STEP {number}</span>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-tight">
    <div class="shell trust-panel" data-reveal>
      <div class="trust-panel-inner">
        <div><span class="kicker">Flexible by design</span><h2>One placement or an always-on pipeline.</h2></div>
        <div class="trust-copy">
          <p>Start with a single opportunity or share a larger target list. We can support one-off orders, agency fulfilment and recurring outreach without locking you into a generic package.</p>
          <div class="tag-row"><span class="tag">Guest posting</span><span class="tag">Niche edits</span><span class="tag">Agency fulfilment</span><span class="tag">Content support</span><span class="tag">Custom outreach</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-block">
    <div class="shell cta-card" data-reveal>
      <div class="eyebrow"><span class="eyebrow-dot"></span> Ready when you are</div>
      <h2>Bring us the target. We’ll map the route.</h2>
      <p>Tell us your niche, landing page and campaign goals. We’ll respond with the right next step and relevant publisher options.</p>
      <a class="button" href="/contact">Start a campaign <span>↗</span></a>
    </div>
  </section>
</BaseLayout>
