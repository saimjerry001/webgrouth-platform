---
// src/pages/blog/index.astro
---
<!DOCTYPE html>
<html lang="ur">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Our Blog | Web Grouth</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <style is:inline>
    * { margin:0; padding:0; box-sizing:border-box; }
    html { scroll-behavior:smooth; }
    body {
      font-family:'Plus Jakarta Sans', sans-serif;
      background:#ffffff;
      color:#0f172a;
      line-height:1.65;
    }
    .container { max-width:1200px; margin:0 auto; padding:0 24px; }
    a { text-decoration:none; color:inherit; }
    h1,h2,h3,h4 { font-family:'Outfit',sans-serif; letter-spacing:-0.03em; font-weight:700; }
    
    /* ===== HEADER ===== */
    .header {
      position:fixed; top:0; left:0; width:100%; z-index:1000;
      background:rgba(255,255,255,.78); backdrop-filter:blur(16px); -webkit-backdrop-filter:blur(16px);
      border-bottom:1px solid rgba(15,23,42,.06); padding:14px 0;
    }
    .header-inner { display:flex; justify-content:space-between; align-items:center; }
    .logo { display:flex; align-items:center; gap:10px; font-size:1.55rem; font-weight:800; color:#0f172a; }
    .logo-mark {
      width:38px; height:38px; border-radius:11px;
      background:linear-gradient(135deg,#2563eb,#1d4ed8);
      display:flex; align-items:center; justify-content:center;
      box-shadow:0 6px 16px rgba(37,99,235,.35); flex-shrink:0;
    }
    .logo-mark svg { width:22px; height:22px; }
    .logo span { background:linear-gradient(135deg,#2563eb,#1d4ed8); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }
    .nav-links { display:flex; align-items:center; gap:32px; }
    .nav-links a:not(.btn-nav) { font-weight:600; color:#334155; transition:.2s; font-size:.95rem; }
    .nav-links a:not(.btn-nav):hover { color:#2563eb; }
    .nav-links .btn-nav {
      background:#2563eb; color:#fff !important; padding:11px 28px; border-radius:40px; font-weight:700;
      transition:.3s; box-shadow:0 6px 18px rgba(37,99,235,.25);
    }
    .nav-links .btn-nav:hover { background:#1d4ed8; transform:translateY(-2px); }
    .hamburger { display:none; flex-direction:column; gap:5px; cursor:pointer; padding:6px; }
    .hamburger span { width:26px; height:3px; background:#0f172a; border-radius:3px; transition:.3s; }

    /* ===== HERO ===== */
    .blog-hero { padding:160px 0 60px; background:linear-gradient(165deg,#f8faff 0%,#ffffff 60%); text-align:center; }
    .blog-hero h1 { font-size:3.5rem; font-weight:900; line-height:1.1; margin-bottom:20px; }
    .blog-hero h1 span { background:linear-gradient(135deg,#2563eb,#1d4ed8); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }
    .blog-hero p { font-size:1.2rem; color:#475569; max-width:700px; margin:0 auto; }

    /* ===== BLOG GRID ===== */
    .blog-section { padding:60px 0 100px; }
    .blog-grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(320px, 1fr)); gap:40px; }
    .blog-card { background:#ffffff; border:1px solid #e2e8f0; border-radius:24px; overflow:hidden; transition:0.3s; display:flex; flex-direction:column; }
    .blog-card:hover { transform:translateY(-8px); border-color:#2563eb; box-shadow:0 20px 40px rgba(15,23,42,0.06); }
    .blog-img { width:100%; height:220px; overflow:hidden; position:relative; }
    .blog-img img { width:100%; height:100%; object-fit:cover; transition:transform 0.5s ease; }
    .blog-card:hover .blog-img img { transform:scale(1.06); }
    .blog-badge { position:absolute; top:20px; left:20px; background:#2563eb; color:#fff; padding:6px 14px; border-radius:40px; font-size:0.8rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; }
    .blog-content { padding:30px; display:flex; flex-direction:column; justify-content:space-between; flex-grow:1; }
    .blog-meta { display:flex; gap:16px; color:#64748b; font-size:0.85rem; font-weight:600; margin-bottom:12px; }
    .blog-content h3 { font-size:1.35rem; margin-bottom:12px; color:#0f172a; line-height:1.4; }
    .blog-content p { color:#475569; font-size:0.95rem; margin-bottom:20px; line-height:1.6; }
    .read-more { font-weight:700; color:#2563eb; font-size:0.92rem; display:inline-flex; align-items:center; gap:6px; }
    .read-more i { transition:0.3s; }
    .blog-card:hover .read-more i { transform:translateX(4px); }

    /* ===== FOOTER ===== */
    .footer { background:#fff; border-top:1px solid #f1f5f9; padding:64px 0 30px; }
    .footer-grid { display:grid; grid-template-columns:2fr 1fr 1fr 1.5fr; gap:40px; margin-bottom:40px; }
    .footer-brand p { color:#64748b; max-width:280px; font-size:.95rem; margin-top:14px; }
    .footer-col h4 { font-size:1rem; font-weight:700; margin-bottom:16px; }
    .footer-col ul { list-style:none; }
    .footer-col ul li { margin-bottom:10px; }
    .footer-col ul li a { color:#64748b; transition:.2s; font-size:.95rem; }
    .footer-col ul li a:hover { color:#2563eb; }
    .footer-bottom { border-top:1px solid #f1f5f9; padding-top:24px; text-align:center; color:#94a3b8; font-size:.9rem; }

    @media (max-width: 992px) {
      .footer-grid { grid-template-columns:1fr 1fr; }
    }
    @media (max-width: 768px) {
      .nav-links {
        display:none; flex-direction:column; background:rgba(255,255,255,.98); position:absolute; top:70px; left:0;
        width:100%; padding:30px 24px; gap:20px; border-bottom:1px solid #f1f5f9; box-shadow:0 10px 30px rgba(0,0,0,0.05);
      }
      .nav-links.open { display:flex; }
      .hamburger { display:flex; }
      .blog-hero h1 { font-size:2.6rem; }
      .footer-grid { grid-template-columns:1fr; text-align:center; }
    }
  </style>
</head>
<body>

  <!-- HEADER -->
  <header class="header" id="header">
    <div class="container header-inner">
      <div class="logo">
        <a href="/" style="display:flex; align-items:center; gap:10px;">
          <div class="logo-mark">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <linearGradient id="logo-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#ffffff" /><stop offset="100%" stop-color="#93c5fd" />
                </linearGradient>
              </defs>
              <path d="M4 20L12 12L16 16L22 8" stroke="url(#logo-grad)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M17 8H22V13" stroke="url(#logo-grad)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
              <circle cx="4" cy="20" r="2.2" fill="#ffffff" /><circle cx="12" cy="12" r="2.2" fill="#ffffff" /><circle cx="16" cy="16" r="2.2" fill="#ffffff" /><circle cx="22" cy="8" r="2.2" fill="#ffffff" />
            </svg>
          </div>
          Web<span>Grouth</span>
        </a>
      </div>
      <nav class="nav-links" id="navLinks">
        <a href="/">Home</a>
        <a href="/#services">Services</a>
        <a href="/#pricing">Pricing</a>
        <a href="/about">About</a>
        <a href="/blog">Blog</a>
        <a href="/contact">Contact</a>
        <a href="/contact" class="btn-nav">Get Started</a>
      </nav>
      <div class="hamburger" id="hamburger"><span></span><span></span><span></span></div>
    </div>
  </header>

  <!-- HERO -->
  <section class="blog-hero">
    <div class="container">
      <h1>The Web Grouth <span>Knowledge Base</span></h1>
      <p>Master Google algorithms, high-impact guest posting, and actionable search engine optimization tactics.</p>
    </div>
  </section>

  <!-- BLOG GRID -->
  <section class="blog-section">
    <div class="container blog-grid">
      
      <!-- Article 1 -->
      <div class="blog-card">
        <div class="blog-img">
          <img src="https://images.unsplash.com/photo-1432821596592-e2c18b78144f?w=600&q=80" alt="Blog Post 1" />
          <span class="blog-badge">Link Building</span>
        </div>
        <div class="blog-content">
          <div>
            <div class="blog-meta">
              <span><i class="far fa-calendar"></i> August 15, 2026</span>
              <span><i class="far fa-clock"></i> 5 min read</span>
            </div>
            <h3>PBNs vs. Editorial Backlinks: Why the Difference Matters</h3>
            <p>Understand the critical difference between spammy private networks and real contextual placements for Google ranking success.</p>
          </div>
          <a href="/blog/pbns-vs-editorial-backlinks" class="read-more">Read Article <i class="fas fa-arrow-right"></i></a>
        </div>
      </div>

      <!-- Article 2 -->
      <div class="blog-card">
        <div class="blog-img">
          <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=600&q=80" alt="Blog Post 2" />
          <span class="blog-badge">SEO Strategy</span>
        </div>
        <div class="blog-content">
          <div>
            <div class="blog-meta">
              <span><i class="far fa-calendar"></i> August 10, 2026</span>
              <span><i class="far fa-clock"></i> 7 min read</span>
            </div>
            <h3>How to Vette a Guest Posting Site for Real Traffic</h3>
            <p>Stop paying for dummy metrics. Learn our detailed framework to identify publishers with genuine organic visitors.</p>
          </div>
          <a href="/blog/how-to-vette-guest-post-sites" class="read-more">Read Article <i class="fas fa-arrow-right"></i></a>
        </div>
      </div>

      <!-- Article 3 -->
      <div class="blog-card">
        <div class="blog-img">
          <img src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=600&q=80" alt="Blog Post 3" />
          <span class="blog-badge">Case Studies</span>
        </div>
        <div class="blog-content">
          <div>
            <div class="blog-meta">
              <span><i class="far fa-calendar"></i> August 05, 2026</span>
              <span><i class="far fa-clock"></i> 9 min read</span>
            </div>
            <h3>The Ultimate Guide to Contextual Link Building</h3>
            <p>Our complete roadmap to gaining high-impact contextual links that search bots trust and reward instantly.</p>
          </div>
          <a href="/blog/ultimate-guide-contextual-links" class="read-more">Read Article <i class="fas fa-arrow-right"></i></a>
        </div>
      </div>

    </div>
  </section>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <div class="logo" style="font-size:1.55rem;">
            <div class="logo-mark">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <defs>
                  <linearGradient id="logo-grad-f" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#ffffff" /><stop offset="100%" stop-color="#93c5fd" />
                  </linearGradient>
                </defs>
                <path d="M4 20L12 12L16 16L22 8" stroke="url(#logo-grad-f)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M17 8H22V13" stroke="url(#logo-grad-f)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                <circle cx="4" cy="20" r="2.2" fill="#ffffff" /><circle cx="12" cy="12" r="2.2" fill="#ffffff" /><circle cx="16" cy="16" r="2.2" fill="#ffffff" /><circle cx="22" cy="8" r="2.2" fill="#ffffff" />
              </svg>
            </div>
            Web<span>Grouth</span>
          </div>
          <p>We help brands earn relevant guest posts and contextual backlinks through vetted publishers — built for relevance, not volume.</p>
        </div>
        <div class="footer-col">
          <h4>Services</h4>
          <ul>
            <li><a href="/#services">Guest Posting</a></li>
            <li><a href="/#services">Backlink Building</a></li>
            <li><a href="/#services">SEO Strategy</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Quick Links</h4>
          <ul>
            <li><a href="/#pricing">Pricing</a></li>
            <li><a href="/about">About Us</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Connect</h4>
          <ul>
            <li><a href="mailto:nasirhaiderseo@gmail.com"><i class="fas fa-envelope"></i> nasirhaiderseo@gmail.com</a></li>
            <li><a href="https://wa.me/923327810261" target="_blank"><i class="fab fa-whatsapp"></i> +92 332 7810261</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">&copy; 2026 Web Grouth. All rights reserved.</div>
    </div>
  </footer>

  <script is:inline>
    const hamburger = document.getElementById('hamburger');
    const navLinks = document.getElementById('navLinks');
    hamburger.addEventListener('click', () => navLinks.classList.toggle('open'));
  </script>
</body>
</html>
