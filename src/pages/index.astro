---
import BaseLayout from '../layouts/BaseLayout.astro';

const publisherSites = [
  { domain: 'news.guestpostnow.com', da: 57, dr: 71, traffic: '—' },
  { domain: 'programminginsider.com', da: 59, dr: 72, traffic: '—' },
  { domain: 'blogsandnews.com', da: 57, dr: 37, traffic: '—' },
  { domain: 'storifygo.com', da: 54, dr: 53, traffic: '—' },
  { domain: 'substack.com', da: 92, dr: 92, traffic: '—' },
  { domain: 'livepositively.com', da: 61, dr: 72, traffic: '—' },
  { domain: 'outdoorproject.com', da: 59, dr: 71, traffic: '—' },
  { domain: 'theomnibuzz.com', da: 59, dr: 62, traffic: '—' },
  { domain: 'bignewsnetwork.com', da: 66, dr: 76, traffic: '—' },
  { domain: 'fundly.com', da: 70, dr: 80, traffic: '—' },
] as const;

const services = [
  {
    number: '01',
    title: 'Guest Posting',
    details: '/guest-posting',
    text: 'Guest posts on websites selected for your niche, target page and goals.',
    points: ['See website options before work starts', 'Use your article or ask us to write it', 'Receive the live URL and report'],
    href: '/order?service=Guest%20Posting',
  },
  {
    number: '02',
    title: 'Contextual Link Insertion',
    details: '/link-insertion',
    text: 'Add your link to an existing article where it fits the topic naturally.',
    points: ['Relevant article selected', 'Anchor and target URL approved', 'Clear price and terms'],
    href: '/order?service=Link%20Insertion',
  },
  {
    number: '03',
    title: 'Agency & Bulk Campaigns',
    details: '/seo-services',
    text: 'Simple guest post delivery for agencies with regular or multi-client orders.',
    points: ['Bulk website matching', 'Easy campaign tracking', 'Dedicated human support'],
    href: '/order?service=Bulk%20Guest%20Posting',
  },
] as const;

const categories = [
  ['SaaS & Technology', 'Software, AI, cybersecurity and digital products.'],
  ['Business & Finance', 'Companies, entrepreneurship, investing and professional services.'],
  ['Health & Wellness', 'Medical, fitness, nutrition and wellbeing publications.'],
  ['Home & Lifestyle', 'Home improvement, interiors, family and everyday living.'],
  ['Travel & Hospitality', 'Destinations, hotels, outdoor experiences and travel services.'],
  ['Marketing & Media', 'SEO, content, advertising, ecommerce and creator platforms.'],
  ['Education & Careers', 'Learning, training, hiring, remote work and career development.'],
  ['General & Multi-Niche', 'Broad publications for campaigns that need wider editorial reach.'],
] as const;

const standards = [
  ['Relevance first', 'The publication and article must make sense for the target page.'],
  ['Check more than metrics', 'We review relevance, DA, DR and traffic before suggesting a website.'],
  ['Clear terms first', 'We confirm the link, content, price and delivery time before work starts.'],
  ['Real human support', 'A campaign manager reviews your order and answers your questions.'],
  ['Simple reporting', 'You receive the live URL and all agreed order details.'],
  ['Support for every order', 'We use the same clear process for single and bulk campaigns.'],
] as const;

const faqs = [
  ['Can I choose the website before publishing?', 'Yes. Tell us your niche, country, preferred metrics and budget. We will send suitable website options for your approval.'],
  ['Can I send my own article?', 'Yes. You can paste or upload your article on the order page. You can also ask Web Grouth to write it for you.'],
  ['Can I place one order or a bulk order?', 'Yes. We handle single guest posts, bulk orders and regular agency campaigns.'],
  ['When do I pay?', 'Eligible orders can be paid after the link is live. We confirm the website, price and payment terms before work starts.'],
] as const;

const homeSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': 'https://www.webgrouth.com/#guest-posting-service',
    name: 'Guest Posting and Link Building Services',
    serviceType: ['Guest posting', 'Contextual link insertion', 'Off-page SEO'],
    url: 'https://www.webgrouth.com/',
    description: 'Relevant guest posts and contextual link placements for brands and SEO agencies targeting audiences worldwide.',
    provider: { '@id': 'https://www.webgrouth.com/#organization' },
    areaServed: 'Worldwide',
    audience: [
      { '@type': 'BusinessAudience', audienceType: 'Brands' },
      { '@type': 'BusinessAudience', audienceType: 'SEO agencies' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(([question, answer]) => ({
      '@type': 'Question',
      name: question,
      acceptedAnswer: { '@type': 'Answer', text: answer },
    })),
  },
];
---

<BaseLayout title="Worldwide Guest Posting & Link Building | Web Grouth" description="Get guest posts and link insertions on relevant websites worldwide. Review publisher options, prices and terms before we deliver your live link." structuredData={homeSchema}>
  <div class="homev3">
    <section class="homev3-hero">
      <div class="shell homev3-hero-grid">
        <div class="homev3-hero-copy" data-reveal>
          <p class="homev3-overline">Guest posting for brands and SEO agencies</p>
          <h1>Guest posting on <span>websites that matter.</span></h1>
          <p class="homev3-lead">Choose from 40,000+ publisher websites across countries, niches and categories. We help you find the right sites, confirm every detail and deliver your live link.</p>
          <div class="homev3-actions">
            <a class="homev3-button homev3-button-primary" href="/order">Place Your Order <span>↗</span></a>
            <a class="homev3-button homev3-button-secondary" href="#database">View Website Network</a>
          </div>
          <div class="homev3-assurance" aria-label="Service highlights">
            <span><i>✓</i> 40,000+ websites</span>
            <span><i>✓</i> Single & bulk orders</span>
            <span><i>✓</i> Pay after live link on eligible orders</span>
          </div>
        </div>

        <div class="homev3-network publisher-feed" data-reveal data-reveal-delay="1">
          <div class="homev3-network-top">
            <div><span class="homev3-live"></span><strong>Publisher network</strong></div>
            <span>Publisher examples</span>
          </div>
          <div class="homev3-network-summary">
            <div><span>Available websites</span><strong>40,000+</strong></div>
            <div><span>Coverage</span><strong>30+ niches</strong></div>
          </div>
          <div class="publisher-feed-table">
            <div class="publisher-feed-head"><span>Website</span><span>DA</span><span>DR</span><span>Traffic</span></div>
            <div class="publisher-feed-viewport">
              <div class="publisher-feed-track">
                {[...publisherSites, ...publisherSites].map((site, index) =>
                  <div class="publisher-feed-row" aria-hidden={index >= publisherSites.length ? 'true' : undefined}>
                    <span><i>{site.domain.charAt(0).toUpperCase()}</i><b>{site.domain}</b></span>
                    <strong>{site.da}</strong><strong>{site.dr}</strong><em>{site.traffic}</em>
                  </div>
                )}
              </div>
            </div>
          </div>
          <div class="homev3-network-filters"><span>All niches</span><span>DA & DR reviewed</span><span>Traffic checked on request</span></div>
        </div>
      </div>
    </section>

    <section class="homev3-proof" aria-label="Web Grouth in numbers">
      <div class="shell homev3-proof-grid">
        <div class="homev3-proof-item"><strong>40,000+</strong><span>websites in popular categories</span></div>
        <div class="homev3-proof-item"><strong>5,000+</strong><span>client orders handled</span></div>
        <div class="homev3-proof-item"><strong>30+</strong><span>niche categories available</span></div>
        <div class="homev3-proof-item"><strong>1:1</strong><span>human support until delivery</span></div>
      </div>
    </section>

    <section class="homev3-section homev3-intro">
      <div class="shell homev3-intro-grid">
        <div class="homev3-section-title" data-reveal>
          <p class="homev3-overline">Simple guest posting</p>
          <h2>The right website makes every backlink stronger.</h2>
        </div>
        <div class="homev3-intro-copy" data-reveal data-reveal-delay="1">
          <p>Tell us the page you want to grow, your niche and your audience. We use these details to find websites that fit your campaign—not only websites with high numbers.</p>
          <div class="homev3-checks">
            <span>Websites selected by a real person</span><span>Approve the site before publishing</span>
            <span>Anchor and target URL checked</span><span>Clear live-link report</span>
          </div>
        </div>
      </div>
    </section>

    <section class="homev3-section homev3-services-section" id="services">
      <span id="pricing" class="anchor-target" aria-hidden="true"></span>
      <div class="shell">
        <div class="homev3-heading-row" data-reveal>
          <div><p class="homev3-overline">Our services</p><h2>Everything you need to place quality links.</h2></div>
          <a href="/guest-posting">View guest posting <span>↗</span></a>
        </div>
        <div class="homev3-service-grid">
          {services.map((service, index) =>
            <article class="homev3-service-card" data-reveal data-reveal-delay={String(index)}>
              <span class="homev3-service-number">{service.number}</span>
              <h3>{service.title}</h3><p>{service.text}</p>
              <ul>{service.points.map((point) => <li><i>✓</i>{point}</li>)}</ul>
              <a href={service.details}>View service details <span>↗</span></a>
            </article>
          )}
        </div>
      </div>
    </section>

    <section class="homev3-section homev3-categories-section" id="database">
      <div class="shell">
        <div class="homev3-centered" data-reveal>
          <p class="homev3-overline">Website categories</p>
          <h2>40,000+ websites. We help you choose the right ones.</h2>
          <p>Tell us your niche, target country and preferred metrics. We will send you a short list of suitable websites.</p>
        </div>
        <div class="homev3-category-grid">
          {categories.map(([title, copy], index) =>
            <a class="homev3-category" href={`/order?service=Guest%20Posting&niche=${encodeURIComponent(title)}`} data-reveal data-reveal-delay={String(index % 4)}>
              <span>{String(index + 1).padStart(2, '0')}</span><h3>{title}</h3><p>{copy}</p>
            </a>
          )}
        </div>
      </div>
    </section>

    <section class="homev3-section homev3-process-section" id="process">
      <div class="shell homev3-process-layout">
        <div class="homev3-process-copy" data-reveal>
          <p class="homev3-overline">How it works</p>
          <h2>Order in four simple steps.</h2>
          <p>Add the details you know. You can leave optional fields blank and we will ask you by email.</p>
          <a class="homev3-button homev3-button-primary" href="/order">Open Order Form <span>↗</span></a>
        </div>
        <div class="homev3-process-list" data-reveal data-reveal-delay="1">
          {[
            ['01', 'Send your order', 'Add your email and any link details you already know.'],
            ['02', 'Review website options', 'We send suitable websites with prices and key details.'],
            ['03', 'Approve your choice', 'Confirm the website, article, anchor and price.'],
            ['04', 'Receive the live link', 'We check the published link and send the live URL to you.'],
          ].map(([number, title, copy]) =>
            <article class="homev3-process-step"><span>{number}</span><div><h3>{title}</h3><p>{copy}</p></div></article>
          )}
        </div>
      </div>
    </section>

    <section class="homev3-experience">
      <div class="shell">
        <div class="homev3-experience-head" data-reveal>
          <div><p class="homev3-overline">How we work</p><h2>Clear, professional support at every step.</h2></div>
          <p>Whether you need one link or a bulk campaign, we keep the process simple and easy to check.</p>
        </div>
        <div class="homev3-standard-grid">
          {standards.map(([title, copy], index) =>
            <article class="homev3-standard-card" data-reveal data-reveal-delay={String(index % 3)}><span>{String(index + 1).padStart(2,'0')}</span><strong>{title}</strong><p>{copy}</p></article>
          )}
        </div>
      </div>
    </section>

    <section class="homev3-section homev3-faq-section">
      <div class="shell homev3-faq-layout">
        <div class="homev3-process-copy" data-reveal><p class="homev3-overline">Common questions</p><h2>Simple answers before you order.</h2><p>If you still have a question, add it to the order form or contact us directly.</p></div>
        <div class="homev3-faq-list" data-reveal data-reveal-delay="1">
          {faqs.map(([question, answer], index) => <details open={index === 0}><summary>{question}<span>+</span></summary><p>{answer}</p></details>)}
        </div>
      </div>
    </section>

    <section class="homev3-final">
      <div class="shell homev3-final-inner" data-reveal>
        <div><p class="homev3-overline">Ready to start?</p><h2>Send your order. We’ll find the right websites.</h2><p>Use the short order form or message Web Grouth on WhatsApp if you want to talk first.</p></div>
        <div class="homev3-final-actions"><a class="homev3-button homev3-button-white" href="/order">Place an Order <span>↗</span></a><a href="https://wa.me/923327810261" target="_blank" rel="noopener">Talk on WhatsApp</a></div>
      </div>
    </section>
  </div>
</BaseLayout>

