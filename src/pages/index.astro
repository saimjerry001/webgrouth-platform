---
import BaseLayout from '../layouts/BaseLayout.astro';
const services=[['↗','Guest posting','Place your brand in relevant publications with context, credibility, and a link that makes sense.','/guest-posting'],['⌁','SEO services','A practical search strategy built around technical clarity, useful content, and authority that compounds.','/seo-services'],['✦','Digital PR','Turn a strong idea into attention, mentions, and relationships with publishers that matter.','/contact']];
const faqs=[['What is guest posting?','Guest posting is publishing a useful, original article on another relevant website. Done well, it can introduce your brand to a new audience and earn a contextual mention.'],['Can I provide my own article?','Yes. You can send your own draft or ask about content support. We align the brief with the publication before anything goes live.'],['How long does publication take?','Timing depends on the publication and editorial queue. We share the expected window before the order is confirmed.'],['What niches are available?','Availability changes over time. Contact us with your category and target market so we can point you to relevant opportunities.']];
---
<BaseLayout><section class="hero"><div class="container hero-grid"><div class="reveal"><span class="eyebrow">Search authority, thoughtfully built</span><h1>Build authority.<br /><em>Earn attention.</em><br />Grow steadily.</h1><p class="lead">Web Grouth helps ambitious brands earn relevant visibility through guest posting, digital PR, and SEO that is built to last.</p><div class="hero-actions"><a class="button button-primary" href="/guest-posting">Explore guest posts <span>↗</span></a><a class="button button-quiet" href="/contact">Talk to our team</a></div><div class="hero-proof"><span class="proof-dots"><i></i><i></i><i></i></span><span>For brands, founders, and teams who value the long game.</span></div></div><div class="visual reveal"><div class="visual-panel"><div class="panel-top"><span>Authority dashboard</span><span>01 / 04</span></div><div class="panel-title">Make your next search result worth clicking.</div><div class="panel-line"></div><div class="panel-line short"></div><div class="chart"><i class="bar"></i><i class="bar"></i><i class="bar"></i><i class="bar"></i><i class="bar"></i><i class="bar"></i><i class="bar"></i></div></div><div class="floating-note"><strong>+ context</strong><span>not just another link</span></div></div></div></section><div class="trusted"><div class="container trust-row"><span>Guest posting</span><span>Link building</span><span>Content strategy</span><span>Digital PR</span><span>Organic growth</span></div></div><section class="section"><div class="container"><div class="section-head reveal"><div><span class="eyebrow">What we do</span><h2>Visibility with a point of view.</h2></div><p class="lead">The best placements do more than pass authority. They put your brand in the right conversation.</p></div><div class="grid-3">{services.map(([icon,title,text,href])=><a class="card reveal" href={href}><span class="icon">{icon}</span><h3>{title}</h3><p>{text}</p><span class="inline-link">Learn more ↗</span></a>)}</div></div></section><section class="section section-soft"><div class="container feature-band"><div class="reveal"><span class="eyebrow">Why Web Grouth</span><h2>Quality signals are still signals.</h2><p class="lead">We care about fit, editorial context, and the reader on the other side of every placement.</p><a class="button button-primary" href="/about">Meet the team <span>↗</span></a></div><ul class="check-list reveal"><li><span><strong>Relevant publishers</strong><br /><small>Choose context over volume with opportunities aligned to your niche.</small></span></li><li><span><strong>Transparent process</strong><br /><small>Know what you are ordering, why it fits, and what happens next.</small></span></li><li><span><strong>Content that earns its place</strong><br /><small>Useful, clear writing designed for people first and search second.</small></span></li><li><span><strong>No guaranteed-ranking claims</strong><br /><small>We build credible inputs, not promises no honest agency can make.</small></span></li></ul></div></section><section class="section"><div class="container"><div class="section-head reveal"><div><span class="eyebrow">A clear path forward</span><h2>From brief to live link, without the fog.</h2></div></div><div class="process">{[['01','Choose a direction','Tell us your niche, audience, and goal.'],['02','Match the opportunity','We surface a relevant publisher or outreach route.'],['03','Shape the story','Approve the brief, draft, and publication details.'],['04','Grow from there','Track what went live and build the next useful signal.']].map(([num,title,text])=><div class="process-item reveal"><span class="step">{num}</span><h3>{title}</h3><p>{text}</p></div>)}</div></div></section><section class="section section-soft"><div class="container"><div class="section-head reveal"><div><span class="eyebrow">Questions, answered</span><h2>Good growth starts with clarity.</h2></div></div><div class="grid-4">{faqs.map(([q,a])=><details class="card reveal"><summary>{q}</summary><p>{a}</p></details>)}</div></div></section><section class="container"><div class="cta-band reveal"><div><span class="eyebrow">Ready when you are</span><h2>Give your next great idea somewhere credible to land.</h2></div><a class="button button-quiet" href="/contact">Start a conversation <span>↗</span></a></div></section></BaseLayout>