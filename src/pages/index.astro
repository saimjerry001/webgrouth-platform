---
import BaseLayout from '../layouts/BaseLayout.astro';

const publisherSites = [
  { domain: 'news.guestpostnow.com', da: 57, dr: 71, traffic: '—' },
  { domain: 'programminginsider.com', da: 59, dr: 72, traffic: '—' },
  { domain: 'blogsandnews.com', da: 57, dr: 37, traffic: '—' },
  { domain: 'storifygo.com', da: 54, dr: 53, traffic: '—' },
  { domain: 'substack.com', da: 92, dr: 92, traffic: '—' },
  { domain: 'livepositively.com', da: 61, dr: 72, traffic: '—' },
  { domain: 'outdoorproject.com', da: 59, dr: 71, traffic: '—' },
  { domain: 'theomnibuzz.com', da: 59, dr: 62, traffic: '—' },
  { domain: 'bignewsnetwork.com', da: 66, dr: 76, traffic: '—' },
  { domain: 'fundly.com', da: 70, dr: 80, traffic: '—' },
] as const;

const services = [
  {
    number: '01',
    title: 'Guest Posting',
    text: 'Relevant editorial placements selected around your niche, target page and campaign goals.',
    points: ['Publisher shortlist before execution', 'Your content or our editorial support', 'Live URL and placement report'],
    href: '/order?service=Guest%20Posting',
  },
  {
    number: '02',
    title: 'Contextual Link Insertion',
    text: 'A natural mention added to an existing article where your resource genuinely supports the topic.',
    points: ['Existing-page relevance review', 'Anchor and destination approval', 'Clear placement terms'],
    href: '/order?service=Link%20Insertion',
  },
  {
    number: '03',
    title: 'Agency & Bulk Campaigns',
    text: 'A dependable fulfilment workflow for SEO teams managing recurring or multi-client orders.',
    points: ['Bulk publisher matching', 'Organised campaign tracking', 'Dedicated human support'],
    href: '/order?service=Bulk%20Guest%20Posting',
  },
] as const;

const categories = [
  ['SaaS & Technology', 'Software, AI, cybersecurity and digital products.'],
  ['Business & Finance', 'Companies, entrepreneurship, investing and professional services.'],
  ['Health & Wellness', 'Medical, fitness, nutrition and wellbeing publications.'],
  ['Home & Lifestyle', 'Home improvement, interiors, family and everyday living.'],
  ['Travel & Hospitality', 'Destinations, hotels, outdoor experiences and travel services.'],
  ['Marketing & Media', 'SEO, content, advertising, ecommerce and creator platforms.'],
  ['Education & Careers', 'Learning, training, hiring, remote work and career development.'],
  ['General & Multi-Niche', 'Broad publications for campaigns that need wider editorial reach.'],
] as const;

const standards = [
  ['Relevance first', 'The publication and article must make sense for the target page.'],
  ['Metrics in context', 'DA, DR and traffic support a decision; they do not replace editorial judgement.'],
  ['Terms before work', 'Link type, content, price and turnaround are confirmed before execution.'],
  ['Human communication', 'A real campaign manager reviews the brief and answers questions.'],
  ['Clean reporting', 'Every completed placement is returned with its live URL and agreed details.'],
  ['Ongoing support', 'Single orders and recurring agency campaigns follow the same clear process.'],
] as const;

const faqs = [
  ['Can I choose the publisher before placing the article?', 'Yes. Share your niche, metrics, country and budget. We will recommend suitable publishers and confirm the selected site before work begins.'],
  ['Can I provide my own article?', 'Yes. You can paste the article or upload a DOC, DOCX, PDF, TXT or RTF file on the order page. You can also request content support from Web Grouth.'],
  ['Do you handle single and bulk orders?', 'Yes. The same order form works for one placement, a publisher shortlist or a recurring agency campaign. Add the quantity and any client-specific requirements in the brief.'],
  ['When is payment required?', 'Eligible orders can be approved on a pay-after-live basis. The exact publisher, price and payment terms are confirmed in writing before execution.'],
] as const;
---

<BaseLayout title="Web Grouth | Editorial Guest Posts & Contextual Backlinks" description="Guest posting and contextual link placements across 40,000+ publisher websites, with human site matching, clear approval and live-link reporting.">
  <div class="homev3">
    <section class="homev3-hero">
      <div class="shell homev3-hero-grid">
        <div class="homev3-hero-copy" data-reveal>
          <p class="homev3-overline">Guest posting for brands & agencies</p>
          <h1>Editorial backlinks, <span>matched with purpose.</span></h1>
          <p class="homev3-lead">Web Grouth helps you place guest posts and contextual links on relevant publisher websites—without the spreadsheet chaos, unclear terms or anonymous support.</p>
          <div class="homev3-actions">
            <a class="homev3-button homev3-button-primary" href="/order">Place a Guest Post Order <span>↗</span></a>
            <a class="homev3-button homev3-button-secondary" href="#database">Explore Publisher Network</a>
          </div>
          <div class="homev3-assurance" aria-label="Service highlights">
            <span><i>✓</i> 40,000+ publishers</span>
            <span><i>✓</i> Single & bulk orders</span>
            <span><i>✓</i> Pay after eligible live delivery</span>
          </div>
        </div>

        <div class="homev3-network publisher-feed" data-reveal data-reveal-delay="1">
          <div class="homev3-network-top">
            <div><span class="homev3-live"></span><strong>Publisher network</strong></div>
            <span>Live inventory updates</span>
          </div>
          <div class="homev3-network-summary">
            <div><span>Available websites</span><strong>40,000+</strong></div>
            <div><span>Coverage</span><strong>30+ niches</strong></div>
          </div>
          <div class="publisher-feed-table">
            <div class="publisher-feed-head"><span>Website</span><span>DA</span><span>DR</span><span>Traffic</span></div>
            <div class="publisher-feed-viewport">
              <div class="publisher-feed-track">
                {[...publisherSites, ...publisherSites].map((site, index) =>
                  <div class="publisher-feed-row" aria-hidden={index >= publisherSites.length ? 'true' : undefined}>
                    <span><i>{site.domain.charAt(0).toUpperCase()}</i><b>{site.domain}</b></span>
                    <strong>{site.da}</strong><strong>{site.dr}</strong><em>{site.traffic}</em>
                  </div>
                )}
              </div>
            </div>
          </div>
          <div class="homev3-network-filters"><span>All niches</span><span>DA & DR reviewed</span><span>Traffic checked on request</span></div>
        </div>
      </div>
    </section>

    <section class="homev3-proof" aria-label="Web Grouth in numbers">
      <div class="shell homev3-proof-grid">
        <div class="homev3-proof-item"><strong>40,000+</strong><span>publisher websites across major categories</span></div>
        <div class="homev3-proof-item"><strong>5,000+</strong><span>client orders and campaign requests supported</span></div>
        <div class="homev3-proof-item"><strong>30+</strong><span>niches available for focused publisher matching</span></div>
        <div class="homev3-proof-item"><strong>1:1</strong><span>human support from brief to live-link report</span></div>
      </div>
    </section>

    <section class="homev3-section homev3-intro">
      <div class="shell homev3-intro-grid">
        <div class="homev3-section-title" data-reveal>
          <p class="homev3-overline">A clearer way to buy placements</p>
          <h2>Good link building starts before the link is placed.</h2>
        </div>
        <div class="homev3-intro-copy" data-reveal data-reveal-delay="1">
          <p>We begin with the page you want to grow, the audience you need to reach and the type of publication that can support both. That gives every shortlist a reason to exist beyond a high metric.</p>
          <div class="homev3-checks">
            <span>Human publisher matching</span><span>Site approval before publishing</span>
            <span>Anchor and target review</span><span>Clear live-link reporting</span>
          </div>
        </div>
      </div>
    </section>

    <section class="homev3-section homev3-services-section" id="services">
      <span id="pricing" class="anchor-target" aria-hidden="true"></span>
      <div class="shell">
        <div class="homev3-heading-row" data-reveal>
          <div><p class="homev3-overline">What we do</p><h2>One team for editorial link placement.</h2></div>
          <a href="/guest-posting">Explore guest posting <span>↗</span></a>
        </div>
        <div class="homev3-service-grid">
          {services.map((service, index) =>
            <article class="homev3-service-card" data-reveal data-reveal-delay={String(index)}>
              <span class="homev3-service-number">{service.number}</span>
              <h3>{service.title}</h3><p>{service.text}</p>
              <ul>{service.points.map((point) => <li><i>✓</i>{point}</li>)}</ul>
              <a href={service.href}>Start this order <span>↗</span></a>
            </article>
          )}
        </div>
      </div>
    </section>

    <section class="homev3-section homev3-categories-section" id="database">
      <div class="shell">
        <div class="homev3-centered" data-reveal>
          <p class="homev3-overline">Publisher coverage</p>
          <h2>A large network, narrowed to what actually fits.</h2>
          <p>Tell us the niche, target market and quality range. We will turn the wider inventory into a shortlist you can review.</p>
        </div>
        <div class="homev3-category-grid">
          {categories.map(([title, copy], index) =>
            <a class="homev3-category" href={`/order?service=Guest%20Posting&niche=${encodeURIComponent(title)}`} data-reveal data-reveal-delay={String(index % 4)}>
              <span>{String(index + 1).padStart(2, '0')}</span><h3>{title}</h3><p>{copy}</p>
            </a>
          )}
        </div>
      </div>
    </section>

    <section class="homev3-section homev3-process-section">
      <div class="shell homev3-process-layout">
        <div class="homev3-process-copy" data-reveal>
          <p class="homev3-overline">How an order moves</p>
          <h2>Four clear steps. No guessing.</h2>
          <p>Use one structured brief for a single site or a complete campaign. We keep the approval points visible.</p>
          <a class="homev3-button homev3-button-primary" href="/order">Open the Order Form <span>↗</span></a>
        </div>
        <div class="homev3-process-list" data-reveal data-reveal-delay="1">
          {[
            ['01', 'Share the brief', 'Add your website, niche, target URL, anchor, keywords and publisher preferences.'],
            ['02', 'Review the shortlist', 'We return suitable website options with the relevant placement details.'],
            ['03', 'Approve the work', 'Confirm the publisher, content direction, price and agreed terms.'],
            ['04', 'Receive the live URL', 'The completed placement is checked and delivered with a clear campaign record.'],
          ].map(([number, title, copy]) =>
            <article class="homev3-process-step"><span>{number}</span><div><h3>{title}</h3><p>{copy}</p></div></article>
          )}
        </div>
      </div>
    </section>

    <section class="homev3-experience">
      <div class="shell">
        <div class="homev3-experience-head" data-reveal>
          <div><p class="homev3-overline">Our working standard</p><h2>Built to feel like an extension of your team.</h2></div>
          <p>For direct clients and agencies, the best experience is organised, responsive and easy to verify.</p>
        </div>
        <div class="homev3-standard-grid">
          {standards.map(([title, copy], index) =>
            <article class="homev3-standard-card" data-reveal data-reveal-delay={String(index % 3)}><span>{String(index + 1).padStart(2,'0')}</span><strong>{title}</strong><p>{copy}</p></article>
          )}
        </div>
      </div>
    </section>

    <section class="homev3-section homev3-faq-section">
      <div class="shell homev3-faq-layout">
        <div class="homev3-process-copy" data-reveal><p class="homev3-overline">Before you order</p><h2>Useful answers, in plain English.</h2><p>Need something more specific? Send the brief and include the question in your requirements.</p></div>
        <div class="homev3-faq-list" data-reveal data-reveal-delay="1">
          {faqs.map(([question, answer], index) => <details open={index === 0}><summary>{question}<span>+</span></summary><p>{answer}</p></details>)}
        </div>
      </div>
    </section>

    <section class="homev3-final">
      <div class="shell homev3-final-inner" data-reveal>
        <div><p class="homev3-overline">Ready with your target URL?</p><h2>Send the brief. We’ll handle the publisher matching.</h2><p>Place the order online or message Web Grouth directly if you want to discuss the campaign first.</p></div>
        <div class="homev3-final-actions"><a class="homev3-button homev3-button-white" href="/order">Place an Order <span>↗</span></a><a href="https://wa.me/923327810261" target="_blank" rel="noopener">Talk on WhatsApp</a></div>
      </div>
    </section>
  </div>
</BaseLayout>
