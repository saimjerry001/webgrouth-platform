---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Order Received | Web Grouth" description="Your Web Grouth campaign brief has been submitted successfully.">
  <div class="saas-page success-wrap">
    <section class="success-card" data-reveal>
      <div class="success-icon">✓</div>
      <span class="saas-kicker">Order received</span>
      <h1>Your guest post order has been submitted.</h1>
      <p>Thank you. We have received your complete brief and will contact you at the email address you provided after reviewing the order details.</p>
      <div class="success-actions"><a class="saas-button primary" href="https://wa.me/923327810261?text=Hello%20Web%20Grouth%2C%20I%20have%20just%20submitted%20an%20order%20brief." target="_blank" rel="noopener">Continue on WhatsApp ↗</a><a class="saas-button secondary" href="/">Return home</a></div>
    </section>
  </div>
</BaseLayout>
