---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogOfferPopup from '../../components/BlogOfferPopup.astro';
import BlogImage from '../../components/BlogImage.astro';
import images from '../../generated/images.json';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const allPosts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const relatedPosts = allPosts.filter((item) => item.id !== post.id).slice(0, 3);
const movingPosts = [...relatedPosts, ...relatedPosts];
const sectionHeadings = headings.filter((heading) => heading.depth === 2);
const formattedDate = post.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
const articleUrl = `https://www.webgrouth.com/blog/${post.id}`;
const cover = images[post.data.image as keyof typeof images].fallback;
const modifiedDate = post.data.updatedDate ?? post.data.date;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${articleUrl}#article`,
  headline: post.data.title,
  description: post.data.description,
  url: articleUrl,
  mainEntityOfPage: { '@id': `${articleUrl}#webpage` },
  datePublished: post.data.date.toISOString(),
  dateModified: modifiedDate.toISOString(),
  articleSection: post.data.category,
  image: new URL(cover.src, 'https://www.webgrouth.com').toString(),
  author: post.data.author === 'Web Grouth'
    ? { '@type': 'Organization', '@id': 'https://www.webgrouth.com/#organization', name: 'Web Grouth', url: 'https://www.webgrouth.com/about' }
    : { '@type': 'Person', name: post.data.author },
  publisher: { '@type': 'Organization', '@id': 'https://www.webgrouth.com/#organization', name: 'Web Grouth', url: 'https://www.webgrouth.com/' },
  inLanguage: 'en',
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.webgrouth.com/' },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: 'https://www.webgrouth.com/blog' },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: articleUrl },
  ],
};
---

<BaseLayout title={`${post.data.title} | Web Grouth`} description={post.data.description} article={true} publishedTime={post.data.date.toISOString()} articleSection={post.data.category} modifiedTime={modifiedDate.toISOString()} image={post.data.image} imageAlt={`Cover image for ${post.data.title}`} structuredData={[articleSchema, breadcrumbSchema]}>
  <div class="article-page">
    <header class="article-masthead">
      <div class="shell article-masthead-inner" data-reveal>
        <div class="breadcrumbs"><a href="/">Home</a><span>/</span><a href="/blog">Journal</a><span>/</span><span>{post.data.category}</span></div>
        <span class="article-category">{post.data.category}</span>
        <h1>{post.data.title}</h1>
        <p>{post.data.description}</p>
        <div class="article-byline">
          <span class="article-author-mark">WG</span>
          <span><strong><a href="/about">{post.data.author}</a></strong><small><time datetime={post.data.date.toISOString()}>{formattedDate}</time> · {post.data.readTime}</small>{post.data.updatedDate && <small>Updated <time datetime={modifiedDate.toISOString()}>{modifiedDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time></small>}</span>
        </div>
      </div>
    </header>

    <div class="shell article-cover-wrap" data-reveal>
      <figure class="article-cover">
        <BlogImage src={post.data.image} alt={`Cover image for ${post.data.title}`} sizes="(max-width: 1200px) 100vw, 1200px" priority />
        <figcaption>Web Grouth Journal · Practical SEO guidance for worldwide campaigns</figcaption>
      </figure>
    </div>

    <div class="shell article-reading-layout">
      <article class="article-prose article-prose-new">
        <Content />
      </article>

      <aside class="article-sidebar" aria-label="Article sidebar">
        <div class="article-sidebar-inner">
          {sectionHeadings.length > 0 && (
            <nav class="article-toc" aria-label="On this page">
              <span>On this page</span>
              <ol>{sectionHeadings.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
            </nav>
          )}

          <section class="article-side-offer">
            <span>New client offer</span>
            <strong>$1 first guest post</strong>
            <p>Choose from selected websites. Approve the site first and pay after the link is live.</p>
            <a href="/order?service=First%20Guest%20Post&offer=1-dollar" data-journal-popup-open>Check availability <span>↗</span></a>
            <small>Selected websites only. Subject to approval and availability.</small>
          </section>

          <section class="article-side-latest">
            <span>Latest articles</span>
            {relatedPosts.map((item) => (
              <a href={`/blog/${item.id}`}>
                <BlogImage src={item.data.image} alt="" maxWidth={320} sizes="72px" />
                <span><strong>{item.data.title}</strong><small>{item.data.readTime}</small></span>
              </a>
            ))}
          </section>
        </div>
      </aside>
    </div>

    {relatedPosts.length > 0 && (
      <section class="article-related">
        <div class="shell journal-moving-head"><span>Read next</span><h2>More useful guides</h2></div>
        <div class="journal-moving-window">
          <div class="journal-moving-track">
            {movingPosts.map((item, index) => (
              <a class="journal-moving-card" href={`/blog/${item.id}`} aria-hidden={index >= relatedPosts.length ? 'true' : undefined} tabindex={index >= relatedPosts.length ? '-1' : undefined}>
                <BlogImage src={item.data.image} alt="" maxWidth={640} sizes="180px" />
                <span><small>{item.data.category}</small><strong>{item.data.title}</strong><em>{item.data.readTime}</em></span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="article-final-cta">
      <div class="shell article-final-inner" data-reveal>
        <div><span>Ready to build your campaign?</span><h2>Send the brief. Review the websites. Pay after the link is live.</h2></div>
        <a href="/order">Place an order <span>↗</span></a>
      </div>
    </section>
  </div>
  <BlogOfferPopup />
</BaseLayout>

