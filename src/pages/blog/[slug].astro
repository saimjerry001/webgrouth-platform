---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogOfferPopup from '../../components/BlogOfferPopup.astro';
import BlogImage from '../../components/BlogImage.astro';
import BlogPostRail from '../../components/BlogPostRail.astro';
import '../../styles/journal.css';
import images from '../../generated/images.json';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const allPosts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const relatedPosts = allPosts.filter((item) => item.id !== post.id).slice(0, 3);
const sectionHeadings = headings.filter((heading) => heading.depth === 2);
const formattedDate = post.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
const articleUrl = `https://www.webgrouth.com/blog/${post.id}`;
const cover = images[post.data.image as keyof typeof images].fallback;
const modifiedDate = post.data.updatedDate ?? post.data.date;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${articleUrl}#article`,
  headline: post.data.title,
  description: post.data.description,
  url: articleUrl,
  mainEntityOfPage: { '@id': `${articleUrl}#webpage` },
  datePublished: post.data.date.toISOString(),
  dateModified: modifiedDate.toISOString(),
  articleSection: post.data.category,
  image: new URL(cover.src, 'https://www.webgrouth.com').toString(),
  author: post.data.author === 'Web Grouth'
    ? { '@type': 'Organization', '@id': 'https://www.webgrouth.com/#organization', name: 'Web Grouth', url: 'https://www.webgrouth.com/about' }
    : { '@type': 'Person', name: post.data.author },
  publisher: { '@type': 'Organization', '@id': 'https://www.webgrouth.com/#organization', name: 'Web Grouth', url: 'https://www.webgrouth.com/' },
  inLanguage: 'en',
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.webgrouth.com/' },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: 'https://www.webgrouth.com/blog' },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: articleUrl },
  ],
};
---

<BaseLayout title={`${post.data.title} | Web Grouth`} description={post.data.description} article={true} publishedTime={post.data.date.toISOString()} articleSection={post.data.category} modifiedTime={modifiedDate.toISOString()} image={post.data.image} imageAlt={`Cover image for ${post.data.title}`} structuredData={[articleSchema, breadcrumbSchema]}>
  <div class="wg-blog-theme wg-blog-article">
    <div class="shell wg-blog-shell">
      <nav class="wg-blog-breadcrumbs" aria-label="Breadcrumbs">
        <a href="/">Home</a><span aria-hidden="true">/</span><a href="/blog">Blog</a><span aria-hidden="true">/</span><span>{post.data.category}</span>
      </nav>

      <div class="wg-article-layout">
        <article class="wg-article-main">
          <header class="wg-article-heading">
            <span class="wg-blog-category">{post.data.category}</span>
            <h1>{post.data.title}</h1>
            <p>{post.data.description}</p>
            <div class="wg-article-byline">
              <span class="wg-article-author-mark" aria-hidden="true">WG</span>
              <div>
                <a href="/about">{post.data.author}</a>
                <div class="wg-article-dates">
                  <time datetime={post.data.date.toISOString()}>{formattedDate}</time>
                  <span aria-hidden="true">·</span><span>{post.data.readTime}</span>
                </div>
                {post.data.updatedDate && <small>Updated <time datetime={modifiedDate.toISOString()}>{modifiedDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time></small>}
              </div>
            </div>
          </header>

          <figure class="wg-article-cover">
            <BlogImage src={post.data.image} alt={`Cover image for ${post.data.title}`} maxWidth={1280} sizes="(max-width: 960px) calc(100vw - 40px), (max-width: 1160px) calc(100vw - 352px), 808px" priority />
          </figure>

          <div class="wg-article-body">
            <Content />
          </div>
        </article>

        <aside class="wg-blog-sidebar wg-article-sidebar" aria-label="Article navigation and resources" tabindex="0">
          {sectionHeadings.length > 0 && (
            <nav class="wg-article-toc" aria-labelledby="article-contents-heading">
              <h2 id="article-contents-heading">On this page</h2>
              <ol>{sectionHeadings.map(heading => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
            </nav>
          )}

          <section class="wg-blog-offer">
            <span class="wg-blog-eyebrow">New client offer</span>
            <h2>Your first guest post for $1.</h2>
            <p>Review selected website options and pay after your link is live.</p>
            <a class="wg-blog-button" href="/order?service=First%20Guest%20Post&offer=1-dollar" data-journal-popup-open>Check availability</a>
            <small>Selected websites only. Subject to approval and availability.</small>
          </section>

          {relatedPosts.length > 0 && (
            <section class="wg-article-latest">
              <h2>Latest articles</h2>
              {relatedPosts.map(item => (
                <a href={`/blog/${item.id}`}>
                  <BlogImage src={item.data.image} alt="" maxWidth={320} sizes="72px" />
                  <span><strong>{item.data.title}</strong><small>{item.data.readTime}</small></span>
                </a>
              ))}
            </section>
          )}
        </aside>
      </div>
    </div>

    <BlogPostRail posts={relatedPosts} title="Related articles" id="article-reading-rail" />

    <section class="wg-blog-cta" aria-labelledby="article-order-heading">
      <div class="shell wg-blog-shell wg-blog-cta-inner">
        <div><h2 id="article-order-heading">Need help choosing a website?</h2><p>Share your niche and budget. We’ll send you relevant options.</p></div>
        <a class="wg-blog-button" href="/order">Place an order</a>
      </div>
    </section>
  </div>
  <BlogOfferPopup />
</BaseLayout>
