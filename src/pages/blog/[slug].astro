---
// src/pages/blog/[slug].astro

// Dynamic routing function for Astro static builds
export async function getStaticPaths() {
  return [
    { 
      params: { slug: 'pbns-vs-editorial-backlinks' }, 
      props: { 
        title: 'PBNs vs. Editorial Backlinks: Why the Difference Matters', 
        date: 'August 15, 2026', 
        category: 'Link Building', 
        readTime: '5 min read',
        image: 'https://images.unsplash.com/photo-1432821596592-e2c18b78144f?w=1200&q=80',
        content: 'Understand the critical difference between spammy private networks and real contextual placements for Google ranking success. Private Blog Networks (PBNs) represent a massive risk in modern SEO. Search engines are smarter than ever before and can easily detect shared hosting footprint patterns, static outbound links, and artificially pumped domain metrics. This guide details how you can stay safe by earning backlinks hosted purely inside original editorial pieces on real business websites.'
      } 
    },
    { 
      params: { slug: 'how-to-vette-guest-post-sites' }, 
      props: { 
        title: 'How to Vette a Guest Posting Site for Real Organic Traffic', 
        date: 'August 10, 2026', 
        category: 'SEO Strategy', 
        readTime: '7 min read',
        image: 'https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=1200&q=80',
        content: 'Stop paying for dummy domain authority metrics. Learn our detailed framework to identify publishers with genuine organic visitors. Most links you buy online are on sites with fake metrics created through artificial backlink loops. Our vetting framework focuses purely on real search traffic trends, continuous organic ranking keywords, and actual user engagement. By analyzing active indexation stats and verifying that the host site has real editorial standards, we ensure your backlink transfers maximum juice.'
      } 
    },
    { 
      params: { slug: 'ultimate-guide-contextual-links' }, 
      props: { 
        title: 'The Ultimate Guide to Contextual Link Building', 
        date: 'August 05, 2026', 
        category: 'Case Studies', 
        readTime: '9 min read',
        image: 'https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=1200&q=80',
        content: 'Our complete roadmap to gaining high-impact contextual links that search bots trust and reward instantly. Contextual link building is not about securing thousands of random directory directory profile mentions. It is about inserting your brand naturally inside the ongoing dialogue of an authoritative article. When a high-traffic host site naturally mentions your brand name and links to your helpful guide as a resource, search crawlers pass maximum authority. Read our full case study to see how we achieved top positions for our SaaS partners.'
      } 
    }
  ];
}

const { slug } = Astro.params;
const { title, date, category, readTime, image, content } = Astro.props;
---
<!DOCTYPE html>
<html lang="ur">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | Web Grouth Blog</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <style is:inline>
    * { margin:0; padding:0; box-sizing:border-box; }
    html { scroll-behavior:smooth; }
    body {
      font-family:'Plus Jakarta Sans', sans-serif;
      background:#ffffff;
      color:#0f172a;
      line-height:1.75;
    }
    .container { max-width:900px; margin:0 auto; padding:0 24px; }
    a { text-decoration:none; color:inherit; }
    h1,h2,h3,h4 { font-family:'Outfit',sans-serif; letter-spacing:-0.03em; font-weight:700; }
    
    /* ===== HEADER ===== */
    .header {
      position:fixed; top:0; left:0; width:100%; z-index:1000;
      background:rgba(255,255,255,.78); backdrop-filter:blur(16px); -webkit-backdrop-filter:blur(16px);
      border-bottom:1px solid rgba(15,23,42,.06); padding:14px 0;
    }
    .header-inner { display:flex; justify-content:space-between; align-items:center; }
    .logo { display:flex; align-items:center; gap:10px; font-size:1.55rem; font-weight:800; color:#0f172a; }
    .logo-mark {
      width:38px; height:38px; border-radius:11px;
      background:linear-gradient(135deg,#2563eb,#1d4ed8);
      display:flex; align-items:center; justify-content:center;
      box-shadow:0 6px 16px rgba(37,99,235,.35); flex-shrink:0;
    }
    .logo-mark svg { width:22px; height:22px; }
    .logo span { background:linear-gradient(135deg,#2563eb,#1d4ed8); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }
    .nav-links { display:flex; align-items:center; gap:32px; }
    .nav-links a:not(.btn-nav) { font-weight:600; color:#334155; transition:.2s; font-size:.95rem; }
    .nav-links a:not(.btn-nav):hover { color:#2563eb; }
    .nav-links .btn-nav {
      background:#2563eb; color:#fff !important; padding:11px 28px; border-radius:40px; font-weight:700;
      transition:.3s; box-shadow:0 6px 18px rgba(37,99,235,.25);
    }
    .hamburger { display:none; flex-direction:column; gap:5px; cursor:pointer; padding:6px; }
    .hamburger span { width:26px; height:3px; background:#0f172a; border-radius:3px; transition:.3s; }

    /* ===== POST CONTENT ===== */
    .post-wrapper { padding:160px 0 100px; }
    .post-badge { background:#eff6ff; color:#2563eb; padding:6px 14px; border-radius:40px; font-size:0.8rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; display:inline-block; margin-bottom:20px; }
    .post-wrapper h1 { font-size:3rem; line-height:1.2; margin-bottom:20px; color:#0f172a; }
    .post-meta { display:flex; gap:20px; color:#64748b; font-size:0.9rem; font-weight:600; margin-bottom:34px; }
    .post-image-box { border-radius:28px; overflow:hidden; margin-bottom:40px; box-shadow:0 20px 50px rgba(15,23,42,0.06); }
    .post-image-box img { width:100%; max-height:450px; object-fit:cover; display:block; }
    .post-body { font-size:1.1rem; color:#334155; line-height:1.8; }
    .post-body p { margin-bottom:24px; }
    
    /* Author Box */
    .author-box { display:flex; gap:24px; background:#f8fafc; border-radius:24px; padding:35px; border:1px solid #e2e8f0; margin-top:60px; align-items:center; }
    .author-img { width:70px; height:70px; border-radius:50%; object-fit:cover; border:2px solid #2563eb; }
    .author-info h4 { font-size:1.2rem; color:#0f172a; margin-bottom:4px; }
    .author-info p { font-size:0.95rem; color:#475569; line-height:1.5; }

    /* ===== FOOTER ===== */
    .footer { background:#fff; border-top:1px solid #f1f5f9; padding:64px 0 30px; }
    .footer-grid { display:grid; grid-template-columns:2fr 1fr 1fr 1.5fr; gap:40px; margin-bottom:40px; }
    .footer-brand p { color:#64748b; max-width:280px; font-size:.95rem; margin-top:14px; }
    .footer-col h4 { font-size:1rem; font-weight:700; margin-bottom:16px; }
    .footer-col ul { list-style:none; }
    .footer-col ul li { margin-bottom:10px; }
    .footer-col ul li a { color:#64748b; transition:.2s; font-size:.95rem; }
    .footer-col ul li a:hover { color:#2563eb; }
    .footer-bottom { border-top:1px solid #f1f5f9; padding-top:24px; text-align:center; color:#94a3b8; font-size:.9rem; }

    @media (max-width: 992px) {
      .footer-grid { grid-template-columns:1fr 1fr; }
    }
    @media (max-width: 768px) {
      .nav-links {
        display:none; flex-direction:column; background:rgba(255,255,255,.98); position:absolute; top:70px; left:0;
        width:100%; padding:30px 24px; gap:20px; border-bottom:1px solid #f1f5f9; box-shadow:0 10px 30px rgba(0,0,0,0.05);
      }
      .nav-links.open { display:flex; }
      .hamburger { display:flex; }
      .post-wrapper h1 { font-size:2.2rem; }
      .author-box { flex-direction:column; text-align:center; }
      .footer-grid { grid-template-columns:1fr; text-align:center; }
    }
  </style>
</head>
<body>

  <!-- HEADER -->
  <header class="header" id="header">
    <div class="container header-inner">
      <div class="logo">
        <a href="/" style="display:flex; align-items:center; gap:10px;">
          <div class="logo-mark">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <linearGradient id="logo-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#ffffff" /><stop offset="100%" stop-color="#93c5fd" />
                </linearGradient>
              </defs>
              <path d="M4 20L12 12L16 16L22 8" stroke="url(#logo-grad)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M17 8H22V13" stroke="url(#logo-grad)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
              <circle cx="4" cy="20" r="2.2" fill="#ffffff" /><circle cx="12" cy="12" r="2.2" fill="#ffffff" /><circle cx="16" cy="16" r="2.2" fill="#ffffff" /><circle cx="22" cy="8" r="2.2" fill="#ffffff" />
            </svg>
          </div>
          Web<span>Grouth</span>
        </a>
      </div>
      <nav class="nav-links" id="navLinks">
        <a href="/">Home</a>
        <a href="/#services">Services</a>
        <a href="/#pricing">Pricing</a>
        <a href="/about">About</a>
        <a href="/blog">Blog</a>
        <a href="/contact">Contact</a>
        <a href="/contact" class="btn-nav">Get Started</a>
      </nav>
      <div class="hamburger" id="hamburger"><span></span><span></span><span></span></div>
    </div>
  </header>

  <!-- POST ARTICLE -->
  <article class="post-wrapper">
    <div class="container">
      <span class="post-badge">{category}</span>
      <h1>{title}</h1>
      <div class="post-meta">
        <span><i class="far fa-calendar"></i> {date}</span>
        <span><i class="far fa-clock"></i> {readTime}</span>
      </div>
      <div class="post-image-box">
        <img src={image} alt={title} />
      </div>
      <div class="post-body">
        <p>{content}</p>
        <p>Additionally, search relevance is boosted when you focus purely on context. It is not about acquiring hundreds of random backlinks from unrelated directories. True search engine trust is created when Google's crawlers find your domain mentioned inside high-quality, relevant content that is already indexed and ranking.</p>
        <p>By employing custom vetting metrics and rejecting Private Blog Networks, Web Grouth ensures that your site achieves long-term, white-hat growth that stands firm against future Google Core updates.</p>
      </div>

      <!-- Author Bio -->
      <div class="author-box">
        <img class="author-img" src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80" alt="Nasir Haider" />
        <div class="author-info">
          <h4>Nasir Haider SEO</h4>
          <p>Founder & SEO Link Building Consultant at Web Grouth. Specialist in high-authority contextual links, guest posting, and semantic content architecture.</p>
        </div>
      </div>
    </div>
  </article>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <div class="logo" style="font-size:1.55rem;">
            <div class="logo-mark">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <defs>
                  <linearGradient id="logo-grad-f" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#ffffff" /><stop offset="100%" stop-color="#93c5fd" />
                  </linearGradient>
                </defs>
                <path d="M4 20L12 12L16 16L22 8" stroke="url(#logo-grad-f)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M17 8H22V13" stroke="url(#logo-grad-f)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                <circle cx="4" cy="20" r="2.2" fill="#ffffff" /><circle cx="12" cy="12" r="2.2" fill="#ffffff" /><circle cx="16" cy="16" r="2.2" fill="#ffffff" /><circle cx="22" cy="8" r="2.2" fill="#ffffff" />
              </svg>
            </div>
            Web<span>Grouth</span>
          </div>
          <p>We help brands earn relevant guest posts and contextual backlinks through vetted publishers — built for relevance, not volume.</p>
        </div>
        <div class="footer-col">
          <h4>Services</h4>
          <ul>
            <li><a href="/#services">Guest Posting</a></li>
            <li><a href="/#services">Backlink Building</a></li>
            <li><a href="/#services">SEO Strategy</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Quick Links</h4>
          <ul>
            <li><a href="/#pricing">Pricing</a></li>
            <li><a href="/about">About Us</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Connect</h4>
          <ul>
            <li><a href="mailto:nasirhaiderseo@gmail.com"><i class="fas fa-envelope"></i> nasirhaiderseo@gmail.com</a></li>
            <li><a href="https://wa.me/923327810261" target="_blank"><i class="fab fa-whatsapp"></i> +92 332 7810261</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">&copy; 2026 Web Grouth. All rights reserved.</div>
    </div>
  </footer>

  <script is:inline>
    const hamburger = document.getElementById('hamburger');
    const navLinks = document.getElementById('navLinks');
    hamburger.addEventListener('click', () => navLinks.classList.toggle('open'));
  </script>
</body>
</html>
