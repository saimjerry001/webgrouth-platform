---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Web Grouth | High-DR Backlinks & Guest Posts Marketplace',
  description = 'Web Grouth is the premium B2B marketplace where brands, SaaS founders, and digital marketers buy high-DR backlinks and guest posts on sites with real organic traffic and topical authority.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2563eb" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
      integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[80] focus:rounded-lg focus:bg-brand-600 focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>

    <header
      id="site-header"
      class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/80 backdrop-blur-xl"
    >
      <div class="mx-auto flex h-14 max-w-7xl items-center justify-between px-4 sm:h-[4.25rem] sm:px-6 lg:px-8">
        <a href="/" class="flex items-center gap-2.5" aria-label="Web Grouth home">
          <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-brand-600 shadow-glass">
            <svg class="h-5 w-5 text-white" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M4 16l5-6 4 4 7-9" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </span>
          <span class="text-[1.05rem] font-extrabold tracking-tight text-slate-900 sm:text-lg">
            Web <span class="text-brand-600">Grouth</span>
          </span>
        </a>

        <nav class="hidden items-center gap-8 text-sm font-semibold text-slate-600 lg:flex" aria-label="Primary">
          <a href="#marketplace" class="transition hover:text-brand-700">Marketplace</a>
          <a href="#how-it-works" class="transition hover:text-brand-700">How it works</a>
          <a href="#publishers" class="transition hover:text-brand-700">Publishers</a>
          <a href="#pricing" class="transition hover:text-brand-700">Pricing</a>
          <a href="#reviews" class="transition hover:text-brand-700">Reviews</a>
        </nav>

        <div class="hidden items-center gap-3 lg:flex">
          <a href="#login" class="text-sm font-semibold text-slate-600 transition hover:text-brand-700">Sign in</a>
          <a
            href="#marketplace"
            class="rounded-full bg-brand-600 px-4 py-2.5 text-sm font-bold text-white shadow-glass transition hover:bg-brand-700"
          >
            Browse Marketplace
          </a>
        </div>

        <button
          id="menu-toggle"
          type="button"
          class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-800 lg:hidden"
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label="Open navigation menu"
        >
          <i class="fa-solid fa-bars text-lg" aria-hidden="true"></i>
        </button>
      </div>

      <div id="mobile-menu" class="grid max-h-0 overflow-hidden transition-[max-height] duration-300 ease-out lg:hidden">
        <nav class="space-y-1 border-t border-slate-200 bg-white px-4 py-3 sm:px-6" aria-label="Mobile">
          <a href="#marketplace" class="mobile-link block rounded-lg px-3 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">Marketplace</a>
          <a href="#how-it-works" class="mobile-link block rounded-lg px-3 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">How it works</a>
          <a href="#publishers" class="mobile-link block rounded-lg px-3 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">Publishers</a>
          <a href="#pricing" class="mobile-link block rounded-lg px-3 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">Pricing</a>
          <a href="#reviews" class="mobile-link block rounded-lg px-3 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">Reviews</a>
          <a href="#login" class="mobile-link block rounded-lg px-3 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">Sign in</a>
          <a
            href="#marketplace"
            class="mobile-link mt-2 block rounded-full bg-brand-600 px-4 py-3 text-center text-sm font-bold text-white"
          >
            Browse Marketplace
          </a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="border-t border-slate-200 bg-white">
      <div class="mx-auto grid max-w-7xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-4 lg:px-8">
        <div class="md:col-span-1">
          <a href="/" class="flex items-center gap-2.5">
            <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-brand-600">
              <svg class="h-5 w-5 text-white" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M4 16l5-6 4 4 7-9" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </span>
            <span class="font-extrabold tracking-tight">Web Grouth</span>
          </a>
          <p class="mt-4 text-sm leading-6 text-slate-600">
            The premium marketplace for high-DR backlinks and guest posts, built for brands, SaaS founders, and digital marketers who care about real traffic and topical authority.
          </p>
        </div>
        <div>
          <h2 class="text-sm font-bold text-slate-900">Product</h2>
          <ul class="mt-4 space-y-2 text-sm text-slate-600">
            <li><a href="#marketplace" class="hover:text-brand-700">Browse Marketplace</a></li>
            <li><a href="#how-it-works" class="hover:text-brand-700">How it works</a></li>
            <li><a href="#pricing" class="hover:text-brand-700">Pricing</a></li>
            <li><a href="#publishers" class="hover:text-brand-700">Publisher quality</a></li>
          </ul>
        </div>
        <div>
          <h2 class="text-sm font-bold text-slate-900">Trust</h2>
          <ul class="mt-4 space-y-2 text-sm text-slate-600">
            <li><a href="#reviews" class="hover:text-brand-700">Verified reviews</a></li>
            <li><a href="#faq" class="hover:text-brand-700">FAQ</a></li>
            <li><a href="#quality" class="hover:text-brand-700">Quality standards</a></li>
            <li><a href="mailto:hello@webgrouth.com" class="hover:text-brand-700">hello@webgrouth.com</a></li>
          </ul>
        </div>
        <div>
          <h2 class="text-sm font-bold text-slate-900">Legal</h2>
          <ul class="mt-4 space-y-2 text-sm text-slate-600">
            <li>Brand-safe placements only</li>
            <li>No PBNs, no traffic spoofing</li>
            <li>DR and traffic verified before listing</li>
            <li>United States &amp; global markets</li>
          </ul>
        </div>
      </div>
      <div class="border-t border-slate-200 py-5 text-center text-xs text-slate-500">
        © {new Date().getFullYear()} Web Grouth. All rights reserved.
      </div>
    </footer>

    <script is:inline>
      (function () {
        var toggle = document.getElementById('menu-toggle');
        var menu = document.getElementById('mobile-menu');
        if (toggle && menu) {
          toggle.addEventListener('click', function () {
            var open = toggle.getAttribute('aria-expanded') === 'true';
            toggle.setAttribute('aria-expanded', String(!open));
            toggle.setAttribute('aria-label', open ? 'Open navigation menu' : 'Close navigation menu');
            toggle.innerHTML = open
              ? '<i class="fa-solid fa-bars text-lg" aria-hidden="true"></i>'
              : '<i class="fa-solid fa-xmark text-lg" aria-hidden="true"></i>';
            menu.style.maxHeight = open ? '0px' : menu.scrollHeight + 'px';
          });
          menu.querySelectorAll('.mobile-link').forEach(function (link) {
            link.addEventListener('click', function () {
              toggle.setAttribute('aria-expanded', 'false');
              toggle.setAttribute('aria-label', 'Open navigation menu');
              toggle.innerHTML = '<i class="fa-solid fa-bars text-lg" aria-hidden="true"></i>';
              menu.style.maxHeight = '0px';
            });
          });
        }

        var typedEl = document.getElementById('typed-text');
        if (typedEl) {
          var phrases = [
            'high-DR publications',
            'real organic traffic',
            'topical authority',
            'verified guest posts',
          ];
          var phraseIndex = 0;
          var charIndex = 0;
          var deleting = false;

          function typeLoop() {
            var current = phrases[phraseIndex];
            typedEl.textContent = current.slice(0, charIndex);
            if (!deleting && charIndex < current.length) {
              charIndex += 1;
              setTimeout(typeLoop, 70);
            } else if (!deleting && charIndex === current.length) {
              deleting = true;
              setTimeout(typeLoop, 1400);
            } else if (deleting && charIndex > 0) {
              charIndex -= 1;
              setTimeout(typeLoop, 38);
            } else {
              deleting = false;
              phraseIndex = (phraseIndex + 1) % phrases.length;
              setTimeout(typeLoop, 220);
            }
          }
          typeLoop();
        }

        var proofTrack = document.getElementById('proof-track');
        var proofDots = document.querySelectorAll('[data-proof-dot]');
        if (proofTrack && proofDots.length) {
          var proofIndex = 0;
          var proofTotal = proofDots.length;
          function showProof(i) {
            proofIndex = (i + proofTotal) % proofTotal;
            proofTrack.style.transform = 'translateX(-' + proofIndex * 100 + '%)';
            proofDots.forEach(function (dot, idx) {
              dot.classList.toggle('bg-brand-600', idx === proofIndex);
              dot.classList.toggle('bg-slate-300', idx !== proofIndex);
            });
          }
          proofDots.forEach(function (dot, idx) {
            dot.addEventListener('click', function () {
              showProof(idx);
            });
          });
          setInterval(function () {
            showProof(proofIndex + 1);
          }, 4200);
        }

        var reviewTrack = document.getElementById('review-track');
        var reviewDots = document.querySelectorAll('[data-review-dot]');
        var prevBtn = document.getElementById('review-prev');
        var nextBtn = document.getElementById('review-next');
        if (reviewTrack && reviewDots.length) {
          var reviewIndex = 0;
          var reviewTotal = reviewDots.length;
          function showReview(i) {
            reviewIndex = (i + reviewTotal) % reviewTotal;
            reviewTrack.style.transform = 'translateX(-' + reviewIndex * 100 + '%)';
            reviewDots.forEach(function (dot, idx) {
              dot.classList.toggle('bg-brand-600', idx === reviewIndex);
              dot.classList.toggle('bg-slate-300', idx !== reviewIndex);
            });
          }
          if (prevBtn) prevBtn.addEventListener('click', function () { showReview(reviewIndex - 1); });
          if (nextBtn) nextBtn.addEventListener('click', function () { showReview(reviewIndex + 1); });
          reviewDots.forEach(function (dot, idx) {
            dot.addEventListener('click', function () { showReview(idx); });
          });
          setInterval(function () { showReview(reviewIndex + 1); }, 6500);
        }
      })();
    </script>
  </body>
</html>
