---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/v4.css';
import { SITE_URL, canonicalUrl, jsonLd, breadcrumb } from '../lib/seo';
import { seoPages } from '../data/seo-pages';
import images from '../generated/images.json';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  article?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  image?: string;
  imageAlt?: string;
  articleSection?: string;
  articleTags?: string[];
  noindex?: boolean;
  pageType?: 'WebPage' | 'AboutPage' | 'ContactPage' | 'CollectionPage';
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'Worldwide Guest Posting Services | Web Grouth',
  description = 'Get relevant guest posts and contextual link insertions worldwide, with clear publisher approval and live-link reporting.',
  canonical,
  article = false,
  publishedTime,
  modifiedTime,
  image = '/images/webgrouth-publishing.png',
  imageAlt = 'Web Grouth guest posting and publishing services',
  articleSection,
  articleTags = [],
  noindex = false,
  pageType = 'WebPage',
  structuredData = [],
} = Astro.props;
const siteUrl = SITE_URL;
const url = canonicalUrl(canonical ?? Astro.url.pathname);
const isPreview = import.meta.env.VERCEL_ENV === 'preview';
const socialImage = images[image as keyof typeof images]?.fallback;
const imageUrl = new URL(socialImage?.src ?? image, siteUrl).toString();
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION?.trim();
const bingVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION?.trim();
const robots = noindex || isPreview
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
const baseSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: 'Web Grouth',
      url: siteUrl,
      logo: `${siteUrl}/favicon.svg`,
      email: 'nasirhaiderseo@gmail.com',
      telephone: '+923327810261',
      founder: { '@type': 'Person', name: 'Nasir Haider', url: `${siteUrl}/about#founder` },
      areaServed: 'Worldwide',
      knowsAbout: ['Guest posting', 'Contextual link insertion', 'Off-page SEO', 'Link building'],
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'sales and customer support',
        email: 'nasirhaiderseo@gmail.com',
        telephone: '+923327810261',
        url: `${siteUrl}/contact`,
        availableLanguage: ['English', 'Urdu'],
        areaServed: 'Worldwide',
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: siteUrl,
      name: 'Web Grouth',
      publisher: { '@id': `${siteUrl}/#organization` },
      inLanguage: 'en',
    },
    {
      '@type': pageType,
      '@id': `${url}#webpage`,
      url,
      name: title,
      description,
      isPartOf: { '@id': `${siteUrl}/#website` },
      about: { '@id': `${siteUrl}/#organization` },
      inLanguage: 'en',
      primaryImageOfPage: { '@type': 'ImageObject', url: imageUrl },
    },
  ],
};
const extraSchema = Array.isArray(structuredData) ? [...structuredData] : [structuredData];
const currentPage = seoPages.find(page => canonicalUrl(page.path) === url);
if (currentPage && currentPage.path !== '/' && !noindex && !extraSchema.some(schema => schema['@type'] === 'BreadcrumbList')) {
  extraSchema.push(breadcrumb(currentPage.path, currentPage.name));
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    {googleVerification && !isPreview && <meta name="google-site-verification" content={googleVerification} />}
    {bingVerification && !isPreview && <meta name="msvalidate.01" content={bingVerification} />}
    <meta name="theme-color" content="#0B1220" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={url} />
    <link rel="alternate" hreflang="en" href={url} />
    <link rel="alternate" hreflang="x-default" href={url} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Web Grouth Journal" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content="Web Grouth" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    {socialImage && <meta property="og:image:width" content={socialImage.width} />}
    {socialImage && <meta property="og:image:height" content={socialImage.height} />}
    {article && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {article && articleSection && <meta property="article:section" content={articleSection} />}
    {article && articleTags.map(tag => <meta property="article:tag" content={tag} />)}
    {article && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={jsonLd(baseSchema)}></script>
    {extraSchema.map((schema) => <script type="application/ld+json" set:html={jsonLd(schema)}></script>)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="ambient ambient-one" aria-hidden="true"></div>
    <div class="ambient ambient-two" aria-hidden="true"></div>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <aside class="wg4-toast" data-toast aria-label="Need help?" hidden>
      <span class="wg4-toast-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 9.2 9.2 0 0 1-3.8-.9L3 20.5l1.5-5a8.3 8.3 0 1 1 16.5-4Z"/></svg></span>
      <div class="wg4-toast-copy"><strong>Need help choosing websites?</strong><span>Tell us your niche. We reply on WhatsApp.</span><a href="https://wa.me/923327810261" target="_blank" rel="noopener">Chat on WhatsApp ↗</a></div>
      <button type="button" class="wg4-toast-close" aria-label="Close" data-toast-close>×</button>
    </aside>
    <script is:inline>
      const header = document.querySelector('[data-header]');
      const menuButton = document.querySelector('[data-menu-button]');
      const mobileMenu = document.querySelector('[data-mobile-menu]');
      const setHeader = () => header?.classList.toggle('scrolled', window.scrollY > 18);
      setHeader();
      window.addEventListener('scroll', setHeader, { passive: true });
      menuButton?.addEventListener('click', () => {
        const open = menuButton.getAttribute('aria-expanded') === 'true';
        menuButton.setAttribute('aria-expanded', String(!open));
        mobileMenu?.classList.toggle('open', !open);
        document.body.classList.toggle('menu-open', !open);
      });
      mobileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
        menuButton?.setAttribute('aria-expanded', 'false');
        mobileMenu?.classList.remove('open');
        document.body.classList.remove('menu-open');
      }));

      const revealItems = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.remove('reveal-pending');
              entry.target.classList.add('revealed');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: .12, rootMargin: '0px 0px -40px' });
        revealItems.forEach((item) => {
          if (item.getBoundingClientRect().top > window.innerHeight && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            item.classList.add('reveal-pending');
          }
          observer.observe(item);
        });
      } else {
        revealItems.forEach((item) => item.classList.add('revealed'));
      }

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const counters = document.querySelectorAll('[data-count]');
      const runCount = (el) => {
        const target = Number(el.dataset.count);
        const suffix = el.dataset.suffix || '';
        if (reduceMotion) { el.textContent = target.toLocaleString('en-US') + suffix; return; }
        const start = performance.now();
        const step = (now) => {
          const p = Math.min((now - start) / 1600, 1);
          const eased = 1 - Math.pow(1 - p, 3);
          el.textContent = Math.round(target * eased).toLocaleString('en-US') + suffix;
          if (p < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      };
      if ('IntersectionObserver' in window) {
        const countObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => { if (entry.isIntersecting) { runCount(entry.target); countObserver.unobserve(entry.target); } });
        }, { threshold: .4 });
        counters.forEach((el) => countObserver.observe(el));
      }

      if (!reduceMotion && window.matchMedia('(hover: hover)').matches) {
        document.querySelectorAll('[data-tilt]').forEach((stage) => {
          stage.addEventListener('mousemove', (e) => {
            const r = stage.getBoundingClientRect();
            const x = (e.clientX - r.left) / r.width - .5;
            const y = (e.clientY - r.top) / r.height - .5;
            stage.style.setProperty('--ry', `${-12 + x * 14}deg`);
            stage.style.setProperty('--rx', `${6 - y * 10}deg`);
          });
          stage.addEventListener('mouseleave', () => { stage.style.removeProperty('--ry'); stage.style.removeProperty('--rx'); });
        });
      }
      const parallaxItems = [...document.querySelectorAll('[data-parallax]')];
      if (!reduceMotion && parallaxItems.length) {
        let ticking = false;
        const updateParallax = () => {
          const vh = window.innerHeight;
          parallaxItems.forEach((el) => {
            const r = el.getBoundingClientRect();
            const center = r.top + r.height / 2 - vh / 2;
            el.style.setProperty('--py', `${(center * Number(el.dataset.parallax)).toFixed(1)}px`);
          });
          ticking = false;
        };
        updateParallax();
        window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(updateParallax); } }, { passive: true });
      }

      const toast = document.querySelector('[data-toast]');
      const noToast = /^\/(order|contact)/.test(location.pathname);
      let toastSeen = false;
      try { toastSeen = sessionStorage.getItem('wgToast') === '1'; } catch (e) {}
      if (toast && !toastSeen && !noToast) {
        const showToast = () => {
          if (toastSeen) return;
          toastSeen = true;
          toast.hidden = false;
          requestAnimationFrame(() => toast.classList.add('show'));
          window.removeEventListener('scroll', onScrollToast);
        };
        const onScrollToast = () => {
          const doc = document.documentElement;
          if (window.scrollY / Math.max(doc.scrollHeight - window.innerHeight, 1) > .35) setTimeout(showToast, 600);
        };
        window.addEventListener('scroll', onScrollToast, { passive: true });
        setTimeout(showToast, 25000);
        toast.querySelector('[data-toast-close]')?.addEventListener('click', () => {
          toast.classList.remove('show');
          try { sessionStorage.setItem('wgToast', '1'); } catch (e) {}
          setTimeout(() => { toast.hidden = true; }, 500);
        });
      }
    </script>
  </body>
</html>
