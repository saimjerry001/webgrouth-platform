---
const home = Astro.url.pathname === '/';
const anchor = (id: string) => `${home ? '' : '/'}#${id}`;
const nav = [
  { href: anchor('services'), label: 'Services' },
  { href: anchor('database'), label: '40k Database' },
  { href: anchor('pricing'), label: 'Pricing' },
  { href: anchor('tools'), label: 'Free SEO Tools' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const contacts = [
  { href: 'https://wa.me/923327810261', label: 'Chat on WhatsApp', icon: 'message', external: true },
  { href: 'mailto:nasirhaiderseo@gmail.com', label: 'Email Web Grouth', icon: 'mail' },
  { href: 'tel:+923327810261', label: 'Call Web Grouth', icon: 'phone' },
];
---

<header class="site-header wg-header" data-header>
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label="Web Grouth home">
      <span class="brand-symbol" aria-hidden="true"><svg viewBox="0 0 40 40" role="img"><path d="M9 28.5 18 19l5.5 5L31 14" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/><path d="M25.5 14H31v5.5" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
      <span class="brand-word">Web<span>grouth</span></span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="header-actions">
      <div class="quick-contacts" aria-label="Quick contact options">
        {contacts.map((item) => <a href={item.href} aria-label={item.label} title={item.label} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener' : undefined}>
          {item.icon === 'message' && <svg viewBox="0 0 24 24"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 9.2 9.2 0 0 1-3.8-.9L3 20.5l1.5-5a8.3 8.3 0 1 1 16.5-4Z"/><path d="M8.5 9.2c.7 2.3 2 3.7 4.4 4.5"/></svg>}
          {item.icon === 'mail' && <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>}
          {item.icon === 'phone' && <svg viewBox="0 0 24 24"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2Z"/></svg>}
        </a>)}
      </div>
      <a class="wg-header-cta" href="/order">Get $0 Risk-Free Order <span>↗</span></a>
      <button class="menu-button" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" data-menu-button><span></span><span></span></button>
    </div>
  </div>

  <nav class="mobile-menu" id="mobile-menu" aria-label="Mobile navigation" data-mobile-menu>
    <div class="shell mobile-menu-inner">
      {nav.map((item) => <a href={item.href}>{item.label}<span>↗</span></a>)}
      <a class="mobile-order" href="/order">Get $0 Risk-Free Order <span>↗</span></a>
      <div class="mobile-contact-row">
        <a href="https://wa.me/923327810261" target="_blank" rel="noopener">WhatsApp</a>
        <a href="mailto:nasirhaiderseo@gmail.com">Email</a>
        <a href="tel:+923327810261">Call</a>
      </div>
    </div>
  </nav>
</header>

<style>
  .wg-header { background: rgba(255,255,255,.92); border-bottom: 1px solid #e2e8f0; backdrop-filter: blur(16px); }
  .wg-header.scrolled { background: rgba(255,255,255,.98); box-shadow: 0 8px 30px rgba(15,23,42,.07); }
  .wg-header .brand-symbol { color: white; background: #2563eb; box-shadow: none; }
  .wg-header .brand-word { color: #0f172a; letter-spacing: -.045em; }
  .wg-header .brand-word span { color: #2563eb; }
  .wg-header .desktop-nav { gap: 1.25rem; }
  .wg-header .desktop-nav a { color: #526078; font-size: .79rem; font-weight: 600; }
  .wg-header .desktop-nav a:hover { color: #0f172a; }
  .wg-header .desktop-nav a::after { background: #2563eb; }
  .quick-contacts { display: flex; align-items: center; gap: 4px; padding-right: 5px; }
  .quick-contacts a { width: 34px; height: 34px; display: grid; place-items: center; color: #64748b; border-radius: 9px; transition: color .2s ease, background .2s ease; }
  .quick-contacts a:hover { color: #2563eb; background: #eff6ff; }
  .quick-contacts svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .wg-header-cta { display: inline-flex; align-items: center; gap: .45rem; min-height: 42px; padding: 0 1rem; color: white; border-radius: 10px; background: #2563eb; font-size: .76rem; font-weight: 750; box-shadow: 0 8px 20px rgba(37,99,235,.18); transition: transform .2s ease, background .2s ease; }
  .wg-header-cta:hover { transform: translateY(-2px); background: #1d4ed8; }
  .wg-header .menu-button span { background: #0f172a; }
  .wg-header .mobile-menu { background: rgba(255,255,255,.99); border-bottom-color: #e2e8f0; }
  .wg-header .mobile-menu a { color: #1e293b; border-bottom-color: #e2e8f0; }
  .wg-header .mobile-menu .mobile-order { color: #1d4ed8; font-weight: 750; }
  .mobile-contact-row { display: grid; grid-template-columns: repeat(3,1fr); gap: 8px; padding: 15px 0 5px; }
  .wg-header .mobile-menu .mobile-contact-row a { min-height: 42px; display: grid; place-items: center; padding: 0; color: #334155; border: 1px solid #e2e8f0; border-radius: 9px; font-size: .72rem; }
  @media (max-width: 1220px) { .wg-header .desktop-nav { gap: .8rem; } .quick-contacts { display: none; } }
  @media (max-width: 1040px) { .wg-header .desktop-nav,.wg-header-cta { display: none; } }
</style>
