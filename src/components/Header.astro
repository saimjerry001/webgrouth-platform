---
import Logo from './Logo.astro';
const nav = [
  { href: '/guest-posting', label: 'Guest Posting' },
  { href: '/link-insertion', label: 'Link Insertion' },
  { href: '/#database', label: 'Publisher Network' },
  { href: '/seo-services', label: 'SEO Services' },
  { href: '/tools', label: 'Free Tools' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const contacts = [
  { href: 'https://wa.me/923327810261', label: 'Chat on WhatsApp', icon: 'message', external: true },
  { href: 'mailto:nasirhaiderseo@gmail.com', label: 'Email Web Grouth', icon: 'mail' },
  { href: 'tel:+923327810261', label: 'Call Web Grouth', icon: 'phone' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="wg4-header" data-header>
  <div class="wg4-bar">
    <a class="wg4-brand" href="/" aria-label="Web Grouth home">
      <Logo id="wgLogoHead" size={38} />
      <span class="wg4-word">Web<span>Grouth</span></span>
    </a>

    <nav class="wg4-nav" aria-label="Primary navigation">
      {nav.map((item) => <a href={item.href} class={path === item.href ? 'active' : undefined} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>)}
    </nav>

    <div class="wg4-actions">
      <div class="wg4-quick" aria-label="Quick contact options">
        {contacts.map((item) => <a href={item.href} aria-label={item.label} title={item.label} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener' : undefined}>
          {item.icon === 'message' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 9.2 9.2 0 0 1-3.8-.9L3 20.5l1.5-5a8.3 8.3 0 1 1 16.5-4Z"/><path d="M8.5 9.2c.7 2.3 2 3.7 4.4 4.5"/></svg>}
          {item.icon === 'mail' && <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>}
          {item.icon === 'phone' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2Z"/></svg>}
        </a>)}
      </div>
      <a class="wg4-cta wg4-shine" href="/order">Place an Order <span aria-hidden="true">↗</span></a>
      <button class="wg4-burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" data-menu-button><span></span><span></span><span></span></button>
    </div>
  </div>

  <nav class="wg4-menu" id="mobile-menu" aria-label="Mobile navigation" data-mobile-menu>
    {nav.map((item, i) => <a href={item.href} style={`--i:${i}`}>{item.label}<span aria-hidden="true">↗</span></a>)}
    <a class="wg4-menu-order" href="/order" style="--i:7">Place an Order <span aria-hidden="true">↗</span></a>
    <div class="wg4-menu-contact">
      <a href="https://wa.me/923327810261" target="_blank" rel="noopener">WhatsApp</a>
      <a href="mailto:nasirhaiderseo@gmail.com">Email</a>
      <a href="tel:+923327810261">Call</a>
    </div>
  </nav>
</header>
