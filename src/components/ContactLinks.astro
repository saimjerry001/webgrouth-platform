---
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
const channels = [
  { label: 'WhatsApp', value: '+92 332 7810261', href: 'https://wa.me/923327810261', note: 'Fastest for order questions', icon: 'M21 11.5a8.4 8.4 0 0 1-9 8.4 9.2 9.2 0 0 1-3.8-.9L3 20.5l1.5-5a8.3 8.3 0 1 1 16.5-4Z' },
  { label: 'Email', value: 'nasirhaiderseo@gmail.com', href: 'mailto:nasirhaiderseo@gmail.com', note: 'Best for detailed briefs', icon: 'M3 6h18v12H3z|M3 7l9 6 9-6' },
  { label: 'Direct call', value: '+92 332 7810261', href: 'tel:+923327810261', note: 'Tap to call from mobile', icon: 'M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2Z' },
];
---
<div class:list={['direct-channels', { compact }]}>
  {channels.map((channel) => <a href={channel.href} target={channel.label === 'WhatsApp' ? '_blank' : undefined} rel={channel.label === 'WhatsApp' ? 'noopener' : undefined}>
    <span class="channel-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">{channel.icon.split('|').map((path) => <path d={path}/>)}</svg></span>
    <span class="channel-copy"><small>{channel.label}</small><strong>{channel.value}</strong><em>{channel.note}</em></span>
    <b>↗</b>
  </a>)}
</div>
