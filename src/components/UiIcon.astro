---
interface Props {
  name: 'arrow' | 'badge' | 'database' | 'refresh' | 'clock' | 'wallet' | 'building' | 'target' | 'search' | 'check' | 'sparkles' | 'external' | 'chevron' | 'star' | 'layers' | 'chart';
  size?: number;
  strokeWidth?: number;
}
const { name, size = 20, strokeWidth = 1.8 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'arrow' && <><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></>}
  {name === 'badge' && <><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/></>}
  {name === 'database' && <><ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v6c0 1.7 3.6 3 8 3s8-1.3 8-3V5"/><path d="M4 11v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/></>}
  {name === 'refresh' && <><path d="M20 7h-5V2"/><path d="M20 7a9 9 0 1 0 2 9"/></>}
  {name === 'clock' && <><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></>}
  {name === 'wallet' && <><path d="M4 6.5h14a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-13a2 2 0 0 1 2-2h12"/><path d="M20 11h-5a2 2 0 0 0 0 4h5"/></>}
  {name === 'building' && <><path d="M3 21h18"/><path d="M6 21V7l6-4 6 4v14"/><path d="M9 9h1M14 9h1M9 13h1M14 13h1M10 21v-4h4v4"/></>}
  {name === 'target' && <><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/></>}
  {name === 'search' && <><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></>}
  {name === 'check' && <path d="m5 12 4 4L19 6"/>}
  {name === 'sparkles' && <><path d="m12 3-1.2 3.1a3 3 0 0 1-1.7 1.7L6 9l3.1 1.2a3 3 0 0 1 1.7 1.7L12 15l1.2-3.1a3 3 0 0 1 1.7-1.7L18 9l-3.1-1.2a3 3 0 0 1-1.7-1.7L12 3Z"/><path d="m5 16-.5 1.5L3 18l1.5.5L5 20l.5-1.5L7 18l-1.5-.5L5 16Z"/></>}
  {name === 'external' && <><path d="M14 4h6v6"/><path d="m10 14 10-10"/><path d="M20 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h5"/></>}
  {name === 'chevron' && <path d="m9 18 6-6-6-6"/>}
  {name === 'star' && <path d="m12 2.5 2.9 5.9 6.5.9-4.7 4.6 1.1 6.5-5.8-3-5.8 3 1.1-6.5-4.7-4.6 6.5-.9L12 2.5Z"/>}
  {name === 'layers' && <><path d="m12 2 9 5-9 5-9-5 9-5Z"/><path d="m3 12 9 5 9-5"/><path d="m3 17 9 5 9-5"/></>}
  {name === 'chart' && <><path d="M4 19V9M10 19V5M16 19v-7M22 19H2"/></>}
</svg>
